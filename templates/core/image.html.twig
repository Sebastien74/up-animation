{%- if thumbs -%}

    {%- set colSize = colSize is defined and colSize and colSize > 0 ? colSize : 12 -%}
    {%- set sizesDesktop = colSize >= 12 ? '100vw' : ((100 * colSize / 12)|round(2) ~ 'vw') -%}

    {%- set mediaQueries = {
        mobile: {
            media: '(max-width: 767px)',
            sizes: '100vw'
        },
        tablet: {
            media: '(min-width: 768px) and (max-width: 991px)',
            sizes: '100vw'
        },
        laptop: {
            media: '(min-width: 992px) and (max-width: 1599px)',
            sizes: sizesDesktop
        },
        desktop: {
            media: '(min-width: 1600px)',
            sizes: sizesDesktop
        }
    } -%}

    {%- set dataSource = thumbnails.dataSource is defined and thumbnails.dataSource ? thumbnails.dataSource : originalSrc -%}
    {%- set haveLargeAlert = false -%}
    {%- set haveLargeFile = not inAdmin and thumbnails.largeFilename is defined and thumbnails.largeFilename and '.svg' not in originalSrc -%}
    {%- set priority = priority is not empty ? priority : (lazyLoad ? 'low': 'high') -%}

    {%- if haveLargeAlert and haveLargeFile and granted('ROLE_ADMIN') -%}
        <div class="large-file-container position-absolute h-100 w-100 d-none">
            {%- set modalId = 'modal-alert-image'~uniqId() -%}
            {%- set largeArguments = {
                modalId: modalId,
                largeFilename: thumbnails.largeFilename,
                largeFileSize: thumbnails.largeFileSize,
                largeFileWidth: thumbnails.largeFileWidth,
                largeFileHeight: thumbnails.largeFileHeight,
                maxSizeLimit: thumbnails.maxSizeLimit,
                maxWidthLimit: thumbnails.maxWidthLimit,
                maxHeightLimit: thumbnails.maxHeightLimit,
                width: thumbnails.maxWidth,
                height: thumbnails.maxHeight} -%}
            {%- include 'core/alert-image.html.twig' with largeArguments -%}
        </div>
    {%- endif -%}

    {%- if haveLightBox and originalSrc -%}
        <a href="{{ originalSrc }}" class="glightbox" {% if popupGallery %} data-gallery="popup-gallery-{{ popupGallery }}" {% endif %}>
    {%- endif -%}
{#        {%- if '.svg' in originalSrc -%}#}
{#            {%- set src = thumbnails.dataSource -%}#}
{#            {%- set lazyFile = lazyFile != src ? lazyFile : 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' -%}#}
{#            <img {% if lazyLoad %}data-{% endif -%}src="{{ 'data:' in src ? src : asset(src) }}"#}
{#                 {% if lazyLoad and lazyFile is defined and lazyFile %}src="{{ 'data:' in lazyFile ? lazyFile : asset(lazyFile) }}" {% endif %}#}
{#                 {% if 'width' not in attributes and infos.width %} width="{{ infos.width }}" {% endif %}#}
{#                 {% if 'height' not in attributes and infos.height %} height="{{ infos.height }}" {% endif %}#}
{#                 {% if attributes %} {{ attributes|raw }}{% endif %}#}
{#                 {% if priority != 'high' and lazyLoad %} loading="lazy" decoding="async" {%- elseif priority != 'high' -%} loading="eager" decoding="async" {% else %} decoding="sync" loading="eager" {% endif %}#}
{#                 fetchpriority="{{ priority }}"#}
{#                {% if infos.width or infos.height %} style="{% if infos.height %} max-height: {{ infos.height }}px;{% endif %}{% if infos.width %} width: {{ infos.width }}px;{% endif %}" {% endif %}>#}
{#        {%- else -%}#}
            {%- set pictureClass = thumbnails['pictureClass'] is defined and thumbnails['pictureClass'] ? thumbnails['pictureClass'] : null -%}

            {%- set srcset = '' -%}
            {%- set seenFiles = [] -%}
            {%- set smallestFile = null -%}
            {%- set extension = null -%}
            {%- for size, file in thumbs -%}
                {%- if file and file not in seenFiles -%}
                    {%- set seenFiles = seenFiles|merge([file]) -%}
                    {%- if smallestFile is null -%}
                        {%- set smallestFile = file -%}
                    {%- endif -%}
                    {%- set srcset = srcset ~ asset(file) ~ ' ' ~ size ~ 'w, ' -%}
                    {%- set fileExt = file|split('.')|last -%}
                    {%- set fileExt = 'filter' not in fileExt ? fileExt : null -%}
                    {%- if extension is null -%}
                        {%- set extension = fileExt -%}
                    {%- elseif extension and extension != fileExt -%}
                        {%- set extension = null -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
            {%- set srcset = srcset|trim|trim(',', 'right') -%}

            <picture class="img-fluid {% if not inAdmin %}d-block{% endif %}{% if not inAdmin and lazyLoad %} loader-image-wrapper lazy-picture loading{% endif %}{% if pictureClass %} {{ pictureClass }}{% endif %}"{% if infos.shape is defined and infos.shape and infos.width and infos.height and infos.extension|default('') != 'svg' %} style="aspect-ratio: {{ infos.width }} / {{ infos.height }};"{% endif %}>
                {%- if srcset -%}
                    {%- for screen, config in mediaQueries -%}
                        <source {% if lazyLoad %}data-{% endif -%}srcset="{{ srcset }}"
                                media="{{ config.media }}"
                                sizes="{{ config.sizes }}"
                                {% if extension %}type="image/{{ extension }}"{% endif %}>
                    {%- endfor -%}
                {%- endif -%}
                {# src= sert de fallback préchargé par le navigateur (notamment pour LCP eager).
                   On pointe sur la plus petite variante du srcset pour éviter de précharger
                   la plus grande avant que la résolution srcset/sizes ait lieu. #}
                {%- set src = lazyLoad ? lazyFileSvg : (smallestFile ?: dataSource) -%}
                <img src="{{ asset(src) }}"{% if lazyLoad %} data-sizes="auto" data-src="{{ dataSource }}"{% endif %}
                    {% if 'width' not in attributes and infos.width %} width="{{ infos.width }}" {% endif %}
                    {% if 'height' not in attributes and infos.height %} height="{{ infos.height }}" {% endif %}
                    {% if attributes %} {{ attributes|raw }}{% endif %}
                    {%- if not attributes or 'alt=' not in attributes %} alt="{{ infos.intlTitle is defined and infos.intlTitle ? infos.intlTitle|striptags : '' }}"{% endif %}
                    {% if priority != 'high' and lazyLoad %} loading="lazy" decoding="async" {%- elseif priority != 'high' -%} loading="eager" decoding="async" {% else %} decoding="sync" loading="eager" {% endif %}
                     fetchpriority="{{ priority }}">
            </picture>
{#        {%- endif -%}#}

    {%- if haveLightBox and originalSrc -%}
        </a>
    {%- endif -%}

{%- endif -%}
