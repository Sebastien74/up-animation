{% extends "security/base.html.twig" %}

{% trans_default_domain 'security_cms' %}

{% block title %}{{ 'Réinitialisation du mot de passe'|trans|htmlEntities }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {{ form_start(form, {attr: {id: "password-request-form", class: "form-horizontal form-material security", novalidate: "novalidate"}}) }}
        <div class="mt-0 mb-4 fz-smaller text-white-50 d-flex">
            <i class="icon-info square-badge-info me-2"></i>
            <span class="d-inline-block lh-sm">{{ "Saisissez votre adresse e-mail pour recevoir un lien de réinitialisation de mot de passe."|trans|raw }}</span>
        </div>
        <div class="row mb-3">
            {{ form_row(form.email) }}
            {% include "security/includes/recaptcha-fields.html.twig" %}
        </div>
        <div class="form-group text-center">
            <button id="submit" name="submit" class="btn-app center w-100" type="submit"><i class="icon-paper-plane"></i>{{ 'Envoyer'|trans|raw }}</button>
            {% include "security/includes/flashbag.html.twig" %}
            <a href="{{ path("security_login", {_locale: app.request.locale}) }}" class="text-white-50 fz-small d-inline-block mt-3" data-toggle="preloader">
                {{ 'Retourner à la page de connexion'|trans|raw }}
            </a>
        </div>
    {{ form_end(form) }}
{% endblock %}
