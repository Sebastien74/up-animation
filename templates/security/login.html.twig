{% extends "security/base.html.twig" %}

{% trans_default_domain 'security_cms' %}

{% block title %}{{ "Connexion"|trans|htmlEntities }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {{ form_start(form, {attr: {
        novalidate: "novalidate",
        method: "POST",
        class: 'security',
        action: path('security_login'),
        id: "login-form",
    }}) }}
        <div class="info-request mb-4 text-center">
            <h5 class="text-white mb-2">{{ "Connectez-vous"|trans }}</h5>
        </div>
        <div class="form-data" data-id="{{ securityKey }}" data-website="{{ websiteId() }}"></div>
        {% for field in form.children %}
            {% if field.vars.name == '_remember_me' %}
                <div class="row mb-4">
                    <div class="col-sm-6 text-center text-sm-start">
            {% endif %}
                {{ form_row(form[field.vars.name]) }}
            {% if field.vars.name == '_remember_me' %}
                    </div>
                    <div class="col-sm-6 text-center text-sm-end">
                        <a href="{{ path("security_password_request", {_locale: app.request.locale}) }}" id="to-recover" class="text-white-50 fz-small" data-toggle="preloader">
                            {{ 'Mot de passe oublié&nbsp;?'|trans|raw }}
                        </a>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        {% if error %}
            {% include 'security/includes/alert.html.twig' with {alert: 'danger', message: error.messageKey|trans(error.messageData, 'security')|raw} only %}
        {% endif %}
        {% include "security/includes/flashbag.html.twig" %}
        {% if website.entity.security.adminRegistration %}
            <a href="{{ path('security_register') }}"
               class="text-uppercase btn-app center w-100 mt-3">
                <i class="icon-person-circle-plus"></i>{{ 'Inscrivez-vous'|trans|raw }}
            </a>
        {% endif %}
    {{ form_end(form) }}
{% endblock %}
