<!DOCTYPE html>

{%- trans_default_domain 'security_cms' -%}

{%- set companyName = "Up Animations!"|trans|striptags -%}
{%- set logoPath = asset('build/security/images/logo.svg', 'security') -%}

<html lang="{{ app.request.locale }}" data-nonce="{{ csp_nonce() }}">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="dns-prefetch" href="//www.gstatic.com">
        <link rel="dns-prefetch" href="//www.google.com">
        <link rel="preconnect" href="https://www.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://www.google.com" crossorigin>
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}{{ "Bienvenue !!"|trans|htmlEntities }}{% endblock %} | {{ companyName }}</title>
        <meta name="description" content="{{ companyName }}" />
        <meta name="author" content="{{ companyName }}" />
        <link rel="icon" type="image/png" href="{{ asset('build/security/images/favicon-96x96.png', 'security') }}" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('build/security/images/favicon.svg', 'security') }}" />
        <link rel="shortcut icon" href="{{ asset('build/security/images/favicon.ico', 'security') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('build/security/images/apple-touch-icon.png', 'security') }}" />
        <meta name="apple-mobile-web-app-title" content="Up!" />
        <link rel="manifest" href="{{ asset('build/security/images/site.webmanifest', 'security') }}" />
        <meta property="og:image" content="{{ asset('build/security/images/share.jpg', 'security') }}">
        <link rel="preload" href="{{ asset('build/security/security-fonts.css', 'security') }}" as="style" onload="this.onload=null;this.rel='stylesheet'" nonce="{{ csp_nonce() }}">
        <noscript><link rel="stylesheet" href="{{ asset('build/security/security-fonts.css', 'security') }}" nonce="{{ csp_nonce() }}"></noscript>
        {%- block stylesheets -%}
            {{ encore_entry_link_tags('security', null, 'security', {nonce: csp_nonce()}) }}
        {%- endblock -%}
    </head>

    <body>
        <section id="wrapper" class="login-register login-sidebar">
            <div id="bg-container" class="d-none d-lg-block">
                {{ asset('build/security/images/background-security.jpg', 'security')|file({}, {
                    id: 'background-security',
                    maxWidth: 1520,
                    maxHeight: 919,
                    priority: 'high'
                }) }}
            </div>
            <main id="main-content" class="login-box" role="main">
                <div class="inner h-100 d-flex">
                    <div id="content" class="col-12 p-3 p-sm-4 d-flex position-relative">
                        {%- include 'security/includes/preloader.html.twig' -%}
                        <div class="my-auto w-100">
                            <header>
                                <a href="{{ app.request.getSchemeAndHttpHost() }}" class="header w-100 d-inline-block text-center mb-5 mt-5 mt-md-0" aria-label="{{ companyName|striptags }}">
                                    {{ logoPath|file({}, {id: 'logo', maxHeight: 130, priority: 'high'}) }}
                                </a>
                            </header>
                            <div class="row">
                                <div class="col-sm-8 col-md-6 col-lg-12 mx-auto">
                                    {%- block body -%}{%- endblock -%}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </section>
        {%- include 'core/data-path.html.twig' only -%}
        {%- block javascripts -%}
            {%- if isIE() -%}
                {{ encore_entry_script_tags('browsers', null, 'vendor', {nonce: csp_nonce(), defer: true}) }}
            {%- endif -%}
            {{ encore_entry_script_tags('security', null, 'security', {nonce: csp_nonce(), defer: true}) }}
        {%- endblock -%}
    </body>

</html>
