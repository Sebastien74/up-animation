{% extends 'security/base.html.twig' %}

{% trans_default_domain 'security_cms' %}

{% block title %}{{ 'Réinitialisation du mot de passe'|trans|htmlEntities }}{% endblock %}

{% block body %}
    {{ form_start(form, {attr: {id: "password-confirm-form", class: "security", novalidate: "novalidate"}}) }}
        <div class="info-request mb-4 text-center">
            <h5 class="text-white mb-2">{{ "Réinitialisation<br> du mot de passe"|trans|raw }}</h5>
            <p class="text-white-50 fz-small mb-0">
                {{ "Le mot de passe doit comporter au moins 8 caractères, contenir au moins un chiffre, une majuscule et une minuscule."|trans }}
            </p>
        </div>
        <div class="row">
            {{ form_row(form.plainPassword) }}
            {{ form_errors(form) }}
            {% include "core/password-checker.html.twig" %}
            {% include "security/includes/recaptcha-fields.html.twig" %}
        </div>
        {{ form_rest(form) }}
        {% include "security/includes/flashbag.html.twig" %}
        <div class="form-group text-center m-t-20">
            <div class="col-xs-12">
                <button id="submit" name="submit" class="btn-app center w-100" type="submit"><i class="icon-floppy-disk"></i>{{ 'Enregistrer'|trans|raw }}</button>
                <a href="{{ path("security_login", {_locale: app.request.locale}) }}" class="text-white-50 fz-small d-inline-block mt-3" data-toggle="preloader">
                    {{ 'Retourner à la page de connexion'|trans|raw }}
                </a>
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}