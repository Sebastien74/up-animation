{%- trans_default_domain 'front_default' -%}

{%- set displaySitemap = false -%}
{%- set websiteTemplate = websiteTemplate is defined and websiteTemplate ? websiteTemplate : website().configuration.template -%}
{%- set frontTheme = frontTheme() -%}

{%- block stylesheets -%}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-error-'~frontTheme, null, webpack) }}
{%- endblock -%}

<div id="content-exception" class="template-page col-lg-12">
    {%- if app.request.session.get('alert_error') -%}
        <div class="flash-bag-container bg-primary pb-5">
            <div class="container">
                <div class="row row-container">
                    <div class="col-lg-8 col-xl-6 mx-auto">
                        {%- include "front/"~websiteTemplate~"/include/flashbag.html.twig" -%}
                    </div>
                </div>
            </div>
        </div>
        {{ removeSession('alert_error') }}
    {%- endif -%}
    <section id="exception-block" {% if displaySitemap %} class="mb-5" {% endif %}>
        <div id="errorStatus">
            <div class="errorStatus">
                {%- include 'bundles/TwigBundle/Exception/messages.html.twig' -%}
                {%- if website.networks is defined and website.networks is not empty -%}
                    <div class="social-container">
                        <strong class="baseline fw-900 d-inline-block mb-3">{{ "Suivez-nous sur :"|trans|unescape|raw }}</strong>
                        <nav class="socials-list d-inline-flex justify-content-center justify-content-sm-start me-3 gap-2 w-100"
                             aria-label="{{"Navigation des liens sociaux"|trans|striptags }}">
                            {%- for name, infos in website.networks -%}
                                {%- if infos.link and infos.dirname -%}
                                    {%- set label = name|striptags|capitalize~' - '~'nouvelle fenêtre'|trans|striptags -%}
                                    <a href="{{ infos.link }}" class="{{ name }} p-0 d-inline-flex"
                                       rel="noopener noreferrer" target="_blank"
                                       data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ name|capitalize|striptags }}"
                                       aria-label="{{ label|capitalize|striptags }}">
                                        <i class="icon-{{ name|lower }} position-relative initial" aria-hidden="true"></i>
                                        <span class="visually-hidden">{{ label }}</span>
                                    </a>
                                {%- endif -%}
                            {%- endfor -%}
                        </nav>
                    </div>
                {%- endif -%}
                <a href="{{ path('front_index') }}" class="btn btn-secondary d-inline-flex mt-4 back-to-home">
                    {{ "Découvrir nos prestations"|trans|raw }}
                </a>
            </div>
        </div>
    </section>
    {%- if displaySitemap -%}
        <section id="exception-sitemap" class="container">
            <div class="row">
                <div class="col-12">
                    <h2 class="title mb-0">{{ "Plan de site"|trans|raw }}</h2>
                    <div class="mt-4 mb-4 mt-lg-5 mb-lg-5">
                        {{ render_esi(path('front_sitemap_view', { website: websiteId() } )) }}
                    </div>
                </div>
            </div>
        </section>
    {%- endif -%}
</div>