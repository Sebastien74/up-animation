{%- trans_default_domain 'front_default' -%}

{%- extends 'front/'~website.configuration.template~'/base.html.twig' -%}

{%- set templateName = 'security-back' -%}

{%- block metaTitle -%}{%- endblock -%}
{%- block metaDescription -%}{%- endblock -%}
{%- block metaRobots -%}{%- endblock -%}

{%- block stylesheets -%}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-'~templateName~'-'~frontTheme, null, webpack) }}
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
    {{ encore_entry_script_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {defer: true}) }}
{%- endblock -%}

{%- block body -%}

    <div id="content-{{ templateName }}" class="template-page">

        {%- include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
            forceBreadcrumb: true,
            website: website,
            websiteTemplate: websiteTemplate,
            logos: logos,
            breadcrumbOptions: {pages: breadcrumbs is defined ? breadcrumbs : []},
            pageTitle: pageTitle,
            subTitle: subTitle is defined ? subTitle : false,
            disableImage: true,
            thumbConfiguration: thumbConfigurationHeader
        } only -%}

        <div class="container">
            <div class="btns-wrap d-flex justify-content-lg-end py-3">
                {%- set siteLabel = "Accéder au site"|trans|striptags -%}
                <a href="{{ path('front_index') }}"
                   class="btn btn-circle btn-success"
                   aria-label="{{ siteLabel }}"
                   data-bs-toggle="tooltip"
                   title="{{ siteLabel }}">
                    <i class="icon-desktop-alt" aria-hidden="true"></i>
                </a>
                {%- if 'security_front_profile' == masterRequest().attributes.get('_route') -%}
                    {%- set editLabel = "Éditer mon profil"|trans|striptags -%}
                    <a href="{{ path('security_front_profile_edit') }}"
                       class="btn btn-circle btn-success"
                       aria-label="{{ editLabel }}"
                       data-bs-toggle="tooltip"
                       title="{{ editLabel }}">
                        <i class="icon-user-edit" aria-hidden="true"></i>
                    </a>
                {%- endif -%}
                {%- if 'security_front_profile' != masterRequest().attributes.get('_route') -%}
                    {%- set viewLabel = "Voir mon profil"|trans|striptags -%}
                    <a href="{{ path('security_front_profile') }}"
                       class="btn btn-circle btn-primary"
                       aria-label="{{ viewLabel }}"
                       data-bs-toggle="tooltip"
                       title="{{ viewLabel }}">
                        <i class="icon-user" aria-hidden="true"></i>
                    </a>
                {%- endif -%}
                {%- set logoutLabel = "Déconnexion"|trans|striptags -%}
                <a href="{{ path('app_logout') }}"
                   class="btn btn-circle btn-primary"
                   aria-label="{{ logoutLabel }}"
                   data-bs-toggle="tooltip"
                   title="{{ logoutLabel }}">
                    <i class="icon-power-off" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        {%- include "front/"~websiteTemplate~"/include/flashbag.html.twig" -%}

        <div class="layout-zone bg-lighten">
            {%- block content -%}{%- endblock -%}
        </div>

    </div>

{%- endblock -%}