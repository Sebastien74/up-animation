{%- trans_default_domain 'front_default' -%}

{%- set displayName = '' -%}
{%- if user.firstName or user.lastName -%}
    {%- set displayName = (user.firstName ? user.firstName : '') ~ (user.lastName ? ' ' ~ user.lastName : '') -%}
{%- else -%}
    {%- set displayName = user.login -%}
{%- endif -%}
{%- set displayName = displayName|trim -%}

{%- set favCount = favorites_count() -%}
{%- set hasPending = user.userRequest.id is defined or user.tokenRemoveRequest -%}
{%- set actionCols = favCount > 0 ? 'col-md-6 col-lg-4' : 'col-md-6' -%}

<div id="user-front-dashboard">

    <section class="profile-hero profile-hero-compact bg-white">
        <div class="row m-0 g-0 align-items-stretch">
            <div class="col-lg-8 profile-hero-text">
                <span class="profile-eyebrow">{{ "Tableau de bord"|trans|raw }}</span>
                <h2 class="profile-greeting">
                    <span class="profile-greeting-hi">{{ "Bonjour,"|trans|raw }}</span>
                    <span class="profile-greeting-name">{{ displayName }}</span>
                </h2>
                <p class="dashboard-tagline">
                    {{ "Bienvenue dans votre espace personnel. Retrouvez ici vos informations, vos demandes en cours et vos favoris."|trans|raw }}
                </p>
            </div>
            <div class="col-lg-4 profile-hero-avatar profile-hero-avatar-sm bg-secondary">
                <div class="avatar-frame avatar-frame-sm">
                    <div class="avatar-ring"></div>
                    <div class="avatar-media bg-secondary-light">
                        {{ asset(user|profile_img)|file({}, {maxHeight: 140}) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {%- if hasPending -%}
        <section class="dashboard-alert bg-white">
            <div class="dashboard-alert-head">
                <i class="icon-shield-alt"></i>
                {{ "Action requise"|trans|raw }}
            </div>
            {%- if user.userRequest.id is defined -%}
                <h3 class="dashboard-alert-title">
                    {{ "Vous avez une demande de modification de vos données personnelles en attente de confirmation."|trans|raw }}
                </h3>
                <div class="dashboard-alert-body">
                    <p>{{ "Validez votre demande depuis votre profil pour finaliser la mise à jour."|trans|raw }}</p>
                </div>
                <a href="{{ path('security_front_profile_edit') }}" class="btn btn-primary">
                    {{ "Accéder à mon profil"|trans|raw }}
                </a>
            {%- elseif user.tokenRemoveRequest -%}
                <h3 class="dashboard-alert-title">
                    {{ "Vous avez une demande de suppression de votre compte en cours."|trans|raw }}
                </h3>
                <div class="dashboard-alert-body">
                    <p>{{ "Un email de confirmation vous a été envoyé. Pour des raisons de sécurité, la suppression ne sera effective qu'après validation depuis ce message."|trans|raw }}</p>
                    <p>{{ "Si vous n'avez pas reçu le mail, pensez à vérifier votre dossier «Spam» ou «Courrier indésirable»."|trans|raw }}</p>
                    <p>
                        {{ "Vous pouvez <a href='%resetLink%'>annuler la demande de suppression</a> si vous ne souhaitez plus la valider ou si vous n'êtes pas à l'origine de cette demande."|trans({
                            '%resetLink%': path('security_front_clear_user_remove_request', {token: user.tokenRemoveRequest|url_encode})
                        })|raw }}
                    </p>
                </div>
            {%- endif -%}
        </section>
    {%- endif -%}

    <section class="profile-section">
        <header class="profile-section-head">
            <span class="section-index">01</span>
            <h3 class="profile-section-title">{{ "Accès rapides"|trans|raw }}</h3>
        </header>
        <div class="row g-4">
            <div class="{{ actionCols }}">
                <a href="{{ path('security_front_profile') }}" class="action-tile bg-white">
                    <span class="action-tile-label">{{ "Compte"|trans|raw }}</span>
                    <span class="action-tile-title">{{ "Mon profil"|trans|raw }}</span>
                    <span class="action-tile-cta">
                        {{ "Consulter"|trans|raw }}
                        <i class="icon-chevron-right"></i>
                    </span>
                </a>
            </div>
            <div class="{{ actionCols }}">
                <a href="{{ path('security_front_profile_edit') }}" class="action-tile bg-white">
                    <span class="action-tile-label">{{ "Données"|trans|raw }}</span>
                    <span class="action-tile-title">{{ "Éditer mes informations"|trans|raw }}</span>
                    <span class="action-tile-cta">
                        {{ "Modifier"|trans|raw }}
                        <i class="icon-chevron-right"></i>
                    </span>
                </a>
            </div>
            {%- if favCount > 0 -%}
                <div class="{{ actionCols }}">
                    <a href="{{ path('front_favorites_index') }}" class="action-tile is-accent bg-secondary text-white">
                        <span class="action-tile-label">
                            {{ "Favoris"|trans|raw }}
                            <span class="action-tile-count">{{ favCount }}</span>
                        </span>
                        <span class="action-tile-title">{{ "Mes produits favoris"|trans|raw }}</span>
                        <span class="action-tile-cta">
                            {{ "Voir la liste"|trans|raw }}
                            <i class="icon-chevron-right"></i>
                        </span>
                    </a>
                </div>
            {%- endif -%}
        </div>
    </section>

</div>
