{%- extends 'front/'~website.configuration.template~'/base.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- block metaTitle -%}{{ "Confirmation d'email"|trans|htmlEntities }}{%- endblock -%}
{%- block metaRobots -%}noindex{%- endblock -%}

{%- block stylesheets -%}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {nonce: csp_nonce()}) }}
    <link rel="modulepreload" href="{{ preload(asset('build/front/'~websiteTemplate~'/front-'~websiteTemplate~'-'~templateName~'.js', webpack), {as: 'script', importance: 'low'}) }}" as="script" fetchpriority="low" nonce="{{ csp_nonce() }}">
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
    {{ encore_entry_script_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {defer: true, nonce: csp_nonce()}) }}
{%- endblock -%}

{%- block body -%}
    <div id="content-security-front" class="template-page">
        <div class="layout-zone">
            <div class="container py-lg">
                <div class="row d-flex justify-content-center">
                    <div class="col-lg-4">
                        <div class="bg-light card form-container login-card shadow-md border-0 h-100">
                            <div class="card-body form-ajax-container p-4 p-md-5 text-center">
                                <div class="login-head mb-4 pb-2 text-start">
                                    <p class="login-eyebrow text-uppercase mb-2">{{ "Inscription"|trans|raw }}</p>
                                    <h3 class="login-title text-uppercase fw-800 mb-0">{{ "Merci !"|trans|raw }}</h3>
                                </div>
                                <i class="icon-thumbs-up text-primary size-xl-icon mb-4 d-inline-block"></i>
                                <p class="mb-2">{{ "Un e-mail de confirmation vient de vous être envoyé."|trans|raw }}</p>
                                <p class="mb-2">{{ "Merci de vérifier votre boîte de réception et de cliquer sur le lien pour finaliser votre inscription."|trans|raw }}</p>
                                <p class="mb-4">{{ "Si vous ne recevez pas cet e-mail d’ici quelques minutes, pensez à vérifier votre dossier de courriers indésirables ou spams."|trans|raw }}</p>
                                <a href="{{ path('front_index') }}" class="btn btn-primary text-uppercase w-100">
                                    {{ "Retourner à la page d'accueil"|trans|raw }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{%- endblock -%}
