{%- extends 'front/'~website.configuration.template~'/base.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- block metaTitle -%}{{ "Vérification en deux étapes"|trans({}, 'security')|htmlEntities }}{%- endblock -%}
{%- block metaRobots -%}noindex{%- endblock -%}

{%- set displayHeader = false -%}

{%- block stylesheets -%}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-'~templateName~'-'~frontTheme, null, webpack, {nonce: csp_nonce()}) }}
    <link rel="modulepreload" href="{{ preload(asset('build/front/'~websiteTemplate~'/front-'~websiteTemplate~'-'~templateName~'.js', webpack), {as: 'script', importance: 'low'}) }}" as="script" fetchpriority="low" nonce="{{ csp_nonce() }}">
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
    {{ encore_entry_script_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {defer: true, nonce: csp_nonce()}) }}
{%- endblock -%}

{%- block body -%}
    <div id="content-security-front" class="template-page">
    {%- if displayHeader -%}
        {%- include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
            pageTitle: "Vérification en deux étapes"|trans({}, 'security')|raw,
            thumbConfiguration: thumbConfigurationHeader
        } -%}
    {%- endif -%}
    <div class="layout-zone">
    <div class="container py-lg">
        <div class="row d-flex justify-content-center">
            <div class="col-lg-4">
                <div class="bg-light card form-container login-card shadow-md border-0 h-100">
                    <div class="card-body form-ajax-container p-4 p-md-5">
                        {%- include 'front/'~websiteTemplate~'/include/loader.html.twig' with {className: 'strict-size small-radius'} only -%}
                        <div class="login-head mb-4 pb-2">
                            <p class="login-eyebrow text-uppercase mb-2">{{ "Sécurité du compte"|trans({}, 'security')|raw }}</p>
                            <h3 class="login-title text-uppercase fw-800 mb-0">{{ "Vérification en deux étapes"|trans({}, 'security')|raw }}</h3>
                        </div>
                        <form id="form-2fa" method="post" action="{{ path('2fa_front_login_check') }}" class="security" novalidate>
                            <div class="row">
                                <div class="col-12 col-lg-12">
                                    <p class="mb-4">
                                        {{ "Un code de vérification vient d'être envoyé à votre adresse email."|trans({}, 'security')|raw }}
                                    </p>
                                </div>
                                <div class="col-12">
                                    {%- if authenticationError -%}
                                        {%- include 'front/'~websiteTemplate~'/include/alert.html.twig' with {
                                            alert: 'danger',
                                            message: authenticationError|trans(authenticationErrorData, 'security'),
                                            alertClass: 'w-100'
                                        } only -%}
                                    {%- endif -%}
                                </div>
                                <div class="col-12 col-lg-12 mb-3 form-group-text floating-form-text">
                                    <div class="position-relative form-floating">
                                        <input type="text" id="_auth_code" name="_auth_code"
                                               class="form-control"
                                               placeholder="000000"
                                               autocomplete="one-time-code"
                                               inputmode="numeric"
                                               pattern="[0-9]*"
                                               maxlength="6"
                                               autofocus required>
                                        <label for="_auth_code" class="form-label required">{{ "Code reçu par email"|trans({}, 'security') }}</label>
                                    </div>
                                </div>
                                {%- if isCsrfProtectionEnabled -%}
                                    <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                                {%- endif -%}
                                <div class="col-12 col-lg-12">
                                    <button type="submit" class="col-12 btn btn-primary btn-block text-uppercase w-100 mt-3 d-flex justify-content-center">
                                        {{ "Valider"|trans({}, 'security')|raw }}
                                    </button>
                                </div>
                                <div class="col-12 text-center mt-3">
                                    <a href="{{ path('app_logout') }}" class="text-dark">
                                        <small class="text-italic">{{ "Annuler et se déconnecter"|trans({}, 'security')|raw }}</small>
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>
{%- endblock -%}
