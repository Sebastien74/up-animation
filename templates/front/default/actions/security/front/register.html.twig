{%- extends 'front/'~website.configuration.template~'/base.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- block metaTitle -%}{{ "Inscrivez-vous"|trans|htmlEntities }}{%- endblock -%}
{%- block metaDescription -%}{{ "Inscrivez-vous"|trans|raw }}{%- endblock -%}

{%- set displayHeader = false -%}

{%- block stylesheets -%}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {nonce: csp_nonce()}) }}
    <link rel="modulepreload" href="{{ preload(asset('build/front/'~websiteTemplate~'/front-'~websiteTemplate~'-'~templateName~'.js', webpack), {as: 'script', importance: 'low'}) }}" as="script" fetchpriority="low" nonce="{{ csp_nonce() }}">
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
    {{ encore_entry_script_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {defer: true, nonce: csp_nonce()}) }}
{%- endblock -%}

{%- block body -%}
    <div id="content-security-front" class="template-page">
        {%- if displayHeader -%}
            {%- include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
                pageTitle: "Inscrivez-vous"|trans,
                thumbConfiguration: thumbConfigurationHeader
            } -%}
        {%- endif -%}
        <div class="layout-zone">
        <div class="container-fluid py-lg form-security-container">
        <div class="row d-flex">
            <div class="col-md-4 mx-auto recaptcha-referer">
                {%- if app.user -%}
                    {%- include 'front/'~websiteTemplate~'/include/alert.html.twig' with {alert: 'info', message: "Vous êtes déjà connecté."|trans} only -%}
                {%- else -%}
                    {{ form_start(form, {attr: {id: "user-registration-form", novalidate: "novalidate", class: "security"}}) }}
                        <div class="row">
                            {%- for field in form.children -%}
                                {{ form_row(form[field.vars.name]) }}
                                {%- if field.vars.name == 'plainPassword' -%}
                                    <div class="form-group col-12">
                                        <div class="form-text text-muted mb-0">
                                            {{ "Le mot de passe doit comporter au moins 8 caractères, contenir au moins un chiffre, une majuscule et une minuscule."|trans|raw }}
                                        </div>
                                    </div>
                                {%- endif -%}
                            {%- endfor -%}
                            {%- include "security/includes/recaptcha-fields.html.twig" -%}
                        </div>
                        {%- include "front/"~websiteTemplate~"/include/flashbag.html.twig" -%}
                        <button id="submit" name="submit" type="submit" class="btn btn-primary btn-block text-uppercase">{{ "S'inscrire"|trans|raw }}</button>
                    {{ form_end(form) }}
                {%- endif -%}
            </div>
        </div>
        </div>
        </div>
    </div>
{%- endblock -%}