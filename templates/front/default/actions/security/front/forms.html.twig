{%- extends 'front/'~website.configuration.template~'/base.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- block metaTitle -%}{{ "Connectez-vous"|trans|htmlEntities }}{%- endblock -%}
{%- block metaRobots -%}{{ "noindex" }}{%- endblock -%}

{%- set displayHeader = false -%}

{%- block stylesheets -%}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {nonce: csp_nonce()}) }}
    <link rel="modulepreload" href="{{ preload(asset('build/front/'~websiteTemplate~'/front-'~websiteTemplate~'-'~templateName~'.js', webpack), {as: 'script', importance: 'low'}) }}" as="script" fetchpriority="low" nonce="{{ csp_nonce() }}">
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
    {{ encore_entry_script_tags('front-'~websiteTemplate~'-'~templateName, null, webpack, {defer: true, nonce: csp_nonce()}) }}
{%- endblock -%}

{%- block body -%}
    <div id="content-security-front" class="template-page">
        {%- if displayHeader -%}
            {%- include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
                pageTitle: "Connectez-vous"|trans,
                thumbConfiguration: thumbConfigurationHeader
            } -%}
        {%- endif -%}
        {%- set frontRegistration = website.security.frontRegistration -%}
        {%- set hasAdminSwitch = adminBackUser is defined and adminBackUser -%}
        <div class="layout-zone">
            <div class="container">
                <div class="row d-flex">
                    {%- if hasAdminSwitch -%}
                        <div class="col-lg-6 mb-4 mb-lg-0 py-5">
                            {%- include 'front/'~websiteTemplate~'/actions/security/front/admin-switcher.html.twig' with {
                                websiteTemplate: websiteTemplate,
                                backUser: adminBackUser,
                                userFronts: adminUserFronts
                            } only -%}
                        </div>
                        <div class="col-lg-6 py-5">
                            {{ render_esi(path('security_front_login', {view: 'form'})) }}
                        </div>
                    {%- else -%}
                        <div class="py-5 {% if frontRegistration %}col-lg-5{% else %}col-lg-6 col-xl-5 col-xxl-4{% endif %}{% if not frontRegistration %} mx-auto{% endif %}">
                            {{ render_esi(path('security_front_login', {view: 'form'})) }}
                        </div>
                        {%- if frontRegistration -%}
                            <div class="py-5 col-lg-7 mt-5 mt-lg-0">
                                {{ render_esi(path('security_front_register', {view: 'form'})) }}
                            </div>
                        {%- endif -%}
                    {%- endif -%}
                </div>
            </div>
        </div>
    </div>
{%- endblock -%}