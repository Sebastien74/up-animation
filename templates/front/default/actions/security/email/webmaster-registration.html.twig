{%- extends 'core/email/base-security.html.twig' -%}

{%- trans_default_domain 'email' -%}

{%- block metaTitle -%}
    {%- if user is defined -%}
        {{ ("Nouvel inscrit")|trans }}{% if user.username is defined %} - {{ user.username }}{% endif %}
    {%- else -%}
        {{ ("Nouvel inscrit")|trans }}
    {%- endif -%}
{%- endblock -%}

{%- block preheader -%}{{ ("Un nouveau compte vient d'être créé.")|trans|raw }}{%- endblock -%}

{%- block headerRight -%}{{ ("Inscription")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Compte / Inscription")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Nouvel inscrit.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    {%- set profile = user.profile is defined ? user.profile : null -%}
    <p style="margin:0 0 18px 0;">{{ ("Un nouveau compte vient d'être créé sur votre site. Voici les informations transmises.")|trans|raw }}</p>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-top:1px solid #E4DCCC;">
        {%- if profile.gender is defined and profile.gender -%}
            <tr>
                <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ ("Civilité")|trans|raw }}</div>
                    <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; font-weight:500; color:#22254E;">{% if profile.gender == 'mr' %}{{ ("Monsieur")|trans|raw }}{% elseif profile.gender == 'ms' %}{{ ("Madame")|trans|raw }}{% endif %}</div>
                </td>
            </tr>
        {%- endif -%}
        {%- if user.lastName is defined and user.lastName -%}
            <tr>
                <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ ("Nom")|trans|raw }}</div>
                    <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; font-weight:500; color:#22254E;">{{ user.lastName }}</div>
                </td>
            </tr>
        {%- endif -%}
        {%- if user.firstName is defined and user.firstName -%}
            <tr>
                <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ ("Prénom")|trans|raw }}</div>
                    <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; font-weight:500; color:#22254E;">{{ user.firstName }}</div>
                </td>
            </tr>
        {%- endif -%}
        {%- if user.email is defined and user.email -%}
            <tr>
                <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ ("Email")|trans|raw }}</div>
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:15px; font-weight:500; color:#22254E; word-break:break-all;"><a href="mailto:{{ user.email }}" style="color:#22254E; text-decoration:none;">{{ user.email }}</a></div>
                </td>
            </tr>
        {%- endif -%}
        {%- set phone = profile.phones[0] is defined ? profile.phones[0] : null -%}
        {%- if phone.number is defined and phone.number -%}
            <tr>
                <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ ("Téléphone")|trans|raw }}</div>
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:15px; font-weight:500; color:#22254E;">{{ phone.number }}</div>
                </td>
            </tr>
        {%- endif -%}
        {%- set address = profile.addresses[0] is defined ? profile.addresses[0] : null -%}
        {%- if address.address is defined and address.address -%}
            <tr>
                <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ ("Adresse")|trans|raw }}</div>
                    <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; font-weight:500; color:#22254E; line-height:1.5;">
                        {{ address.address }}
                        {%- if address.zipCode is defined and address.zipCode %}<br>{{ address.zipCode }}{% endif -%}
                        {%- if address.city is defined and address.city %} {{ address.city }}{% endif -%}
                        {%- if address.country is defined and address.country %}<br>{{ address.country|countryName(app.request.locale) }}{% endif -%}
                    </div>
                </td>
            </tr>
        {%- endif -%}
    </table>
{%- endblock -%}

{%- block info -%}
    {{ ("Aucune action urgente n'est requise. Cette notification confirme la création du compte.")|trans|raw }}
{%- endblock -%}
