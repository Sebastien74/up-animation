{%- extends 'core/email/base-security.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- block metaTitle -%}{{ ("Votre code de vérification")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Code unique pour finaliser votre connexion.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Sécurité")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Sécurité / Authentification à deux facteurs")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Votre code de vérification.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    <p style="margin:0 0 24px 0;">{{ ("Voici le code à usage unique à saisir pour finaliser votre connexion. Il expire après un court délai.")|trans|raw }}</p>

    {# Code stamp : large mono, framed #}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td align="center" style="padding:8px 0;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td bgcolor="#22254E" style="background-color:#22254E; padding:24px 36px; mso-padding-alt:24px 36px; border-top:3px solid #0081AC; border-bottom:3px solid #0081AC;">
                            <div class="otp" style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:38px; font-weight:600; letter-spacing:0.32em; color:#FFFFFF; line-height:1;">
                                {{ code }}
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
{%- endblock -%}

{%- block info -%}
    {{ ("Si vous n'êtes pas à l'origine de cette connexion, ignorez simplement cet email et envisagez de changer votre mot de passe.")|trans|raw }}
{%- endblock -%}
