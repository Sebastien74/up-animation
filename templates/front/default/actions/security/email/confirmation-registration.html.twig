{%- extends 'core/email/base-security.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- set confirmLink = token is defined ? absolute_url(path('security_front_confirmation', {token: token|url_encode, _locale: app.request.locale})) : '%confirmLink%' -%}

{%- block metaTitle -%}{{ ("Finalisez votre inscription")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Bienvenue. Confirmez votre adresse pour activer votre compte.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Inscription")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Compte / Activation")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Bienvenue.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    <p style="margin:0 0 14px 0;">{{ ("Vous avez demande a creer un compte sur notre site. Une derniere etape : confirmez votre adresse email en cliquant sur le bouton ci-dessous.")|trans|raw }}</p>
{%- endblock -%}

{%- block cta -%}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center" bgcolor="#0081AC" style="background-color:#0081AC; padding:18px 32px; mso-padding-alt:18px 32px;">
                <a href="{{ confirmLink }}" target="_blank" style="display:inline-block; color:#FFFFFF; font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:13px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; line-height:1;">
                    {{ ("Activer mon compte")|trans|raw }}&nbsp;&nbsp;&rarr;
                </a>
            </td>
        </tr>
    </table>
{%- endblock -%}

{%- block info -%}
    {{ ("Ce lien est valable pendant 24 heures. Passe ce delai, vous devrez effectuer une nouvelle demande d inscription. Si vous n etes pas a l origine de cette inscription, ignorez simplement cet email.")|trans|raw }}
{%- endblock -%}
