{%- extends 'core/email/base-security.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- set website = website is defined ? website : (website() ?? null) -%}
{%- set locale = user.locale is defined and user.locale ? user.locale
    : (website ? website.configuration.locale : (app.request.locale is defined ? app.request.locale : 'fr')) -%}

{%- block metaTitle -%}
    {%- if expire is defined and expire -%}
        {{ ("Votre mot de passe a expire.")|trans({}, 'security_email', locale)|striptags }}
    {%- else -%}
        {{ ("Votre mot de passe arrive a expiration.")|trans({}, 'security_email', locale)|striptags }}
    {%- endif -%}
{%- endblock -%}

{%- block preheader -%}
    {%- if expire is defined and expire -%}
        {{ ("Securite : pensez a renouveler votre mot de passe.")|trans({}, 'security_email', locale)|raw }}
    {%- else -%}
        {{ ("Anticipez l expiration de votre mot de passe.")|trans({}, 'security_email', locale)|raw }}
    {%- endif -%}
{%- endblock -%}

{%- block headerRight -%}{{ ("Securite")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Securite / Compte")|trans|raw }}{%- endblock -%}

{%- block title -%}
    {%- if expire is defined and expire -%}
        {{ ("Mot de passe expiré.")|trans({}, 'security_email', locale)|raw }}
    {%- else -%}
        {{ ("Bientot a renouveler.")|trans({}, 'security_email', locale)|raw }}
    {%- endif -%}
{%- endblock -%}

{%- block body -%}
    {%- if expire is defined and expire -%}
        <p style="margin:0 0 14px 0;">{{ ("Votre mot de passe a expiré. Pour des raisons de securite, vous devez en choisir un nouveau lors de votre prochaine connexion.")|trans({}, 'security_email', locale)|raw }}</p>
    {%- else -%}
        <p style="margin:0 0 14px 0;">{{ ("Votre mot de passe arrive bientot a expiration. Pour eviter toute interruption d acces, nous vous recommandons d en choisir un nouveau des maintenant.")|trans({}, 'security_email', locale)|raw }}</p>
    {%- endif -%}
{%- endblock -%}

{%- block info -%}
    {{ ("Cet email est envoye automatiquement par notre systeme de securite. Aucun changement n a ete effectue sur votre compte sans votre action.")|trans({}, 'security_email', locale)|raw }}
{%- endblock -%}
