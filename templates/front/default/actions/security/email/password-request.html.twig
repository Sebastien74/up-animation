{%- extends 'core/email/base-security.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- set resetLink = token is defined ? app.request.getSchemeAndHttpHost()~path('security_front_password_confirm', {token: token|url_encode, _locale: app.request.locale}) : '%resetLink%' -%}

{%- block metaTitle -%}{{ ("Reinitialisation de votre mot de passe")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Suivez le lien pour choisir un nouveau mot de passe.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Securite")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Securite / Mot de passe")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Nouveau mot de passe.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    <p style="margin:0 0 14px 0;">{{ ("Vous avez demande a reinitialiser votre mot de passe. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.")|trans|raw }}</p>
{%- endblock -%}

{%- block cta -%}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center" bgcolor="#0081AC" style="background-color:#0081AC; padding:18px 32px; mso-padding-alt:18px 32px;">
                <a href="{{ resetLink }}" target="_blank" style="display:inline-block; color:#FFFFFF; font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:13px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; line-height:1;">
                    {{ ("Reinitialiser mon mot de passe")|trans|raw }}&nbsp;&nbsp;&rarr;
                </a>
            </td>
        </tr>
    </table>
{%- endblock -%}

{%- block info -%}
    {{ ("Ce lien est valable pendant 24 heures. Si vous n etes pas a l origine de cette demande, ignorez simplement cet email : aucun changement ne sera effectue sans votre action.")|trans|raw }}
{%- endblock -%}
