{%- trans_default_domain 'front_default' -%}

{%- if entity.intl.title -%}
    {%- set pageTitle = entity.intl.title is defined ? entity.intl.title : (pageTitle is defined ? pageTitle : null) -%}
    {#- Localisation du H1 pour les fiches produit catalog (hors agences) : %location% substitué au rendu. -#}
    {%- if pageTitle and entity.asAgency is defined and not entity.asAgency -%}
        {%- set pageTitle = pageTitle~' %location%' -%}
    {%- endif -%}
    {%- include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
        block: entity,
        customMedia: entity.mainMediaInHeader ? entity.headerMedia : null,
        fullSize: true,
        page: page,
        pageTitle: pageTitle,
        intl: entity.intl,
        body: entity.intl.introduction,
        titleForce: 1,
        template: websiteTemplate,
        interfaceName: interfaceName,
        thumbConfiguration: thumbConfigurationHeader
    } -%}
{%- endif -%}