{%- trans_default_domain 'front_default' -%}

{%- import 'front/'~websiteTemplate~'/include/macros/card.html.twig' as macroCard -%}

{%- set entity = result.entity -%}
{%- set interfaceName = result.interfaceName -%}
{%- set title = result.snippets.title is defined ? result.snippets.title : (entity.intl.title is defined ? entity.intl.title : false) -%}
{%- set body = result.snippets.body is defined ? result.snippets.body : (result.snippets.introduction is defined ? entity.intl.introduction : false) -%}
{%- set asProduct = 'catalogproduct' == categoryName -%}
{%- set asNews = 'newscast' == categoryName -%}
{%- set catalogSlug = entity.catalog.slug is defined ? entity.catalog.slug : null -%}
{%- set asAgency = entity.asAgency is defined and entity.asAgency -%}
{%- set asProduct = catalogSlug is not empty -%}
{%- set asFile = entity.originalName is defined and entity.originalName -%}

<div class="col-md-3 result item my-3">
    {%- if asProduct -%}
        {{ macroCard.product({
            entity: entity,
            screensSizes: {
                mobile: {width: 306, height: 198},
                tablet: {width: 306, height: 198},
                laptop: {width: 306, height: 198},
                desktop: {width: 306, height: 198}
            },
        }) }}
    {%- elseif asAgency -%}
        {{ macroCard.agency({
            entity: entity,
            screensSizes: {
                mobile: {width: 306, height: 198},
                tablet: {width: 306, height: 198},
                laptop: {width: 306, height: 198},
                desktop: {width: 306, height: 198}
            },
        }) }}
    {%- elseif asNews -%}
        {{ macroCard.news({
            entity: entity,
            screensSizes: {
                mobile: {width: 306, height: 198},
                tablet: {width: 306, height: 198},
                laptop: {width: 306, height: 198},
                desktop: {width: 306, height: 198}
            },
        }) }}
    {%- else -%}
        <div class="card-block card h-100 bg-white p-4 border-0 have-link shadow have-bg{% if asFile %} as-file{% endif %}">
            <div class="card-body border-0 no-media bg-white px-0 pt-0 {% if asFile %}pb-0{% endif %}">
                <div class="text-block">
                    {%- if asFile -%}
                        {%- set filename = result.snippets is defined and result.snippets ? result.snippets : entity.originalName -%}
                        <a href="{{ asset(result.url) }}" class="d-flex align-items-center gap-2" target="_blank" download="{{ entity.originalName }}">
                            <span class="d-flex align-items-center justify-content-center bg-secondary">
                                {{ 'front'|fileIcon(entity.extension, 'text-white')|raw }}
                            </span>
                            {{ filename|raw }}
                        </a>
                    {%- else -%}
                        {%- if title -%}
                            <h3 class="title mb-2">{{ title|raw }}</h3>
                        {%- endif -%}
                        {%- if body -%}
                            <small class="body d-inline-block w-100 text-italic fw-300">{{ body|raw }}</small>
                        {%- endif -%}
                        {%- if result.snippets.relations is defined -%}
                            {%- for relation in result.snippets.relations -%}
                                <small class="body d-inline-block w-100 text-italic fw-300{% if not loop.last %} mb-1{% endif %}">{{ relation|raw }}</small>
                            {%- endfor -%}
                        {%- endif -%}
                    {%- endif -%}
                </div>
            </div>
            {%- if not asFile -%}
                <div class="card-footer border-0 d-flex justify-content-end mt-auto">
                    <a href="{{ asset(result.url) }}" class="text-uppercase text-underline text-secondary fw-800 small d-inline-flex align-items-center">
                        <span class="text-hover-primary">{{ "En savoir +"|trans|raw }}</span>
                    </a>
                </div>
            {%- endif -%}
        </div>
    {%- endif -%}
</div>