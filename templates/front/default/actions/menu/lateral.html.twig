{%- trans_default_domain 'front_default' -%}

{%- import _self as macro -%}

{%- set displayHomePage = false -%}
{%- set isHome = (seo.entity.asIndex is defined and seo.entity.asIndex) or (app.request.requestUri == '/') or (not app.request.requestUri) -%}
{%- set logo = logos.logo is defined and logos.logo ? logos.logo : null -%}
{%- set networks = logos['social-networks'] is defined and logos['social-networks'] ? logos['social-networks'] : null -%}
{%- set haveEmails = information.zones.emails.header is defined and information.zones.emails.header is not empty -%}
{%- set havePhones = information.zones.phones.header is defined and information.zones.phones.header is not empty -%}
{%- set phone = information.phone is defined and information.phone ? information.phone : false -%}
{%- set companyName = information.companyName is defined and information.companyName ? information.companyName : "Up Animations!"|trans|raw -%}
{%- set schedule = information.schedule is defined and information.schedule ? information.schedule : false -%}
{%- set haveLogin = 'secure-page'|moduleActive(configuration) -%}
{%- set links = tree.main is defined ? tree.main : [] -%}
{%- set compagnyNameElement = (seo.titleH1 is defined and not seo.titleH1 or seo.titleH1 is not defined) ? 'h1' : 'strong' -%}
{%- if seo.card is defined and seo.card -%}
    {%- set compagnyNameElement = 'strong' -%}
{%- endif -%}
{%- set contactPageUrl = mainPages.contact.code is defined ? mainPages.contact.code : null -%}
{%- set newsPageUrl = mainPages.newscasts.code is defined ? mainPages.newscasts.code : null -%}
{%- set aboutPageUrl = mainPages.about.code is defined ? mainPages.about.code : null -%}
{%- set notExpanded = false -%}
{%- set displayThemeBtn = false -%}

{%- macro element(link, tree, companyName, logo, microDataActive, expand, dropdownHover, dropdownItem, isLast, websiteTemplate, notExpanded, haveIcons = false, isHeader = false) -%}
    {%- set dropdownBack = false -%}
    {%- if link.online is defined and link.online -%}
        {%- set path = link.link -%}
        {%- set element = link.link ? 'a' : 'div' -%}
        {%- if not link.link and link.children -%}
            {%- set element = 'a' -%}
            {%- set child = link.children|first -%}
            {%- set path = child.link -%}
        {%- endif -%}
        {%- set pushMicroData = microDataActive and link.level == 1 and not link.linkExternal and not link.children -%}
        {%- set liClass = haveIcons ? 'align-items-start' : 'align-items-center' -%}
        {%- set liClass = link.active ? ' active' : liClass -%}
        {%- set liClass = link.children and (not isHeader or link.level == 2) ? liClass~' dropdown' : liClass -%}
        {%- set liClass = link.children and link.level >= 2 and (not isHeader or link.level == 2) ? liClass~' dropdown-submenu' : liClass -%}
        {%- set liClass = link.media ? liClass~' item-logo' : liClass -%}
        {%- set liClass = link.level == 1 and not isLast and not notExpanded ? liClass~' me-lg-2 me-xl-3 me-xxl-4' : liClass -%}
        {%- set liClass = link.level == 1 ? liClass~' justify-content-end text-end text-'~expand~'-start' : liClass~' justify-content-start text-start' -%}
        {%- set liClass = isHeader ? liClass~' is-header mb-3' : liClass -%}
        <li class="nav-item d-flex level-{{ link.level }} {{ liClass }}"
            {% if link.children and link.level == 2 %}id="parent-item-{{ link.id }}"{% endif %}
            {% if pushMicroData %} itemscope="itemscope" itemtype="https://www.schema.org/SiteNavigationElement" {% endif %}>
            {%- set linkClass = link.class~' nav-link '~expand~' link-level-'~link.level -%}
            {%- set linkClass = link.level > 1 ? linkClass~' fw-600' : linkClass~' fw-600' -%}
            {%- set linkClass = link.children and not dropdownHover and (not isHeader or link.level == 2) ? linkClass~' as-dropdown-toggle dropdown-toggle' : (link.children and (not isHeader or link.level == 2) ? 'as-dropdown-toggle '~linkClass : linkClass) -%}
            {%- set linkClass = dropdownItem ? linkClass~' dropdown-item' : linkClass -%}
            {%- set linkClass = 1 == link.level ? linkClass~' text-initial text-secondary btn btn-blur' : linkClass~' text-initial text-secondary' -%}
            {%- set linkClass = isHeader ? linkClass~' ps-0 fw-700 text-primary' : linkClass -%}
            {%- set linkClass = not isHeader and link.level == 3 ? linkClass~' ps-3' : linkClass -%}
            {%- set linkClass = not isHeader and link.level >= 4 ? linkClass~' ps-4' : linkClass -%}
            {%- if link.level >= 3 -%}
                {%- if haveIcons -%}
                    <div class="pictogram-wrap me-3">
                        {%- if link.pictogram -%}
                            {{ asset(link.pictogram)|file({}, {class: 'pictogram', width: 40, height: 40}) }}
                        {%- endif -%}
                    </div>
                {%- endif -%}
                <div class="link-wrap">
            {%- endif -%}
                <{% if 'a' == element %}a{% else %}div{% endif %} class="{{ linkClass }}" {% if link.dataAnchor %} data-anchor="{{ link.dataAnchor }}" {% endif %}
                    href="{% if path %}{{ path }}{% else %}javascript:void(0){% endif %}" {% if link.children and not dropdownHover %} id="navbar-link-{{ link.id }}" {% endif %}
                    {% if link.linkBlank %} target="_blank" {% else %}{% endif %}
                    {% if link.linkExternal %} rel="noopener noreferrer" {% endif %}
                    {% if pushMicroData %} itemprop="url" {% endif %}>
                    {%- set linkLabel = link.linkLabel and link.level > 1 ? link.linkLabel : link.title -%}
                    {%- if link.media.haveMedia is defined and link.media.haveMedia -%}
                        {{ link.media|file }}
                        <span class="d-lg-none"{% if pushMicroData %} itemprop="name" {% endif %}>{{ linkLabel|unescape|raw }}</span>
                    {%- else -%}
                        <span class="link-label cursor {% if link.level > 1 %}text-secondary{% else %}text-secondary{% endif %}" {% if pushMicroData %} itemprop="name" {% endif %}>{{ linkLabel|unescape|raw }}</span>
                    {%- endif -%}
                </{% if 'a' == element %}a{% else %}div{% endif %}>
                {%- if link.level >= 3 -%}
                {%- if link.introduction -%}
                    <div class="intro mt-2">{{ link.introduction|raw }}</div>
                {%- endif -%}
            </div>
            {%- endif -%}
            {%- if link.children and (not isHeader or link.level == 2) -%}
                <div class="submenu text-start ps-4 pe-4 ps-lg-5 pe-lg-5 py-5 bg-white submenu-level-{{ link.level }}{% if isHeader %} is-header-submenu{% endif %}" data-level="{{ link.level }}">
                    {%- set displayBack = link.level >= 1 -%}
                    <div class="d-flex mb-5 pb-5 pb-lg-0">
                        <a class="d-none d-lg-inline-flex me-4" aria-label="{{ companyName|striptags }}" href="{{ app.request.getSchemeAndHttpHost() }}">
                            {{ asset(logo)|file({}, {
                                screensSizes: {
                                    mobile: {width: 71, height: 55},
                                    tablet: {width: 71, height: 55},
                                    laptop: {width: 105, height: 80},
                                    desktop: {width: 105, height: 80}
                                },
                                decor: false,
                                title: companyName,
                                class: 'force-size logo initial-color',
                                only_html: false,
                                lazyLoad: false,
                                priority: 'high'
                            }) }}
                        </a>
                        {%- if link.level == 1 -%}
                            <i class="close-menu-level-{{ link.level }} d-none d-lg-inline-flex close-menu-submenu ms-auto icon-times cursor align-items-center justify-content-center text-secondary"></i>
                        {%- else -%}
                            <i class="close-menu-level-{{ link.level }} d-none d-lg-inline-flex close-menu ms-auto icon-times cursor align-items-start justify-content-center text-secondary"></i>
                        {%- endif -%}
                    </div>
                    {%- set subLabel = link.subTitle ? link.subTitle : link.title -%}
                    {%- set parentEl = link.link ? 'a' : 'div' -%}
                    {%- set asLink = 'a' == parentEl -%}
                    <{{ parentEl }}{% if asLink %} href="{{ link.link }}" {% endif %} class="parent-label-wrap d-flex fw-700 align-items-center{% if not asLink %} dropdown-back-level-{{ link.level }}{% endif %}{% if not displayBack %} d-none{% endif %}{% if asLink %} btn btn-blur btn-blur-secondary d-inline-flex{% endif %}">
                        {%- if not asLink -%}
                            <i class="icon-arrow-left text-primary me-2 me-md-3"></i>
                        {%- endif -%}
                        <span class="parent-label text-secondary position-relative fw-500{% if not asLink %} text-uppercase text-underline fw-900{% endif %}">{{ subLabel|unescape|raw }}</span>
                        {%- if asLink -%}
                            <i class="icon-arrow-right text-primary ms-2 ms-md-3"></i>
                        {%- endif -%}
                    </{{ parentEl }}>
                    <div class="inner position-relative mt-4 mt-md-5 w-100">
                        <div class="inner-sub-wrap position-relative text-start w-100 {%- if link.level >= 3 -%}pt-4{%- else -%}mt-4 mt-lg-4{%- endif -%}" tabindex="-1">
                            {%- set haveColumns = false -%}
                            {%- set haveIcons = false -%}
                            {%- for subLink in link.children -%}
                                {%- if subLink.pictogram and subLink.level == 4 -%}
                                    {%- set haveIcons = true -%}
                                {%- endif -%}
                                {%- if subLink.children is not empty and subLink.level == 2 -%}
                                    {%- set haveColumns = true -%}
                                {%- endif -%}
                                {%- for subSubLInk in subLink.children -%}
                                    {%- if subSubLInk.pictogram is not empty and subLink.level == 2 -%}
                                        {%- set haveIcons = true -%}
                                    {%- endif -%}
                                    {%- if subSubLInk.children is not empty -%}
                                        {%- set haveColumns = true -%}
                                        {%- if subLink.pictogram and link.level == 1 -%}
                                            {%- set haveIcons = true -%}
                                        {%- endif -%}
                                    {%- endif -%}
                                {%- endfor -%}
                            {%- endfor -%}
                            {%- if haveColumns -%}
                                <div class="submenu-columns d-xl-flex{%- if link.level < 3 -%} pt-4{% endif %} w-100">
                                    {%- for subLink in link.children -%}
                                        <ul class="sublist ps-0 w-100">
                                            {{ macro.element(subLink, tree, companyName, logo, microDataActive, expand, dropdownHover, true, loop.last, websiteTemplate, notExpanded, haveIcons, true) }}
                                        </ul>
                                    {%- endfor -%}
                                </div>
                            {%- else -%}
                                <ul class="list-unstyled w-100">
                                    {%- for subLink in link.children -%}
                                        {{ macro.element(subLink, tree, companyName, logo, microDataActive, expand, dropdownHover, true, loop.last, websiteTemplate, notExpanded, haveIcons) }}
                                    {%- endfor -%}
                                </ul>
                            {%- endif -%}
                        </div>
                    </div>
                </div>
            {%- endif -%}
        </li>
    {%- endif -%}
{%- endmacro -%}

<div id="menu-container-{{ slug }}" class="menu-container as-lateral w-100 {% if alwaysFixed %}as-fixed fixed-top{% elseif fixedOnScroll %}as-sticky sticky-top{% else %}position-relative{% endif %}{% if alwaysFixed %} always-sticky{% endif %} {{ dropdownClass }}"
     data-expand="{{ expand }}"
     tabindex="0">
    {{ component('WebmasterEdit', {
        title: "Éditer le menu"|trans([], 'front_webmaster'),
        role: 'ROLE_NAVIGATION',
        path: path('admin_menu_edit', {website: website.id, menu: id, entitylocale: app.request.locale})
    }) }}
    <header id="main-navigation" class="navbar navbar-expand-{{ expand }} flex-column px-0 py-0">
        <div id="navigation-container" class="{{ size }}{% if size == 'container-fluid' %} px-3 px-xl-4 px-xxl-5{% endif %}">
            <div class="d-flex w-100">
                <div class="side d-flex align-items-center px-0">
                    {%- if logo -%}
                        <{% if 'h1' == compagnyNameElement %}h1{% else %}strong{% endif %} class="d-none" aria-hidden="true">{{ companyName|striptags }}</{% if 'h1' == compagnyNameElement %}h1{% else %}strong{% endif %}>
                        <a class="navbar-brand d-inline-flex p-0" aria-label="{{ companyName|striptags }}" href="{{ app.request.getSchemeAndHttpHost() }}">
                            {{ asset(logo)|file({}, {
                                screensSizes: {
                                    mobile: {width: 105, height: 80},
                                    tablet: {width: 105, height: 80},
                                    laptop: {width: 105, height: 80},
                                    desktop: {width: 105, height: 80}
                                },
                                decor: false,
                                title: companyName,
                                class: 'force-size logo initial-color',
                                only_html: false,
                                lazyLoad: false,
                                priority: 'high'
                            }) }}
                        </a>
                    {%- endif -%}
                    <div id="main-navigation-nav" class="collapse navbar-collapse {% if notExpanded %}submenu main-submenu not-expanded position-fixed bg-primary{% else %}position-relative{% endif %}">
                        <nav class="inner d-{{ expand }}-flex{% if notExpanded %} w-100 pt-5{% endif %}" role="navigation" aria-label="{{"Navigation principale"|trans|striptags }}">
                            {%- set class = 'mx-auto' == alignment ? 'px-3' : (not notExpanded ? 'ps-4 pe-4 ps-lg-0 pe-xl-0 ps-xxxl-5' : 'ps-4 pe-5') -%}
                            <ul class="navbar-nav {% if haveLogin %}w-100{% else %}{{ alignment }}{% endif %} pt-3{% if not notExpanded %} pt-{{ expand }}-0 pb-{{ expand }}-0{% endif %} {{ class }}">
                                {%- if displayHomePage -%}
                                    <li class="nav-item d-flex align-items-center justify-content-center level-1 text-center d-{{ expand }}-none{% if indexActive %} active{% endif %}"
                                        {% if microDataActive %} itemscope="itemscope" itemtype="https://www.schema.org/SiteNavigationElement" {% endif %}>
                                        <a href="{{ path('front_index') }}" class="nav-link link-level-1 fw-600 text-black{% if indexActive %} active{% endif %}"
                                            {% if microDataActive %} itemprop="url" {% endif %}>
                                            {%- if microDataActive -%}<span itemprop="name">{%- endif -%}{{ "Accueil"|trans|raw }}{%- if microDataActive -%}</span>{%- endif -%}
                                        </a>
                                    </li>
                                {%- endif -%}
                                {%- for link in links -%}
                                    {{ macro.element(link, tree, companyName, logo, microDataActive, expand, dropdownHover, false, loop.last, websiteTemplate, notExpanded) }}
                                {%- endfor -%}
                            </ul>
                        </nav>
                    </div>
                </div>
                <div class="side d-flex align-items-center justify-content-end ms-auto ps-lg-4 gap-2">
                    {%- if networks is not empty -%}
                        <nav class="socials-list d-inline-flex align-items-center justify-content-center me-md-3 gap-3 gap-md-2"
                             aria-label="{{"Navigation des liens sociaux"|trans|striptags }}">
                            {%- for name, infos in networks -%}
                                {%- if infos.link and infos.dirname -%}
                                    {%- set label = name|striptags|capitalize~' - '~'nouvelle fenêtre'|trans|striptags -%}
                                    <a href="{{ infos.link }}" class="{{ name }} p-0 d-inline-flex"
                                       rel="noopener noreferrer" target="_blank"
                                       data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ name|capitalize|striptags }}"
                                       aria-label="{{ label|capitalize|striptags }}">
                                        <i class="icon-{{ name|lower }} position-relative initial" aria-hidden="true"></i>
                                        <span class="visually-hidden">{{ label }}</span>
                                    </a>
                                {%- endif -%}
                            {%- endfor -%}
                        </nav>
                    {%- endif -%}
                    {%- if haveLogin -%}
                        {%- include 'front/'~websiteTemplate~'/actions/menu/login-nav.html.twig' with {
                            website: website,
                            expand: expand,
                            haveLogin: haveLogin,
                            microDataActive: microDataActive,
                        } only -%}
                    {%- endif -%}
                    {%- if contactPageUrl -%}
                        {%- include 'front/'~websiteTemplate~'/blocks/link/default.html.twig' with {
                            intl: {
                                link: path('front_index', {url: contactPageUrl}),
                                linkStyle: 'btn btn-blur btn-blur-primary btn-circle track-link-contact-form contact-link',
                                linkLabel: "Nous contacter"|trans,
                            },
                            icon: 'headset',
                            tooltip: true,
                            tooltipPosition: 'bottom',
                        } only -%}
                    {%- endif -%}
                    {%- set isDarkTheme = frontTheme() == 'dark' -%}
                    {%- set themeParam = isDarkTheme ? 'front_light_theme' : 'front_dark_theme' -%}
                    {%- if displayThemeBtn and configuration.darkTheme -%}
                        <a class="btn btn-circle btn-primary"
                           href="{{ replaceRequestParam(themeParam, 1) }}"
                           aria-label="{{ 'Changer de thème'|trans }}"
                           data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ 'Changer de thème'|trans }}">
                            <i class="icon-{{ isDarkTheme ? 'sun' : 'moon' }}"></i>
                        </a>
                    {%- endif -%}
                    {%- if multiLingues -%}
                        {{ render_esi(path('front_locales_switcher', {class: ''|url_encode, classname: currentClassname|url_encode, entityId: currentEntityId} )) }}
                    {%- endif -%}
                    {%- if 'search'|moduleActive(configuration) -%}
                        {{ render_esi(path('front_search_view', {filter: 'main', button: true, website: website.id} )) }}
                    {%- endif -%}
                    <button class="navbar-toggler ms-3" data-bs-toggle="collapse" data-bs-target="#main-navigation-nav" aria-controls="main-navigation-nav" aria-expanded="false" aria-label="{{"Menu"|trans|raw }}">
                        <span class="nav-toggler-icon" aria-label="{{"Menu"|trans|raw }}">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
        <div class="overlay position-fixed"></div>
    </header>
</div>