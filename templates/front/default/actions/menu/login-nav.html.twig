{%- trans_default_domain 'front_default' -%}

{%- set displayRegisterBtn = false -%}
{%- set haveRegistration = website.security.frontRegistration -%}
{%- set logoutPath = is_granted('IS_IMPERSONATOR') ? path('front_index', {_switch_user: '_exit'}) : path('app_logout') -%}
{%- set displayLogout = false -%}
{%- set adminInSession = not isUserFront(app.user) ? adminBackUser() : null -%}

<div id="login-nav" class="navbar-nav mx-auto ms-{{ expand }}-auto me-{{ expand }}-0 mt-4 mt-{{ expand }}-0 text-center">
    {%- if adminInSession -%}
        {%- set adminLabel = adminInSession.username ?: adminInSession.email -%}
        <a href="{{ path('security_front_forms') }}"
           class="ms-{{ expand }}-4 mb-3 mb-{{ expand }}-0 btn btn-circle btn-primary"
           aria-label="{{ ('Connecté en admin : %name%'|trans({'%name%': adminLabel})~' - '~'Choisir un compte utilisateur'|trans)|striptags }}"
           data-bs-toggle="tooltip" data-bs-placement="bottom"
           title="{{ ('Connecté en admin : %name%'|trans({'%name%': adminLabel})~' - '~'Choisir un compte utilisateur'|trans)|striptags }}">
            <i class="icon-user-edit" aria-hidden="true"></i>
        </a>
    {%- elseif not isUserFront(app.user) -%}
        <a href="{{ path('security_front_forms') }}"
           class="ms-{{ expand }}-4 mb-3 mb-{{ expand }}-0 btn btn-circle"
           aria-label="{{ 'Connectez-vous'|trans|striptags }}"
           data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ 'Connectez-vous'|trans|striptags }}">
            <i class="icon-user" aria-hidden="true"></i>
        </a>
        {%- if displayRegisterBtn and haveRegistration -%}
            <a href="{{ path('security_front_forms') }}"
               class="btn btn-circle btn-primary ms-{{ expand }}-4"
               aria-label="{{ 'Inscrivez-vous'|trans|striptags }}"
               data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ 'Inscrivez-vous'|trans|striptags }}">
                {{ 'fal user-plus'|icon(null, 17, '', {decor: true}) }}
            </a>
        {%- endif -%}
    {%- elseif is_granted('IS_AUTHENTICATED_FULLY') -%}
        {%- if displayLogout -%}
            <a href="{{ logoutPath }}"
               class="btn btn-circle btn-primary ms-{{ expand }}-4 mb-3 mb-{{ expand }}-0"
               aria-label="{{ 'Déconnectez-vous'|trans|striptags }}"
               data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ 'Déconnectez-vous'|trans|striptags }}">
                <i class="icon-power-off" aria-hidden="true"></i>
            </a>
        {%- endif -%}
        {%- if website.securityDashboardUrl -%}
            <a href="{{ website.securityDashboardUrl }}"
               class="btn btn-circle btn-outline-primary ms-{{ expand }}-4"
               aria-label="{{ 'Espace personnel'|trans|striptags }}"
               data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ 'Espace personnel'|trans|striptags }}">
                <i class="icon-user" aria-hidden="true"></i>
            </a>
        {%- endif -%}
    {%- endif -%}
</div>