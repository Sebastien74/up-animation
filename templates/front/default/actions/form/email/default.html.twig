{%- extends 'core/email/base.html.twig' -%}

{%- trans_default_domain 'email' -%}

{%- block metaTitle -%}{{ ("Nouvelle soumission de formulaire")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Un visiteur a soumis un formulaire sur votre site.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Notification interne")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Formulaire / Nouvelle entree")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Nouvelle soumission.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    <p style="margin:0 0 18px 0;">{{ ("Voici le detail des champs remplis par le visiteur.")|trans|raw }}</p>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-top:1px solid #E4DCCC;">
        {%- for fieldKey, field in fields -%}
            {%- set label = field.label ? field.label : fieldKey -%}
            {%- set display = true -%}
            {%- if not field.value|isArray and not field.value -%}
                {%- set display = false -%}
            {%- endif -%}
            {%- if not isUploadedFile(field.value) and display -%}
                <tr>
                    <td style="padding:14px 0; border-bottom:1px solid #E4DCCC;">
                        <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#7D7B8C; margin-bottom:6px;">{{ label|raw }}</div>
                        <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; font-weight:500; color:#22254E; line-height:1.5;">
                            {%- if field.value|isArray and field.value|length == 1 -%}
                                {%- include 'core/data-formater.html.twig' with {dataValue: field.value[0]} -%}
                            {%- elseif field.value|isArray -%}
                                {%- for value in field.value -%}
                                    {%- include 'core/data-formater.html.twig' with {dataValue: value} -%}
                                {%- endfor -%}
                            {%- else -%}
                                {%- include 'core/data-formater.html.twig' with {dataValue: field.value} -%}
                            {%- endif -%}
                        </div>
                    </td>
                </tr>
            {%- endif -%}
        {%- endfor -%}
        {%- if attachments is defined and attachments|length > 0 -%}
            <tr>
                <td style="padding:14px 0;">
                    <div style="font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#FF7100; margin-bottom:6px;">{{ ("Pieces jointes")|trans|raw }}</div>
                    <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; font-weight:600; color:#22254E;">{{ attachments|length }}</div>
                </td>
            </tr>
        {%- endif -%}
    </table>
{%- endblock -%}
