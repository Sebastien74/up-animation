{%- extends 'core/email/base.html.twig' -%}

{%- trans_default_domain 'email' -%}

{%- block metaTitle -%}{{ ("Confirmation de votre demande")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Nous avons bien reçu votre message.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Contact")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Contact / Accusé de réception")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Message bien reçu.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    {%- if message is defined and message -%}
        {{ message|raw }}
    {%- else -%}
        <p style="margin:0 0 14px 0;">{{ ("Bonjour,")|trans|raw }}</p>
        <p style="margin:0 0 14px 0;">{{ ("Nous avons bien reçu votre demande et nous vous remercions de votre prise de contact.")|trans|raw }}</p>
        <p style="margin:0;">{{ ("Notre équipe vous répondra dans les meilleurs délais.")|trans|raw }}</p>
    {%- endif -%}
{%- endblock -%}

{%- block info -%}
    {{ ("Vous n'avez rien à faire pour le moment. Vous recevrez notre réponse à l'adresse depuis laquelle vous nous avez écrit.")|trans|raw }}
{%- endblock -%}
