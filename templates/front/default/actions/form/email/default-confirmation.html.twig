{%- extends 'core/email/base.html.twig' -%}

{%- trans_default_domain 'email' -%}

{%- block metaTitle -%}{{ ("Confirmation de votre demande")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Nous avons bien recu votre demande.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Formulaire")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Accuse de reception")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Demande enregistree.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    {%- if message is defined and message -%}
        {{ message|raw }}
    {%- else -%}
        <p style="margin:0;">{{ ("Votre demande a bien ete enregistree. Nous reviendrons vers vous tres prochainement.")|trans|raw }}</p>
    {%- endif -%}
{%- endblock -%}

{%- block info -%}
    {{ ("Cet email confirme la bonne reception de vos informations. Aucune action supplementaire n est requise.")|trans|raw }}
{%- endblock -%}
