{%- extends 'core/email/base.html.twig' -%}

{%- trans_default_domain 'email' -%}

{%- block metaTitle -%}{{ ("Confirmation de votre demande")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Nous avons bien reçu votre demande.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Formulaire")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Accusé de réception")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Demande enregistrée.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    {%- if message is defined and message -%}
        {{ message|raw }}
    {%- else -%}
        <p style="margin:0;">{{ ("Votre demande a bien été enregistrée. Nous reviendrons vers vous très prochainement.")|trans|raw }}</p>
    {%- endif -%}
{%- endblock -%}

{%- block info -%}
    {{ ("Cet email confirme la bonne réception de vos informations. Aucune action supplémentaire n'est requise.")|trans|raw }}
{%- endblock -%}
