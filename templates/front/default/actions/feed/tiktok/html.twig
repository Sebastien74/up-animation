<div class="tiktok-feed-container">
    <div class="row g-3">
        {% for video in feed %}
            <div class="col-12 col-md-4 col-lg-3">
                <div class="tiktok-item card h-100 border-0 shadow-sm overflow-hidden">
                    <a href="{{ video.share_url }}" target="_blank" rel="noopener" class="d-block position-relative">
                        <img src="{{ video.cover_image_url }}" alt="{{ video.title|default(video.video_description) }}" class="card-img-top object-fit-cover" style="height: 400px;">
                        <div class="position-absolute top-50 start-50 translate-middle">
                            <i class="bi bi-play-circle-fill text-white fs-1 opacity-75"></i>
                        </div>
                    </a>
                    <div class="card-body p-2">
                        <p class="card-text small text-truncate mb-0">
                            {{ video.video_description }}
                        </p>
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <span class="badge bg-dark">TikTok</span>
                            <small class="text-muted">{{ video.create_time|date('d/m/Y') }}</small>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-center text-muted">Aucune vidéo TikTok à afficher pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
