{% if feed is not empty %}
    <div class="instagram-feed">
        <div class="row g-3">
            {% for item in feed %}
                <div class="col-6 col-md-4 col-lg-3">
                    <a href="{{ item.permalink }}" target="_blank" rel="noopener" class="instagram-item d-block position-relative overflow-hidden shadow-sm rounded">
                        {% if item.media_type == 'VIDEO' %}
                            <img src="{{ item.thumbnail_url }}" alt="{{ item.caption|default('Instagram Video') }}" class="img-fluid w-100">
                            <div class="video-icon position-absolute top-0 end-0 m-2">
                                <i class="fas fa-play-circle text-white fa-lg"></i>
                            </div>
                        {% else %}
                            <img src="{{ item.media_url }}" alt="{{ item.caption|default('Instagram Image') }}" class="img-fluid w-100">
                        {% endif %}
                        <div class="instagram-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center opacity-0 bg-dark bg-opacity-50 transition-all">
                            <i class="fab fa-instagram text-white fa-2x"></i>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>

    <style>
        .instagram-item:hover .instagram-overlay {
            opacity: 1 !important;
        }
        .instagram-item img {
            transition: transform 0.3s ease;
            aspect-ratio: 1/1;
            object-fit: cover;
        }
        .instagram-item:hover img {
            transform: scale(1.1);
        }
        .transition-all {
            transition: all 0.3s ease;
        }
    </style>
{% endif %}
