{% if feed is not empty %}
    <div class="instagram-feed">
        <div class="row g-3">
            {% for post in feed %}
                <div class="col-6 col-md-4 col-lg-3">
                    <a href="{{ post.permalink }}" target="_blank" rel="noopener" class="instagram-item d-block position-relative overflow-hidden shadow-sm rounded">
                        {% if post.mediaType == 'VIDEO' and post.thumbnailLocalPath %}
                            <img src="{{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_480') }}"
                                 srcset="{{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_320') }} 320w,
                                         {{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_480') }} 480w,
                                         {{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_640') }} 640w"
                                 sizes="(min-width: 992px) 280px, (min-width: 768px) 33vw, 50vw"
                                 width="280" height="280"
                                 alt="{{ post.caption|default('Instagram Video')|u.truncate(120, '…') }}"
                                 class="img-fluid w-100" loading="lazy" decoding="async">
                            <div class="video-icon position-absolute top-0 end-0 m-2">
                                <i class="fas fa-play-circle text-white fa-lg"></i>
                            </div>
                        {% elseif post.mediaLocalPath %}
                            <img src="{{ asset(post.mediaLocalPath) | imagine_filter('feed_thumb_480') }}"
                                 srcset="{{ asset(post.mediaLocalPath) | imagine_filter('feed_thumb_320') }} 320w,
                                         {{ asset(post.mediaLocalPath) | imagine_filter('feed_thumb_480') }} 480w,
                                         {{ asset(post.mediaLocalPath) | imagine_filter('feed_thumb_640') }} 640w"
                                 sizes="(min-width: 992px) 280px, (min-width: 768px) 33vw, 50vw"
                                 width="280" height="280"
                                 alt="{{ post.caption|default('Instagram Image')|u.truncate(120, '…') }}"
                                 class="img-fluid w-100" loading="lazy" decoding="async">
                        {% elseif post.thumbnailLocalPath %}
                            <img src="{{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_480') }}"
                                 srcset="{{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_320') }} 320w,
                                         {{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_480') }} 480w,
                                         {{ asset(post.thumbnailLocalPath) | imagine_filter('feed_thumb_640') }} 640w"
                                 sizes="(min-width: 992px) 280px, (min-width: 768px) 33vw, 50vw"
                                 width="280" height="280"
                                 alt="{{ post.caption|default('Instagram Image')|u.truncate(120, '…') }}"
                                 class="img-fluid w-100" loading="lazy" decoding="async">
                        {% endif %}
                        <div class="instagram-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center opacity-0 bg-dark bg-opacity-50 transition-all">
                            <i class="fab fa-instagram text-white fa-2x"></i>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>

    <style>
        .instagram-item:hover .instagram-overlay {
            opacity: 1 !important;
        }
        .instagram-item img {
            transition: transform 0.3s ease;
            aspect-ratio: 1/1;
            object-fit: cover;
        }
        .instagram-item:hover img {
            transform: scale(1.1);
        }
        .transition-all {
            transition: all 0.3s ease;
        }
    </style>
{% endif %}
