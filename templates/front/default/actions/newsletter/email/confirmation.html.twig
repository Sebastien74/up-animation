{%- extends 'core/email/base.html.twig' -%}

{%- trans_default_domain 'email' -%}

{%- block metaTitle -%}{{ ("Confirmez votre inscription")|trans|striptags }}{%- endblock -%}

{%- block preheader -%}
    {{ ("Un dernier geste pour rejoindre nos actualités.")|trans|raw }}
{%- endblock -%}

{%- block headerRight -%}{{ ("Newsletter")|trans|raw }}{%- endblock -%}

{%- block kicker -%}{{ ("Newsletter / Confirmation")|trans|raw }}{%- endblock -%}

{%- block title -%}{{ ("Plus qu'un clic.")|trans|raw }}{%- endblock -%}

{%- block body -%}
    {%- if message -%}
        {{ message|replace({'%confirmationLink%': absolute_url(confirmationLink)})|raw }}
    {%- else -%}
        <p style="margin:0 0 14px 0;">{{ ("Bonjour,")|trans|raw }}</p>
        <p style="margin:0 0 14px 0;">{{ ("Vous avez demandé à recevoir notre newsletter. Pour finaliser votre inscription et commencer à recevoir nos actualités, confirmez votre adresse email en cliquant sur le bouton ci-dessous.")|trans|raw }}</p>
    {%- endif -%}
{%- endblock -%}

{%- block cta -%}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center" bgcolor="#FF7100" style="background-color:#FF7100; padding:18px 32px; mso-padding-alt:18px 32px;">
                <a href="{{ confirmationLink }}" target="_blank" style="display:inline-block; color:#FFFFFF; font-family:Consolas, 'Lucida Console', Monaco, monospace; font-size:13px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; line-height:1;">
                    {{ ("Confirmer mon inscription")|trans|raw }}&nbsp;&nbsp;&rarr;
                </a>
            </td>
        </tr>
    </table>
{%- endblock -%}

{%- block info -%}
    {{ ("Ce lien est valable pendant 24 heures. Passé ce délai, vous devrez effectuer une nouvelle demande d'inscription. Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email.")|trans|raw }}
{%- endblock -%}
