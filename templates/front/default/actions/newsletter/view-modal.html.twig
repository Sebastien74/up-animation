{%- trans_default_domain 'front_default' -%}

<div id="newsletter-modal-{{ campaign.id }}"
     class="modal fade newsletter-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="newsletter-modal-{{ campaign.id }}-label"
     aria-hidden="true"
     data-newsletter-modal-delay="15000"
     data-newsletter-modal-cookie="newsletter-modal-{{ campaign.id }}-{{ app.request.locale }}">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content border-0 overflow-hidden">
            <button type="button" class="newsletter-modal-close position-absolute top-0 end-0 m-3 z-1 d-inline-flex align-items-center justify-content-center border-0 bg-transparent p-0" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                <i class="icon-times" aria-hidden="true"></i>
            </button>
            <div class="modal-body p-0">
                {%- include 'front/'~websiteTemplate~'/actions/newsletter/view-modal-content.html.twig' -%}
            </div>
        </div>
    </div>
</div>
