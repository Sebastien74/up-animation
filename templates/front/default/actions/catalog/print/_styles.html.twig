        line-height: 1.35;
        margin-bottom: 3px;
        padding-left: 14px;
        position: relative;
        color: #22254e;
        page-break-inside: avoid;
    }
    .list-item:before {
        content: "\2192";
        position: absolute;
        left: 0;
        color: #ff7100;
        font-weight: bold;
    }
    .reference-line {
        font-size: 7pt;
        font-weight: 600;
        letter-spacing: 1.4pt;
        text-transform: uppercase;
        color: #9a9cb3;
        margin-top: 10px;
    }
    .cta-box {
        background-color: #22254e;
        padding: 14px 20px 13px 20px;
        border-radius: 20px;
        margin-top: 22px;
        text-align: center;
        page-break-inside: avoid;
    }
    .cta-box .cta-small {
        display: block;
        font-size: 8.5pt;
        font-weight: bold;
        letter-spacing: 1.6pt;
        text-transform: uppercase;
        color: #ff7100;
        margin-bottom: 5px;
        line-height: 1;
    }
    .cta-box .cta-main {
        display: block;
        font-size: 11.5pt;
        font-weight: bold;
        letter-spacing: 0.6pt;
        text-transform: uppercase;
        color: #ffffff;
        line-height: 1;
    }
    .footer {
        position: fixed;
        bottom: -90px;
        left: 0;
        right: 0;
        width: 100%;
        font-size: 8pt;
        color: #22254e;
        line-height: 1.3;
    }
    .footer-table {
        width: 100%;
        border-top: 0.25pt solid #b4b6c9;
        padding-top: 12px;
    }
    .footer-logo {
        vertical-align: middle;
    }
    .footer-logo img {
        max-height: 35px;
    }
    .footer-logo .brand-fallback {
        font-family: 'Poppins', sans-serif;
        font-size: 14pt;
        font-weight: bold;
        color: #22254e;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .footer-address {
        text-align: center;
        font-size: 8pt;
        color: #22254e;
        vertical-align: middle;
    }
    .footer-address .mail {
        color: #ff7100;
        font-weight: 600;
    }
    .footer-phone {
        text-align: right;
        vertical-align: middle;
    }
    .footer-phone a {
        font-size: 11pt;
        font-weight: bold;
        color: #ff7100;
        text-decoration: none;
        letter-spacing: 0.4pt;
    }
