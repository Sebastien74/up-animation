        color: #22254e;
        line-height: 1.25;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .description {
        font-size: 8pt;
        line-height: 1.15;
        color: #4a4e6e;
        text-align: justify;
    }
