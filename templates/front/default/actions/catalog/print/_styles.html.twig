        display: block;
        font-size: 6.5pt;
        font-weight: bold;
        letter-spacing: 1.4pt;
        text-transform: uppercase;
        color: #ff7100;
        line-height: 1;
        margin-bottom: 4px;
    }
    .feature-value {
        display: block;
        font-size: 8pt;
