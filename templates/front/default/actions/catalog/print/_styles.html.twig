<style>
    @font-face {
        font-family: 'Poppins';
        src: url('{{ fonts.regular }}') format('truetype');
        font-weight: normal;
        font-style: normal;
    }
    @font-face {
        font-family: 'Poppins';
        src: url('{{ fonts.medium }}') format('truetype');
        font-weight: 500;
        font-style: normal;
    }
    @font-face {
        font-family: 'Poppins';
        src: url('{{ fonts.semibold }}') format('truetype');
        font-weight: 600;
        font-style: normal;
    }
    @font-face {
        font-family: 'Poppins';
        src: url('{{ fonts.bold }}') format('truetype');
        font-weight: bold;
        font-style: normal;
    }
    @page {
        margin: 40px 30px 110px 30px;
    }
    @page :first {
        margin-top: 0;
    }
    body {
        font-family: 'Poppins', 'DejaVu Sans', sans-serif;
        font-size: 11pt;
        color: #22254e;
        margin: 0;
        padding: 0;
        line-height: 1;
    }
    h1, h2, h3, p, ul, li {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .page-break {
        page-break-before: always;
    }
    .header {
        padding: 15px 0 20px 0;
    }
    .header-table {
        width: 100%;
        border-collapse: collapse;
    }
    .header-logo {
        width: 50%;
        text-align: left;
        vertical-align: middle;
    }
    .header-logo img {
        max-height: 60px;
    }
    .header-logo .brand-fallback {
        font-size: 22pt; font-weight: bold; letter-spacing: 2px;
        color: #22254e; text-transform: uppercase;
    }
    .header-link {
        width: 50%;
        text-align: right;
        vertical-align: middle;
        font-size: 8pt;
        color: #4a4e6e;
        line-height: 1;
    }
    .header-link .label {
        display: block;
        font-size: 6.5pt;
        font-weight: bold;
        letter-spacing: 1.4pt;
        text-transform: uppercase;
        color: #ff7100;
        line-height: 1;
        margin: 0;
        padding: 0;
    }
    .header-link a {
        display: block;
        color: #22254e;
        text-decoration: none;
        word-break: break-all;
        font-weight: 600;
        font-size: 5pt;
        line-height: 1;
        margin: -1px 0 0 0;
        padding: 0;
    }
    .container {
        padding: 8px 0 0 0;
    }
    .left-col {
        float: left;
        width: 45%;
    }
    .right-col {
        float: right;
        width: 50.5%;
    }
    .clear {
        clear: both;
    }
    .main-image {
        width: 100%;
        border-radius: 20px;
        margin-bottom: 10px;
    }
    .gallery {
        width: 100%;
    }
    .main-title-wrap {
        margin-bottom: 17px;
    }
    .title {
        font-size: 20pt;
        font-weight: bold;
        line-height: 1;
        color: #22254e;
        margin: 0 0 8px 0;
        padding: 0;
    }
    .sub-title {
        display: block;
        font-size: 9pt;
        font-weight: 400;
        color: #4a4e6e;
        line-height: 1.3;
        margin-top: 4px;
    }
    .feature-badge {
        display: inline-block;
        background-color: #ff7100;
        color: #ffffff;
        padding: 8px 14px;
        border-radius: 18px;
        font-size: 7pt;
        font-weight: bold;
        letter-spacing: 1.5pt;
        text-transform: uppercase;
        line-height: 1;
    }
    .section-title {
        font-size: 7pt;
        font-weight: bold;
        letter-spacing: 2pt;
        text-transform: uppercase;
        margin-top: 15px;
        margin-bottom: 7px;
        color: #ff7100;
        border-top: 1px solid #e1e2ee;
        padding-top: 10px;
        padding-bottom: 3px;
        page-break-after: avoid;
    }
    .features-grid {
        width: 100%;
        border-collapse: separate;
        border-spacing: 5px;
        table-layout: fixed;
        margin: -5px 0 5px -5px;
    }
