{%- trans_default_domain 'front_default' -%}

{%- set blockType = block.blockType is defined and block.blockType ? block.blockType.slug : null -%}
{%- set catalogSlug = entity.catalog.slug is defined ? entity.catalog.slug : null -%}
{%- set asAgency = entity.asAgency -%}

{%- if blockType == 'layout-title-header' -%}

    {%- set pageTitle = entity.intl.title -%}
    {%- if asAgency and not pageTitle -%}
        {%- if entity.city or entity.department or entity.zipcodeSmall -%}
            {%- set pageTitle = 'Animations événementielles' -%}
            {%- if entity.city or entity.department or entity.zipcodeSmall -%}
                {%- set pageTitle = pageTitle~'<br>' -%}
                {%- if entity.city -%}
                    {%- set pageTitle = pageTitle~' à <span class="text-primary">'~entity.city~'</span>' -%}
                {%- endif -%}
                {%- if entity.department -%}
                    {%- set pageTitle = pageTitle~' '~entity.department|deptPreposition~entity.department -%}
                {%- endif -%}
                {%- if entity.zipcodeSmall -%}
                    {%- set pageTitle = pageTitle~' '~entity.zipcodeSmall -%}
                {%- endif -%}
                {%- if entity.country != 'FR' -%}
                    {%- set pageTitle = pageTitle~' en '~entity.country|countryName -%}
                {%- endif -%}
            {%- endif -%}
        {%- else -%}
            {%- set pageTitle = entity.adminName -%}
        {%- endif -%}
    {%- endif -%}

    {%- set displayMainMedia = false -%}
    {%- include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
        block: entity,
        customMedia: displayMainMedia ? entity.mainMedia : entity.headerMedia,
        titleForce: 1,
        fullSize: true,
        page: page,
        contactUrl: asAgency ? entity.contactUrl : false,
        pageTitle: pageTitle,
        template: websiteTemplate,
        thumbConfiguration: thumbConfigurationHeader
    } -%}

{%- elseif blockType == 'layout-title' and entity.intl.title -%}

    <h{{ entity.intl.titleForce }} class="title mt-4 mb-4">{{ entity.intl.title|raw }}</h{{ entity.intl.titleForce }}>

{%- elseif blockType == 'layout-published-date' and entity.date -%}

    {%- include 'front/'~websiteTemplate~'/actions/vendor/include/layout-published-date.html.twig' with {entity: entity} only -%}

{%- elseif blockType == 'layout-intro' -%}

    {%- if asAgency and not entity.intl.introduction -%}
        <p class="introduction">{{ "Vous souhaitez<strong> animer votre prochain événement</strong> dans la ville %city_prefix%%city%%dept_preposition%%dept%&nbsp;? Faites confiance à l'équipe Up&nbsp;Animations spécialiste %city_prefix%%city% et ses environs. Nous vous proposons des <strong>animations expertes</strong> pour séminaires, team building, soirées d'entreprise, anniversaires d'entreprise, arbres de Noël, centres commerciaux et offices de tourisme. Avec Up&nbsp;Animations vous vous offrez des animations pour événements <strong>100% uniques et personnalisées</strong>."|trans({
                '%city_prefix%': entity.city ? entity.city|deCityPrefix : '',
                '%city%': entity.city ?: '',
                '%dept_preposition%': entity.department ? ' ' ~ entity.department|deptPreposition : '',
                '%dept%': entity.department ?: ''
            })|raw }}</p>
    {%- elseif entity.intl.introduction -%}
        <p class="introduction {% if not asAgency %}text-bold{% else %}bg-light{% endif %}">{{ entity.intl.introduction|raw }}</p>
    {%- endif -%}

{%- elseif blockType == 'layout-body' -%}

    {%- if asAgency and not entity.intl.body -%}
        <div class="body">
            <p class="mb-2">{{ "Votre partenaire Up&nbsp;Animations <strong>basé dans la ville %city_prefix%%city%</strong> vous propose ses services d'<strong>animations pour tout événement</strong> d'entreprise. Offrez à vos invités des animations professionnelles uniques. Nous vous proposons de <strong>nombreuses animations</strong> %dept_preposition%%dept%%zipcode%."|trans({'%city_prefix%': entity.city ? entity.city|deCityPrefix : '', '%city%': entity.city ?: '', '%dept_preposition%': entity.department ? entity.department|deptPreposition('all_in') : '', '%dept%': entity.department ?: '', '%zipcode%': entity.zipcodeSmall ? '&nbsp;' ~ entity.zipcodeSmall : ''})|raw }}</p>
            <p class="mb-2">{{ "Nous nous <strong>adaptons à toutes vos demandes</strong> et à tous vos besoins en terme d'animations et de thèmes. Nous vous offrons pour cela un large panel d'animations."|trans|raw }}</p>
            <p class="mb-2">{{ "Choisissez votre prochaine <strong>animation en fonction de votre événement</strong>&nbsp;: team building, séminaire, soirée d'entreprise, anniversaire d'entreprise, arbre de Noël, centre commercial, événementiel, office de tourisme et même magie. Toutes nos animations sont disponibles %dept_preposition%%dept% et dans toutes les <strong>villes proches %city_prefix%%city%</strong>&nbsp;!"|trans({'%dept_preposition%': entity.department ? entity.department|deptPreposition('all_in') : '', '%dept%': entity.department ?: '', '%city_prefix%': entity.city ? entity.city|deCityPrefix : '', '%city%': entity.city ?: ''})|raw }}</p>
            <p class="mb-0">{{ "Faites vite appel à votre partenaire événementiel Up&nbsp;Animations&nbsp;!"|trans|raw }}</p>
        </div>
    {%- elseif entity.intl.body -%}
        <div class="body">{{ entity.intl.body|raw }}</div>
    {%- endif -%}

{%- elseif blockType == 'layout-video' and entity.mainVideo -%}

    {%- include 'front/'~websiteTemplate~'/blocks/video/default.html.twig' with {media: entity.mainVideo} -%}

{%- elseif blockType == 'layout-gallery' and entity.medias is not empty -%}

    {%- include 'front/'~websiteTemplate~'/include/gallery.html.twig' with {gallery: entity, slug: 'product'} -%}

{%- elseif blockType == 'layout-slider' and entity.medias is not empty -%}

    {%- set slideType = 'thumbnails' -%}

    <div class="mt-4 mt-lg-0">
        {%- if 'thumbnails' == slideType -%}
            {%- include 'front/'~websiteTemplate~'/actions/slider/template/splide.html.twig' with {
                medias: entity.medias,
                thumbConfiguration: thumbConfigurationView,
                arrowsSide: 'side',
                arrowsColor: 'blur',
                arrowsAsBtn: true,
                slider: {
                    effect: 'fade',
                    thumbnails: true,
                    pause: true,
                    control: true,
                    autoplay: false,
                    indicators: false,
                    progress: false,
                    popup: false,
                    offsetDesktop: 0,
                    offsetMiniPC: 0,
                    offsetTablet: 0,
                    offsetMobile: 0,
                    arrowAlignment: 'side',
                    intervalDuration: 2000,
                    itemsPerSlide: 1,
                    itemsPerSlideMiniPC: 1,
                    itemsPerSlideTablet: 1,
                    itemsPerSlideMobile: 1,
                }
            } -%}
        {%- else -%}
            {%- include 'front/'~websiteTemplate~'/actions/slider/template/bootstrap.html.twig' with {
                sliderSlug: 'product',
                websiteTemplate: websiteTemplate,
                entity: entity,
                medias: entity.medias,
                interfaceName: interfaceName,
                mainMediaInHeader: entity.mainMediaInHeader,
                disabledTitleForce: true,
                class: false,
                fade: true,
                popup: true,
                arrows: true,
                thumbConfiguration: thumbConfigurationView,
                screensSizes: {
                    mobile: {width: null, height: 238},
                    tablet: {width: null, height: 375},
                    desktop: {width: null, height: 375}
                },
            } only -%}
        {%- endif -%}
    </div>

{%- elseif blockType == 'layout-link' and entity.intl.link -%}

    {%- include 'front/'~websiteTemplate~'/blocks/link/default.html.twig' with {intl: entity.intl} -%}

{%- elseif blockType == 'layout-image' -%}

    {%- set mainMedia = entity.asAgency ? entity.mediasWithoutMain|first : entity.mainMedia -%}
    {%- if mainMedia -%}
        <div class="masked-wrap masked-wrap-secondary image-wrap">{{ mainMedia|file(thumbConfiguration) }}</div>
    {%- endif -%}

{%- elseif blockType == 'layout-catalog-lots-table' -%}

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>{{ "Lot N°"|trans|raw }}</th>
                    <th>{{ "Type"|trans|raw }}</th>
                    <th>{{ "Surface"|trans|raw }}</th>
                    <th>{{ "Surface balcon / terrasse"|trans|raw }}</th>
                    <th>{{ "Prix (€)"|trans|raw }}</th>
                </tr>
            </thead>
            <tbody>
                {%- for lot in entity.entity.lots -%}
                    <tr>
                        {%- set reference = "n/c"|trans -%}
                        {%- if lot.reference -%}
                            {%- set reference = lot.reference -%}
                        {%- endif -%}
                        <td data-title="{{"Lot N°"|trans|raw~" "~reference }}">
                            {{ reference|raw  }}
                        </td>
                        {%- set type = "n/c"|trans -%}
                        {%- if lot.type -%}
                            {%- set type = lot.type -%}
                        {%- endif -%}
                        <td data-title="{{"Type :"|trans|raw~" "~type }}">
                            {{ type|raw  }}
                        </td>
                        {%- set surface = "n/c"|trans -%}
                        {%- if lot.surface -%}
                            {%- set surface = lot.surface -%}
                            {%- if 'm²' not in surface -%}
                                {%- set surface = surface~"m²" -%}
                            {%- endif -%}
                        {%- endif -%}
                        <td data-title="{{"Surface :"|trans|raw~" "~surface }}">
                            {{ surface|raw }}
                        </td>
                        {%- set balconySurface = "n/c"|trans -%}
                        {%- if lot.balconySurface -%}
                            {%- set balconySurface = lot.balconySurface -%}
                            {%- if 'm²' not in balconySurface -%}
                                {%- set balconySurface = balconySurface~"m²" -%}
                            {%- endif -%}
                        {%- endif -%}
                        <td data-title="{{"Surface balcon / terrasse :"|trans|raw~" "~balconySurface }}">
                            {{ balconySurface|raw }}
                        </td>
                        {%- set sold = "n/c"|trans -%}
                        {%- if lot.sold -%}
                            {%- set sold = "Vendu"|trans -%}
                        {%- elseif lot.price > 0 -%}
                            {%- set sold = lot.price|format_currency('EUR', {rounding_mode: 'ceiling', fraction_digit: 0}) -%}
                        {%- endif -%}
                        <td data-title="{{"Prix (€) :"|trans|raw~" "~sold }}">
                            {{ sold|raw  }}
                        </td>
                    </tr>
                {%- endfor -%}
            </tbody>
        </table>
    </div>

{%- elseif blockType == 'layout-contact' -%}

    {%- include 'front/'~websiteTemplate~'/actions/information/view.html.twig' with {website: website} only -%}

{%- elseif blockType == 'layout-catalog-features' and entity.values['byFeaturesSlugs'] is defined and entity.values['byFeaturesSlugs'] is not empty -%}

    {%- set featureId = block.data.featureId is defined ? block.data.featureId : null -%}
    {%- set feature = entity.values.featuresByIds[featureId] is defined ? entity.values.featuresByIds[featureId] : [] -%}
    {%- set featureSlug = feature.slug is defined ? feature.slug : null -%}
    {%- set values = entity.values.byFeaturesIds[featureId] is defined ? entity.values.byFeaturesIds[featureId] : [] -%}

    {%- if values is not empty -%}
        <h2 class="title fw-600 mb-5">{{ feature.intl.title|raw }}</h2>
        <ul>
            {%- for value in values -%}
                <li>{{ value.value.intl.title|striptags }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}

{%- elseif blockType == 'layout-map' and entity.entity.informations[0].addresses[0] is defined -%}

    {%- set information = entity.entity.informations[0] -%}
    {%- set address = information.addresses[0] -%}
    {%- set zoom = address.zoom ? address.zoom : 11 -%}
    {%- set minZoom = address.minZoom ? address.minZoom : 5 -%}
    {%- set maxZoom = address.maxZoom ? address.maxZoom : 20 -%}

    {%- if address.latitude and address.longitude -%}
        <div class="map-container">
            <div id="product-map-{{ entity.id }}" class="map-box" data-layer="" data-multiple="">
                <div class="data-map d-none"
                     data-zoom="{{ zoom }}"
                     data-min-zoom="{{ minZoom }}"
                     data-max-zoom="{{ maxZoom }}"
                     data-latitude="{{ address.latitude }}"
                     data-longitude="{{ address.longitude }}"
                     data-marker-clusters=""
                     data-enlarge-txt="{{"Agrandir le plan"|trans|raw }}"
                     data-direction-txt="{{"Itinéraire"|trans|raw }}">
                    <div class="point"
                         data-id="3"
                         data-category="category"
                         data-marker="{{ asset('uploads/'~website.uploadDirname~'/marker-orange.svg')}}"
                         data-marker-width="30" data-marker-height="30"
                         data-latitude="{{ address.latitude }}"
                         data-longitude="{{ address.longitude }}"
                         data-media=""
                         data-title=""
                         data-body=""
                         data-link=""
                         data-link-label="{{"En savoir plus"|trans|raw }}"
                         data-link-label-icon="{{"En savoir plus"|trans|raw }}"
                         data-link-target=""
                         data-name="{{ entity.intl.link }}"
                         data-address="{{ address.address|unescape|raw }}"
                         data-zip-code="{{ address.zipCode|unescape|raw }}"
                         data-city="{{ address.city|unescape|raw }}"
                         data-department="{{ address.department|unescape|raw }}"
                         data-region="{{ address.region|unescape|raw }}"
                         data-country="{{ address.country|countryName }}"
                         data-google-map-url="{{ address.googleMapUrl }}"
                         data-google-map-direction-url="{{ address.googleMapDirectionUrl }}">
                        {%- for phone in information.phones -%}
                            <div class="phone" data-number="{{ phone.number }}" data-href="{{ phone.tagNumber }}"></div>
                        {%- endfor -%}
                    </div>
                </div>
            </div>
        </div>
    {%- endif -%}

{%- elseif blockType == 'layout-back-button' -%}

    {%- set pageUrl = pageUrl is defined ? pageUrl : null -%}
    {%- if pageUrl -%}
        {%- set btnLabel = entity.catalog.intl.linkLabel is defined and entity.catalog.intl.linkLabel
            ? entity.catalog.intl.linkLabel : "Retourner à la liste des produits"|trans -%}
        <a href="{{ path('front_index', {url: pageUrl}) }}" class="link">
            <i class="icon-chevron-left me-2"></i>{{ btnLabel|raw }}
        </a>
    {%- endif -%}

{%- elseif blockType == 'layout-associated-entities' -%}

    {%- set display = layout.associatedEntitiesDisplay is defined and layout.associatedEntitiesDisplay ? layout.associatedEntitiesDisplay : 'slider' -%}
    {%- if asAgency -%}
        {%- set listingTitle = 'Découvrez<br> <span>nos autres agences</span>'|trans|raw -%}
    {%- endif -%}
    <div class="associated-entities-container w-100{% if associatedEntities.list is empty %} empty-associated-entities{% endif %}">
        {%- if associatedEntities.list is empty -%}
            <p class="mb-0">{{ "Aucun produit associés."|trans|raw }}</p>
        {%- elseif 'slider' == display -%}
            {%- include 'front/'~websiteTemplate~'/actions/vendor/include/layout-associated-entities-slider.html.twig' -%}
        {%- elseif 'list' == display -%}
            {%- include 'front/'~websiteTemplate~'/actions/vendor/include/layout-associated-entities-list.html.twig' -%}
        {%- else -%}
            {%- include 'front/'~websiteTemplate~'/actions/vendor/include/layout-associated-entities-cards.html.twig' -%}
        {%- endif -%}
    </div>

{%- elseif blockType == 'layout-secondary-title' -%}

    <div class="block-secondary-title">
        <span class="subtitle text-uppercase d-inline-block mb-2">{{ "À la recherche d'un professionnel&nbsp;?"|trans|raw }}</span>
        <h2 class="title text-uppercase">{{ "Des animations pour<br> <span>tous vos événements <br>%dept_preposition%%dept%</span>"|trans({'%dept_preposition%': entity.department ? entity.department|deptPreposition ~ ' ' : '', '%dept%': entity.department ?: ''})|raw }}</h2>
    </div>

{%- elseif blockType == 'layout-agency-animations-events' -%}

    <div class="layout-agency-animations-events row">
        {{ render_esi(controller('App\\Controller\\Front\\Action\\CatalogController::teaser', {filter: 'agencies-animations-events'})) }}
    </div>

{%- elseif blockType == 'layout-agency-animations' -%}

    <div class="agency-animations row">
        <div class="col-xl-8">
            <h2 class="title text-uppercase">{{ "Découvrez nos animations<br> <span>séminaire, team building & soirée d'entreprise à %city%</span>"|trans({'%city%': entity.city ?: ''})|raw }}</h2>
        </div>
        {{ render_esi(controller('App\\Controller\\Front\\Action\\CatalogController::teaser', {filter: 'agencies-animations'})) }}
    </div>

{%- elseif blockType == 'layout-highlights-agency' -%}

    <div class="agency-highlights">
        <h2 class="title text-uppercase mb-5">{{ "Pourquoi animer son événement<br> <span>professionnel à %city%&nbsp;?</span>"|trans({'%city%': entity.city ?: ''})|raw }}</h2>
        <div class="row d-flex justify-content-center">
            <div class="col-lg-4">
                <div class="card radius bg-secondary h-100 px-3 py-2">
                    <div class="card-header d-flex flex-column px-4 pt-4 pb-0 mb-3 border-0">
                        <div class="inner d-flex align-items-center">
                            <span class="rounded-badge shadow d-flex align-items-center justify-content-center bg-white me-3"><i class="icon-people-group text-primary"></i></span>
                            <strong class="text-uppercase lh-1">{{ "Réunir"|trans|raw }}</strong>
                        </div>
                        <hr class="text-white">
                    </div>
                    <div class="card-body px-4 pt-0 pb-4">
                        <div class="body">
                            {%- if entity.intl.gather -%}
                                {{ entity.intl.gather|raw }}
                            {%- else -%}
                                <p class="mb-2">{{ "Up&nbsp;Animations vous propose des animations originales et festives pour tous vos événements à %city%."|trans({'%city%': entity.city ?: ''})|raw }}</p>
                                <p class="mb-2">{{ "Faites parler de vous et de votre événement autour de vous grâce à des animations qui sauront marquer les esprits."|trans|raw }}</p>
                                <p class="mb-2">{{ "Notre équipe vous propose des animations hors du commun qui offrira surprise et interactivité. Nous vous offrons également la possibilité de créer votre animation événementielle 100% sur mesure pour répondre à tous vos objectifs."|trans|raw }}</p>
                                <p class="mb-2">{{ "Vous avez une idée ? Nous nous chargeons de la mettre en œuvre %dept_preposition%%dept%. Pour que votre événement d'entreprise ne ressemble qu'à vous&nbsp;!"|trans({'%dept_preposition%': entity.department ? entity.department|deptPreposition : '', '%dept%': entity.department ?: ''})|raw }}</p>
                                <p class="mb-0">{{ "Alors qu'attendez-vous&nbsp;?"|trans|raw }}</p>
                            {%- endif -%}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card radius bg-secondary-light h-100 px-3 py-2">
                    <div class="card-header d-flex flex-column px-4 pt-4 pb-0 mb-3 border-0">
                        <div class="inner d-flex align-items-center">
                            <span class="rounded-badge shadow d-flex align-items-center justify-content-center bg-dark me-3"><i class="icon-face-grin text-white"></i></span>
                            <strong class="text-uppercase lh-1">{{ "Sympathiser"|trans }}</strong>
                        </div>
                        <hr class="text-dark">
                    </div>
                    <div class="card-body px-4 pt-0 pb-4">
                        <div class="body">
                            {%- if entity.intl.sympathise -%}
                                {{ entity.intl.sympathise|raw }}
                            {%- else -%}
                                <p class="mb-2">{{ "La solution Up&nbsp;Animations c'est organiser des événements professionnels d'envergure à %city%."|trans({'%city%': entity.city ?: ''})|raw }}</p>
                                <p class="mb-2">{{ "Nous nous occupons de tout&nbsp;: la logistique, l'organisation et la mise en place du matériel."|trans|raw }}</p>
                                <p class="mb-2">{{ "Nous pouvons vous proposer la création d'olympiades&nbsp;: des jeux et des challenges vous attendent. De nombreuses animations vous sont proposées&nbsp;: la soirée casino, un après-midi modélisme ou encore faire la course en buggy téléguidé."|trans|raw }}</p>
                                <p class="mb-0">{{ "Nos équipes restent disponibles pour prendre en main vos animations tout au long de votre Anniversaire d'entreprise. Faites confiance à Up&nbsp;Animations à %city% pour rendre votre événement unique aux yeux de vos invités&nbsp;!"|trans({'%city%': entity.city ?: ''})|raw }}</p>
                            {%- endif -%}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card radius bg-secondary-lighten h-100 px-3 py-2">
                    <div class="card-header d-flex flex-column px-4 pt-4 pb-0 mb-3 border-0">
                        <div class="inner d-flex align-items-center">
                            <span class="rounded-badge shadow d-flex align-items-center justify-content-center bg-dark me-3"><i class="icon-thumbs-up text-white"></i></span>
                            <strong class="text-uppercase lh-1">{{ "Marquer"|trans }}</strong>
                        </div>
                        <hr class="text-dark">
                    </div>
                    <div class="card-body px-4 pt-0 pb-4">
                        <div class="body">
                            {%- if entity.intl.impress -%}
                                {{ entity.intl.impress|raw }}
                            {%- else -%}
                                <p class="mb-2">{{ "Choisissez votre partenaire Up&nbsp;Animations pour l'animation de votre prochain événement à %city%, c'est être sûr de marquer les esprits de vos invités."|trans({'%city%': entity.city ?: ''})|raw }}</p>
                                <p class="mb-2">{{ "Nous répondons à tous vos objectifs&nbsp;: visibility ou notoriété."|trans|raw }}</p>
                                <p class="mb-2">{{ "Nos animateurs et magiciens se rendent sur votre événement dans n'importe quelle ville près de votre entreprise. Nous nous chargeons de toutes les animations de votre événement professionnel dans la ville %city_prefix%%city% et %dept_preposition%%dept%%zipcode%."|trans({'%city_prefix%': entity.city ? entity.city|deCityPrefix : '', '%city%': entity.city ?: '', '%dept_preposition%': entity.department ? entity.department|deptPreposition('all_in') : '', '%dept%': entity.department ?: '', '%zipcode%': entity.zipcodeSmall ? '&nbsp;' ~ entity.zipcodeSmall : ''})|raw }}</p>
                                <p class="mb-2">{{ "Marquez les esprits et les journaux&nbsp;! Avec une animation originale pour des retombées médiatiques positives."|trans|raw }}</p>
                                <p class="mb-0">{{ "Profitez d'un tel événement pour faire parler de vous et de votre enseigne."|trans|raw }}</p>
                            {%- endif -%}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{%- elseif blockType == 'layout-agency-animations-city' -%}

    <div class="agency-animations-city">
        <h2 class="title text-uppercase">{{ "Découvrez toutes <br> <span>nos animations %dept_preposition%%dept%%zipcode%</span>"|trans({'%dept_preposition%': entity.department ? entity.department|deptPreposition ~ ' ' : '', '%dept%': entity.department ?: '', '%zipcode%': entity.zipcodeSmall ? '&nbsp;' ~ entity.zipcodeSmall : ''})|raw }}</h2>
    </div>

{%- elseif blockType == 'layout-share' -%}

    {%- include 'front/'~websiteTemplate~'/blocks/share/default.html.twig' -%}

{%- endif -%}