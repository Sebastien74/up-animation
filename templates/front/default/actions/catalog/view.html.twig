{%- extends 'front/'~websiteTemplate~'/base.html.twig' -%}

{%- trans_default_domain 'front_default' -%}

{%- import 'front/'~websiteTemplate~'/include/macros/microdata.html.twig' as microdata -%}

{%- block microData -%}
    {{ microdata.product(entity.entity, seo, entity.mainMedia) }}
{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('front-'~websiteTemplate~'-catalog', null, webpack) }}
    <link rel="modulepreload" href="{{ preload(asset('build/front/'~websiteTemplate~'/front-'~websiteTemplate~'-catalog.js', webpack), {as: 'script', importance: 'low'}) }}" as="script" fetchpriority="low" nonce="{{ csp_nonce() }}">
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
    {{ encore_entry_script_tags('front-'~websiteTemplate~'-catalog', null, webpack, {defer: true, nonce: csp_nonce()}) }}
{%- endblock -%}

{%- block body -%}
    <div id="body-catalog-{{ entity.catalog.slug }}" class="template-page product-view-container view-container position-relative">
        {%- if entity.haveLayout -%}
            {%- include 'front/'~websiteTemplate~'/layout.html.twig' with {layout: entity.entityForLayout.layout, asLayout: true} -%}
        {%- elseif entity.template is defined and entity.template -%}
            {%- include entity.template -%}
        {%- else -%}
            {%- include 'front/'~websiteTemplate~'/actions/catalog/view/default-product.html.twig' -%}
        {%- endif -%}
        {%- if entity.faq -%}
            <section class="product-faq-container pb-lg">
                <div class="container">
                    {{ render_esi(controller('App\\Controller\\Front\\Action\\FaqController::view', {filter: entity.faq})) }}
                </div>
            </section>
        {%- endif -%}
    </div>
{%- endblock -%}