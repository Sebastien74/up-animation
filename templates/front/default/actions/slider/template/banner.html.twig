{%- trans_default_domain 'front_default' -%}

{%- set withThumbs = false -%}
{%- set side = 'left' -%}
{%- set speed = 100 -%}

<div class="marquee marquee-{{ side }} items-center"
     data-direction="{{ side }}"
     data-speed="{{ speed }}">
    <div class="marquee-inner">
        <div class="marquee-content d-inline-flex align-items-center">
            {%- for media in medias -%}
                {% set mediaType = (media.media.screen is defined and media.media.screen == 'poster')
                    or (media.intl.video is defined and media.intl.video) ? 'video' : 'image' %}
                {% set display = mediaType != 'video' and media.media.filename is defined and media.media.filename %}
                {%- if display -%}
                    <div class="marquee-item d-flex align-items-center justify-content-center px-2 h-100">
                        {%- if withThumbs -%}
                            {{ media|file(thumbConfiguration, {
                                notInBox: true,
                                maxWidth: fileSizes.width is defined ? fileSizes.width : null,
                                maxHeight: fileSizes.height is defined ? fileSizes.height : 70,
                                popupGallery: slider.popup,
                                fullPopup: slider.popup,
                                colSize: colSize
                            }) }}
                        {%- else -%}
                            {%- set path = media|file(thumbConfiguration, {
                                path: true,
                            }) -%}
                            {%- set title = media.intl.title ? media.intl.title : media.entity.name -%}
                            <img src="{{ path }}" alt="{{ title }}" class="img-fluid img-{{ media.extension }}" height="70" {% if 'svg' == media.extension %} style="height: 70px;" {% endif %}>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </div>
</div>