{%- trans_default_domain 'front_default' -%}

{%- set side = 'left' -%}
{%- set speed = 50 -%}

<div class="marquee marquee-{{ side }} items-center overflow-hidden"
     data-direction="{{ side }}"
     data-speed="{{ speed }}">
    <div class="marquee-inner">
        <div class="marquee-content d-inline-flex align-items-center">
            {%- for media in medias -%}
                {% set mediaType = (media.media.screen is defined and media.media.screen == 'poster')
                    or (media.intl.video is defined and media.intl.video) ? 'video' : 'image' %}
                {% set display = mediaType != 'video' and media.media.originalName is defined and media.media.originalName %}
                {%- if display -%}
                    <div class="marquee-item d-flex align-items-center justify-content-center px-2 h-100">
                        {%- set mediaInfo = fileInfo(website, media.media.originalName) -%}
                        {%- set ratio = mediaInfo and mediaInfo.width and mediaInfo.height ? (mediaInfo.width / mediaInfo.height) : null -%}
                        {%- set mobileHeight = 35 -%}
                        {%- set tabletHeight = 45 -%}
                        {%- set desktopHeight = fileSizes.height is defined ? fileSizes.height : 50 -%}
                        {# Fallback largeur quand le ratio est inconnu (fileInfo indisponible, SVG, etc.) #}
                        {%- set fallbackWidth = fileSizes.width is defined ? fileSizes.width : 120 -%}
                        {%- set mobileWidth = ratio ? (ratio * mobileHeight)|round(0, 'ceil') : fallbackWidth -%}
                        {%- set tabletWidth = ratio ? (ratio * tabletHeight)|round(0, 'ceil') : fallbackWidth -%}
                        {%- set desktopWidth = fileSizes.width is defined ? fileSizes.width : (ratio ? (ratio * desktopHeight)|round(0, 'ceil') : fallbackWidth) -%}
                        {{ media|file(thumbConfiguration, {
                            notInBox: true,
                            screensSizes: {
                                mobile: {width: mobileWidth, height: mobileHeight},
                                tablet: {width: tabletWidth, height: tabletHeight},
                                laptop: {width: desktopWidth, height: desktopHeight},
                                desktop: {width: desktopWidth, height: desktopHeight}
                            },
                            popupGallery: slider.popup,
                            fullPopup: slider.popup,
                            colSize: colSize
                        }) }}
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </div>
</div>