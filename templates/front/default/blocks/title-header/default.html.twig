{%- trans_default_domain 'front_default' -%}

{%- set title = pageTitle is defined ? pageTitle : (intl.title is defined ? intl.title : null) -%}
{%- set city = city is defined ? city : null -%}
{%- set department = department is defined ? department : null -%}
{%- set region = region is defined ? region : null -%}
{%- set disableImage = disableImage is defined ? disableImage : false -%}
{%- set people = people is defined ? people : false -%}
{%- set duration = duration is defined ? duration : false -%}
{%- set age = age is defined ? age : false -%}
{%- set environment = environment is defined ? environment : false -%}
{%- set haveFeatures = people or duration or age or environment -%}

{%- if title -%}
    {%- set animActive = false -%}
    {%- set anim = website.configuration.transitions|transitionsAttributes({
        title: animActive ? 'block-title-header-title' : null,
        subtitle: animActive? 'block-title-header-subtitle' : null
    }) -%}
    {%- set large = block.large is defined ? block.large : false -%}
    {%- set backgroundColor = block.col.zone.backgroundColor is defined and block.col.zone.backgroundColor ? block.col.zone.backgroundColor
        : (backgroundColor is defined and backgroundColor ? backgroundColor : false) -%}
    {%- set isIndex = isIndex is defined and isIndex -%}
    {%- set interfaceName = interfaceName is defined ? interfaceName : false -%}
    {%- set subTitle = subTitle is defined ? subTitle : (intl.subTitle is defined ? intl.subTitle : null) -%}
    {%- set bodyTitle = bodyTitle is defined ? bodyTitle : null -%}
    {%- set body = body is defined ? body : (intl.body is defined ? intl.body : null) -%}
    {%- set page = parentPage is defined and parentPage ? parentPage : (page is defined and page ? page : (seo.entity is defined ? seo.entity : null)) -%}
    {%- set isIndexPage = page and currentEntity.asIndex is not defined or page and currentEntity.asIndex is defined and not currentEntity.asIndex -%}
    {%- set currentEntity = seo.entity is defined ? (seo.entity is defined ? seo.entity : null) -%}
    {%- set contactUrl = contactUrl is defined ? contactUrl : null -%}
    {%- set thumbConfiguration = thumbConfiguration is defined and thumbConfiguration and thumbConfiguration|isArray ? thumbConfiguration : {} -%}
    {%- set printUrl = printUrl is defined ? printUrl : null -%}
    {%- set defaultMedia = true -%}
    {%- set defaultMedia = defaultMedia and logos['title-header'] is defined and logos['title-header'] ? logos['title-header'] : null -%}
    {%- set displayMedia = customMedia is defined and customMedia ? customMedia : (media.media.originalName is defined and media.media.originalName ? media : defaultMedia) -%}
    {%- set displayMedia = backgroundColor ? false : displayMedia -%}
    {%- set mediaPath = mediaPath is defined ? mediaPath : null -%}
    {%- set titleForce = titleForce is defined and titleForce ? titleForce : (intl.titleForce is defined and intl.titleForce ? intl.titleForce : 1) -%}
    {%- set displayBreadcrumb = (isIndexPage and configuration.breadcrumb and not isIndex) or (forceBreadcrumb is defined and forceBreadcrumb) -%}
    {%- set styleClass = styleClass is defined and styleClass ? styleClass : '' -%}
    {%- set styleClass = large and styleClass ? styleClass~' align-items-start as-large' : (large ? 'align-items-start as-large' : 'align-items-end') -%}
    {%- set styleClass = haveFeatures ? styleClass~' have-features' : styleClass -%}
    <div class="title-header-block container position-relative{% if large %} as-large{% endif %}{% if backgroundColor %} {{ backgroundColor }}{% endif %}{% if styleClass %} {{ styleClass }}{% endif %}">
        <div class="row m-0">
            <div class="col-lg-6 col-xl-7 pe-xl-5 d-flex title-content position-relative">
                <div class="inner">
                    {%- if displayBreadcrumb -%}
                        {%- set pageTitle = pageTitle is defined ? pageTitle : title -%}
                        {%- set breadcrumbOptions = breadcrumbOptions is defined ? breadcrumbOptions : [] -%}
                        {%- set breadcrumbs = page|breadcrumb(pageTitle, currentEntity, breadcrumbOptions) -%}
                        {%- include "front/"~websiteTemplate~"/include/breadcrumb.html.twig" with {
                            website: website,
                            background: 'transparent',
                            paddingLeft: 'ps-0',
                            paddingRight: 'pe-0',
                            breadcrumbs: breadcrumbs
                        } only -%}
                    {%- endif -%}
                    <div class="title-wrap mb-4 mb-lg-5">
                        <h{{ titleForce }} class="title text-uppercase fw-900 mb-0{% if style is defined and style %} {{ style }}{% endif %}{% if anim.title.class %} {{ anim.title.class|raw }}{% endif %}"
                            {% if anim.title.attr %} {{ anim.title.attr|raw }}{% endif %}>
                            {{ title|unescape|raw }}
                            {%- if city -%}
                                <span class="city text-primary">
                                    {{ 'à %city%'|trans({
                                        '%city%': city
                                    })|raw }}
                                </span>
                            {%- endif -%}
                            {%- if department -%}
                                <span class="department text-primary">
                                    {{ department|deptPreposition~department }}
                                </span>
                            {%- endif -%}
                            {%- if region -%}
                                <span class="region text-primary">
                                    {{ region|regPreposition~region }}
                                </span>
                            {%- endif -%}
                        </h{{ titleForce }}>
                        {%- if subTitle -%}
                            <div class="w-100 mt-2 {% if anim.subtitle.class %} {{ anim.subtitle.class|raw }}{% endif %}"
                                {% if anim.subtitle.attr %} {{ anim.subtitle.attr|raw }}{% endif %}>
                                <strong class="sub-title d-inline-block fw-300 w-100 sub-title-h{{ titleForce }}">{{ subTitle|raw }}</strong>
                            </div>
                        {%- endif -%}
                        {%- if bodyTitle or body -%}
                            <div class="body mt-4 row">
                                <div class="col-xxl-10">
                                    {%- if bodyTitle -%}
                                        <strong class="d-inline-block w-100 mb-2">{{ bodyTitle|raw }}</strong>
                                    {%- endif -%}
                                    {%- if body -%}
                                        {{ body|raw }}
                                    {%- endif -%}
                                </div>
                            </div>
                        {%- endif -%}
                        {%- if contactUrl or printUrl -%}
                            <div class="title-header-actions d-flex flex-wrap align-items-center gap-3 mt-5">
                                {%- if contactUrl -%}
                                    {%- include 'front/'~websiteTemplate~'/blocks/link/default.html.twig' with {
                                        intl: {
                                            link: contactUrl,
                                            linkStyle: 'btn btn-blur btn-blur-primary',
                                            linkLabel: "Nous contacter"|trans,
                                        }
                                    } only -%}
                                {%- endif -%}
                                {%- if printUrl -%}
                                    <a href="{{ printUrl }}" class="btn-print d-inline-flex align-items-center gap-2" target="_blank" rel="noopener" aria-label="{{ "Télécharger la fiche au format PDF"|trans }}">
                                        <i class="icon-file-pdf" aria-hidden="true"></i>
                                        <span>{{ "Fiche PDF"|trans|raw }}</span>
                                    </a>
                                {%- endif -%}
                            </div>
                        {%- endif -%}
                    </div>
                </div>
            </div>
            {%- if (mediaPath or displayMedia) and not disableImage -%}
                <div class="col-lg-6 col-xl-5 media-content d-flex align-items-end">
                    <div class="masked-wrap masked-wrap-first w-100">
                        {%- set screensSizes = screensSizes is defined ? screensSizes : {} -%}
                        {%- set thumbSizes = screensSizes is empty ? thumbConfiguration : {} -%}
                        {%- if mediaPath -%}
                            {{ asset(mediaPath)|file(thumbSizes, {lazyLoad: false, screensSizes: screensSizes}) }}
                        {%- elseif displayMedia -%}
                            {{ displayMedia|file(thumbSizes, {lazyLoad: false, screensSizes: screensSizes}) }}
                        {%- endif -%}
                    </div>
                </div>
            {%- endif -%}
        </div>
    </div>
    {%- if isIndexPage -%}
        {%- include 'front/'~websiteTemplate~'/include/sub-navigation.html.twig' with {page: page, website: website} only -%}
    {%- endif -%}
{%- endif -%}

{%- if haveFeatures -%}
    <div class="title-header-features container">
        <div class="row mx-0">
            <div class="col-lg-6 col-xl-7 pe-xl-5">
                {%- set featureList = [
                    { 'data': people, 'class': 'people', 'icon': 'people-group', 'label': "Nombre de personnes"|trans|raw },
                    { 'data': duration, 'class': 'duration', 'icon': 'clock', 'label': "Durée"|trans|raw },
                    { 'data': age, 'class': 'age', 'icon': 'face-grin', 'label': "Âge"|trans|raw },
                    { 'data': environment, 'class': 'environment', 'icon': 'map-marker-alt-solid', 'label': "Environnement"|trans|raw },
                ] -%}
                <div class="features d-flex flex-wrap gap-3">
                    {%- for feature in featureList -%}
                        {%- if feature.data is not empty -%}
                            <div class="feature shadow-sm feature-{{ feature.class }} h-100 bg-white py-3 ps-3 pe-4">
                                <div class="feature-head d-flex gap-3">
                                    <span class="feature-icon d-inline-flex align-items-center justify-content-center">
                                        <i class="icon-{{ feature.icon }} flex-shrink-0 lh-1" aria-hidden="true"></i>
                                    </span>
                                    <div class="feature-content d-flex flex-column">
                                        <strong class="feature-label text-uppercase d-inline-flex align-items-center">{{ feature.label }}</strong>
                                        <ul class="feature-values d-flex flex-column gap-1 list-unstyled m-0 reset">
                                            {%- for item in feature.data -%}
                                                <li class="feature-value fw-600">{{ item.valueTitle|raw }}</li>
                                            {%- endfor -%}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </div>
{%- endif -%}