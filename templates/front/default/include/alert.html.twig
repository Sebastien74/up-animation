{%- trans_default_domain 'front_default' -%}

{%- set icons = {
    success: {icon: 'check', bgColor: 'success', color: 'success', iconColor: 'white-50'},
    info: {icon: 'info', bgColor: 'info', color: 'primary', iconColor: 'white-50'},
    warning: {icon: 'exclamation', bgColor: 'warning', color: 'warning', iconColor: 'white-50'},
    danger: {icon: 'exclamation-triangle', bgColor: 'danger', color: 'danger', iconColor: 'white-50'},
    error: {icon: 'exclamation-triangle', bgColor: 'danger', color: 'danger', iconColor: 'white-50'},
    undefined: {icon: 'info', bgColor: 'primary', color: 'primary', iconColor: 'white'},
} -%}

{%- set display = display is defined ? display : "toast" -%}
{%- set size = size is defined ? size : null -%}
{%- set icon = icons[alert].icon is defined ? icons[alert].icon : icons['undefined'].icon -%}
{%- set bgColor = icons[alert].bgColor is defined ? icons[alert].bgColor : icons['undefined'].bgColor -%}
{%- set color = icons[alert].color is defined ? icons[alert].color : icons['undefined'].color -%}
{%- set iconColor = icons[alert].iconColor is defined ? icons[alert].iconColor : icons['undefined'].iconColor -%}
{%- set help = help is defined ? help : null -%}
{%- set class = class is defined ? class : (alertClass is defined ? alertClass : null) -%}

{%- if 'alert' == display -%}
    <div class="alert alert-{{ bgColor }} d-flex align-items-center gap-3 shadow-sm{% if class %} {{ class }}{% endif %}" role="alert">
        <span class="alert-icon d-inline-flex align-items-center justify-content-center rounded-circle bg-{{ bgColor }} text-white flex-shrink-0">
            <i class="icon-{{ icon }}"></i>
        </span>
        <div class="flex-grow-1 text-start">
            {%- if 'small' == size -%}<small class="d-inline-block">{%- endif -%}
            {{ message|raw }}
            {%- if help -%}<br>{{ help|raw }}{%- endif -%}
            {%- if 'small' == size -%}</small>{%- endif -%}
        </div>
    </div>
{%- elseif 'toast' == display -%}
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div class="toast toast-alert fade show border-0 bg-{{ alert }}" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header d-flex border-0 no-radius py-3 px-3">
                <div class="inner d-flex align-items-center initial pe-3">
                    {{ icon|icon(null, 17, alert~' me-2') }}
                    {{ message|unescape|raw }}
                </div>
                <button type="button" class="btn-close ms-auto initial" data-bs-dismiss="toast" aria-label="{{ 'Fermer'|trans|raw }}"></button>
            </div>
        </div>
    </div>
{%- endif -%}