{%- trans_default_domain 'front_default' -%}

{%- import _self as macro -%}
{%- set addresses = website.infoZones.addresses.footer is defined ? website.infoZones.addresses.footer : [] -%}
{%- set address = addresses|first -%}
{%- set phones = addresses|length <= 1 and website.infoZones.phones.footer is defined ? website.infoZones.phones.footer : [] -%}
{%- set emails = addresses|length <= 1 and website.infoZones.emails.footer is defined ? website.infoZones.emails.footer : [] -%}
{%- set footerDescription = information.introduction is defined and information.introduction|striptags|length > 0 ? information.introduction : null -%}
{%- set footerDescription = seo.footerDescription is defined and seo.footerDescription|striptags|length > 0 ? seo.footerDescription : footerDescription -%}
{%- set logo = logos.footer is defined ? logos.footer : null -%}
{%- set contactUrl = mainPages.contact.code is defined ? mainPages.contact.code : null -%}
{%- set animationsUrl = mainPages.animations.code is defined ? mainPages.animations.code : null -%}

{%- macro uaContact(website, icon, title, type, data, label) -%}
    <div class="col-12 col-lg-3">
        <div class="contact-item h-100 d-flex align-items-center justify-content-center py-2 py-md-3">
            <div class="h-100 d-flex flex-column flex-md-row text-center text-md-start align-items-center gap-3">
                <div class="contact-icon d-flex align-items-center justify-content-center rounded-3" aria-hidden="true">
                    <i class="icon-{{ icon }} text-secondary"></i>
                </div>
                <div class="d-flex flex-column gap-1">
                    <div class="contact-title text-uppercase text-white-75">{{ title|raw }}</div>
                    {%- if 'emails' == type -%}
                        {%- for email in data -%}
                            {{ email.email|email(website, {icon: false, only_href: true, entitled: false, class: 'link fw-600 d-inline-block'}) }}
                        {%- endfor -%}
                    {%- elseif 'phones' == type -%}
                        {%- for phone in data -%}
                            {{ phone|phone(website, {icon: false, only_href: true, entitled: false, class: 'link fw-600 d-inline-block'}) }}
                        {%- endfor -%}
                    {%- elseif 'link' == type -%}
                        <div class="fw-600 contact-label"><a href="{{ data|raw }}">{{ label|raw }}</a></div>
                    {%- elseif 'text' == type -%}
                        <div class="fw-600 contact-label">{{ data|raw }}</div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    </div>
{%- endmacro -%}

{%- macro menu(catalogMenus, category, title) -%}
    {%- if catalogMenus[category] is not empty -%}
        <div class="col-12 col-md-6">
            <h3 class="footer-title pb-2 mb-3 fw-900 text-uppercase text-white">{{ title|striptags }}</h3>
            <ul class="list-unstyled d-grid gap-2 mb-4 ps-3">
                {%- for item in catalogMenus[category] -%}
                    <li><a class="footer-link text-white-75 text-hover-primary d-inline-block{% if not loop.last %} mb-1{% endif %}" href="{{ item.url }}">{{ item.intl.title|striptags }}</a></li>
                {%- endfor -%}
            </ul>
        </div>
    {%- endif -%}
{%- endmacro -%}

<footer id="footer" class="footer text-white position-relative">

    <div class="footer-divider">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>

    <section class="footer-contact pb-4">
        <div class="container">
            <div class="row g-3 g-lg-0 contact align-items-stretch">
                {%- if agencies is not empty -%}
                    {{ macro.uaContact(website, 'map-marker-alt-solid', "Plusieurs agences"|trans, 'text', agencies|length ~ " en France & Suisse"|trans) }}
                {%- endif -%}
                {%- if emails is not empty -%}
                    {{ macro.uaContact(website, 'envelope-solid', "Contactez-nous par mail"|trans, 'emails', emails) }}
                {%- endif -%}
                {%- if contactUrl -%}
                    {{ macro.uaContact(website, 'envelope-solid', "Utiliser notre formulaire"|trans, 'link', path('front_index', {url: contactUrl}), "Écrivez-nous"|trans) }}
                {%- endif -%}
                {%- if phones is not empty -%}
                    {{ macro.uaContact(website, 'phone-alt-solid', "Appelez-nous"|trans, 'phones', phones) }}
                {%- endif -%}
            </div>
        </div>
    </section>

    {%- if 'newsletter'|moduleActive(configuration) -%}
        {{ render_esi(path('front_newsletter_view', {filter: 'main', website: website.id} )) }}
        {{ render_esi(path('front_newsletter_view', {filter: 'main', website: website.id, displayModal: true, idSuffix: '-modal'} )) }}
    {%- endif -%}

    <section class="footer-main pt-4 pt-md-5 pb-5">
        <div class="container">
            <div class="row m-0 g-4">
                <div class="col-12 col-lg-4 pe-lg-5 mt-0">
                    <div class="brand pe-lg-4">
                        {%- if logo -%}
                            <a class="d-inline-block" aria-label="{{ companyName|striptags }}"
                               href="{{ app.request.getSchemeAndHttpHost() }}">
                                {{ asset(logo)|file({}, {
                                    screensSizes: {
                                        mobile: {width: null, height: 75},
                                        tablet: {width: null, height: 100},
                                        laptop: {width: null, height: 120},
                                        desktop: {width: null, height: 120}
                                    },
                                    title: companyName,
                                    id: 'main-footer-logo',
                                    class: 'force-size initial-color mb-3',
                                    only_html: false,
                                    lazyLoad: true
                                }) }}
                            </a>
                        {%- endif -%}
                        <p class="text-white-75 mb-4">
                            {{ "Animations et spectacles professionnels pour %seminars_start%séminaires%seminars_end%, %teambuilding_start%team building%teambuilding_end% et %evenings_start%soirées d’entreprise%evenings_end%."|trans({
                                '%seminars_start%': '<span class="text-white fw-semibold">',
                                '%seminars_end%': '</span>',
                                '%teambuilding_start%': '<span class="text-white fw-semibold">',
                                '%teambuilding_end%': '</span>',
                                '%evenings_start%': '<span class="text-white fw-semibold">',
                                '%evenings_end%': '</span>'
                            })|raw }}
                        </p>
                        {%- if contactUrl -%}
                            <div class="d-flex flex-wrap gap-2">
                                {%- if contactUrl -%}
                                    {%- include 'front/'~websiteTemplate~'/blocks/link/default.html.twig' with {
                                        intl: {
                                            link: path('front_index', {url: contactUrl}),
                                            linkStyle: 'btn btn-primary my-1',
                                            linkLabel: 'Demander un devis'|trans,
                                        },
                                        icon: 'headset',
                                    } only -%}
                                {%- endif -%}
                                {%- if animationsUrl -%}
                                    {%- include 'front/'~websiteTemplate~'/blocks/link/default.html.twig' with {
                                        intl: {
                                            link: path('front_index', {url: animationsUrl}),
                                            linkStyle: 'btn btn-white my-1',
                                            linkLabel: 'Voir les animations'|trans,
                                        },
                                        icon: 'people-group',
                                    } only -%}
                                {%- endif -%}
                            </div>
                        {%- endif -%}
                        {%- if agencies is not empty -%}
                            <hr class="sep my-4">
                            <h3 class="footer-title pb-2 mb-3 fw-900 text-uppercase text-white">{{ "Nos agences"|trans }}</h3>
                            <div class="d-flex flex-wrap gap-2">
                                {%- for agency in agencies -%}
                                    <a class="city text-white-75 px-3" href="{{ agency.url }}">{{ "Agence %city%"|trans({'%city%': agency.city}) }}</a>
                                {%- endfor -%}
                            </div>
                        {%- endif -%}
                        {%- if website.networks is not empty -%}
                            <hr class="sep my-4">
                            <h3 class="footer-title pb-2 mb-3 fw-900 text-uppercase text-white">{{ "Restez connecté&nbsp;!"|trans|raw }}</h3>
                            <p class="text-white-75">{{ "Rejoignez %company% sur les %socials% dès maintenant&nbsp;!"|trans({
                                '%company%': '<strong class="text-white-75">' ~ (companyName|unescape|replace({'!': ''})) ~ '</strong>',
                                '%socials%': '<strong class="text-white-75">' ~ ("réseaux sociaux"|trans) ~ '</strong>'
                            })|raw }}</p>
                            <div class="d-flex flex-wrap">
                                <nav class="socials-list d-inline-flex justify-content-center justify-content-sm-start gap-3"
                                     aria-label="{{"Navigation des liens sociaux"|trans|striptags }}">
                                    {%- for name, infos in website.networks -%}
                                        {%- if infos.link and infos.dirname and 'google' not in name -%}
                                            {%- set label = name|striptags|capitalize~' - '~'nouvelle fenêtre'|trans|striptags -%}
                                            <a href="{{ infos.link }}" class="{{ name }} p-0 d-inline-flex"
                                                rel="noopener noreferrer" target="_blank"
                                                data-bs-toggle="tooltip" title="{{ name|capitalize|striptags }}"
                                                aria-label="{{ label|capitalize|striptags }}">
                                                <i class="icon-{{ name|lower }} position-relative initial" aria-hidden="true"></i>
                                                <span class="visually-hidden">{{ label }}</span>
                                            </a>
                                        {%- endif -%}
                                    {%- endfor -%}
                                </nav>
                            </div>
                        {%- endif -%}
                    </div>
                </div>
                <div class="col-12 col-lg-8 ps-lg-5">
                    <div class="row g-4">
                        {%- if catalogMenus.animations is not empty
                            or catalogMenus.events is not empty
                            or catalogMenus.rentals is not empty
                            or catalogMenus.performances is not empty -%}
                            <div class="menus-left row">
                                {{ macro.menu(catalogMenus, 'animations', 'Nos best sellers'|trans) }}
                                {{ macro.menu(catalogMenus, 'events', 'Nos événements'|trans) }}
                                {{ macro.menu(catalogMenus, 'rentals', 'Nos locations'|trans) }}
                                {{ macro.menu(catalogMenus, 'performances', 'Nos spectacles'|trans) }}
                            </div>
                        {%- endif -%}
                        {%- set labels = agencies|map(a =>
                            '<a href="' ~ a.url ~ '" class="text-white-75 text-hover-primary fw-700">' ~ a.city ~ '</a> ' ~ a.zipcodeSmall
                        ) -%}
                        {%- set agency_list -%}
                            {%- for agency in labels -%}{{ agency|raw }}{% if not loop.last %}{% if loop.revindex0 == 1 %} {{ 'et'|trans }} {% else %}, {% endif %}{%- endif -%}{%- endfor -%}
                        {%- endset -%}
                        <div class="agencies-description-footer col-12 mt-0">
                            <hr class="sep my-4">
                            <p class="mb-0 small text-white-75 agencies-body">
                                {% trans with {'%agency_list%': agency_list|raw} %}
                                    Découvrez <strong class="text-white-75 fw-600">Up Animations</strong> expert en
                                    animations événementielles dans les villes d’%agency_list%. Nous saurons rendre vos événements originaux et conviviaux. Magiciens professionnels,
                                    nous nous déplaçons pour vos spectacles de magie et animations en tout genre&nbsp;!
                                {% endtrans %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="footer-bottom" class="bg-dark py-4 px-4 position-relative">
        {%- if mainMenus['footer'].arguments is defined and mainMenus['footer'].arguments -%}
            {% set menuArgs = mainMenus.footer.arguments|merge({information: information, logos: logos, axeptioActive: axeptioActive}) %}
            {% include mainMenus.footer.arguments.template with menuArgs only %}
        {%- endif -%}
        <div class="container px-0">
            <div class="pt-3 text-center small text-white-75 d-flex align-items-center justify-content-center gap-1">
                {{ "Copyright"|trans|raw }} {{ 'now'|date('Y') }} <span class="dashed text-white-75">-</span>
                <a href="{{ app.request.getSchemeAndHttpHost() }}" class="d-inline-block text-hover-primary" aria-label="{{ companyName|striptags }}">
                    <strong class="text-white-75">{{ companyName|striptags }}</strong>
                </a>
            </div>
        </div>
    </div>

</footer>
