{%- trans_default_domain 'front_default' -%}

{%- set seoActive = configuration.seoStatus -%}

{%- if seo -%}

    <title>
        {% if not seoActive %}[{{ 'SEO Désactivé'|trans|raw }}] {% endif-%}
        {% if seoTitle is defined and seoTitle %}{{ seoTitle|htmlEntities }}{% elseif seo.fullTitle is defined and seo.fullTitle %}{{ seo.fullTitle|htmlEntities }}{% endif %}
    </title>

    {%- if seo.description is defined and seo.description -%}
        <meta name="description" content="{{ seo.description|htmlEntities }}">
    {%- endif -%}

    {%- if seo.author is defined and seo.author -%}
        <meta name="author" content="{{ seo.author|striptags }}">
    {%- endif -%}

    {%- set seoRobots = seoRobots is defined ? seoRobots : (seo.index is defined ? seo.index : null) -%}
    {%- if seoRobots -%}
        {%- set isIndexable = 'noindex' not in seoRobots|lower -%}
        <meta name="robots" content="{{ isIndexable ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : seoRobots }}">
    {%- endif -%}

    {%- if seo.canonical is defined -%}
        <!-- Canonical -->
        <link rel="canonical" href="{{ seo.canonical }}">
    {%- endif -%}

    {%- if seo.localesAlternate is defined and seo.localesAlternate|length > 1 -%}
        <!-- Alternates links -->
        {%- for localeAlternate, alternate in seo.localesAlternate -%}
            <link rel="alternate" hreflang="{{ localeAlternate }}" href="{{ alternate }}">
        {%- endfor -%}
    {%- endif -%}

    <!-- Open Graph -->
    <meta property="og:site_name" content="{{ companyName|striptags }}">
    <meta property="og:locale" content="{{ app.request.locale }}">
    {%- if seo.ogFullTitle is defined -%}
        <meta property="og:title" content="{% if seo.ogFullTitle %}{{ seo.ogFullTitle|htmlEntities }}{% endif %}">
    {%- endif -%}
    {%- if seo.ogDescription is defined -%}
        <meta property="og:description" content="{{ seo.ogDescription|htmlEntities }}">
    {%- endif -%}
    {%- if seo.canonical is defined -%}
        <meta property="og:url" content="{{ seo.canonical }}">
    {%- endif -%}
    {%- set ogType = seo.ogType is defined and seo.ogType ? seo.ogType : 'website' -%}
    <meta property="og:type" content="{{ ogType }}">

    {%- if 'article' == ogType -%}
        {%- if seo.publishedDate is defined and seo.publishedDate -%}
            <meta property="article:published_time" content="{{ seo.publishedDate|date('c') }}">
        {%- endif -%}
        {%- if seo.updatedAt is defined and seo.updatedAt -%}
            <meta property="article:modified_time" content="{{ seo.updatedAt|date('c') }}">
        {%- endif -%}
        {%- if seo.author is defined and seo.author -%}
            <meta property="article:author" content="{{ seo.author|striptags }}">
        {%- endif -%}
    {%- endif -%}

    {%- set ogImage = seo.ogImage is defined ? seo.ogImage : null -%}
    {%- set ogImage = not ogImage and logos.share is defined and logos.share ? logos.share : ogImage -%}
    {%- set ogImage = ogImage and app.request.getSchemeAndHttpHost() not in ogImage ? app.request.getSchemeAndHttpHost()~ogImage : ogImage -%}

    {%- if ogImage -%}
        <meta property="og:image" content="{{ ogImage }}">
        <meta property="og:image:secure_url" content="{{ ogImage }}">
        <meta property="og:image:alt" content="{% if seo.ogFullTitle is defined and seo.ogFullTitle %}{{ seo.ogFullTitle|htmlEntities }}{% else %}{{ companyName|striptags }}{% endif %}">
    {%- endif -%}

    {# ---------- Twitter / X Cards ---------- #}
    {# Handle administrable par page (SEO > Twitter), avec repli automatique sur le réseau social X/Twitter du site. #}
    {%- set twitterHandle = seo.ogTwitterHandle is defined and seo.ogTwitterHandle ? seo.ogTwitterHandle : null -%}
    {%- if not twitterHandle and logos['social-networks'] is defined and logos['social-networks'].twitter is defined and logos['social-networks'].twitter.link is defined -%}
        {%- set twitterHandle = logos['social-networks'].twitter.link -%}
    {%- endif -%}
    {%- if twitterHandle -%}
        {# Normalisation : accepte "@compte", "compte" ou une URL X/Twitter. #}
        {%- set twitterHandle = twitterHandle|split('/')|last|trim('@ ') -%}
        {%- set twitterHandle = twitterHandle ? '@'~twitterHandle : null -%}
    {%- endif -%}
    {%- set twitterCard = seo.ogTwitterCard is defined and seo.ogTwitterCard ? seo.ogTwitterCard : (ogImage ? 'summary_large_image' : 'summary') -%}
    <meta name="twitter:card" content="{{ twitterCard }}">
    {%- if seo.ogFullTitle is defined and seo.ogFullTitle -%}
        <meta name="twitter:title" content="{{ seo.ogFullTitle|htmlEntities }}">
    {%- endif -%}
    {%- if seo.ogDescription is defined and seo.ogDescription -%}
        <meta name="twitter:description" content="{{ seo.ogDescription|htmlEntities }}">
    {%- endif -%}
    {%- if ogImage -%}
        <meta name="twitter:image" content="{{ ogImage }}">
    {%- endif -%}
    {%- if twitterHandle -%}
        <meta name="twitter:site" content="{{ twitterHandle }}">
        <meta name="twitter:creator" content="{{ twitterHandle }}">
    {%- endif -%}

{%- else -%}

    <!-- Metas -->
    <title>[{{ 'SEO Désactivé'|trans|striptags~'] '~companyName }}</title>
    <meta name="robots" content="noIndex">

{%- endif -%}