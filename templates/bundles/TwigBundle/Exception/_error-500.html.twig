    <body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="error-container">
                    <div class="error-code">500</div>
                    <h1 class="error-message">{{ "Oups! Une erreur interne est survenue."|trans({}, 'exception') }}</h1>
                    <p class="text-muted">
                        {{ "Désolé, une erreur inattendue s'est produite. Nos équipes ont été informées et travaillent à la résolution du problème."|trans({}, 'exception') }}
                    </p>
                    {% if is_debug|default(false) and exception.message is defined %}
                        <div class="debug-message">
                            <strong>Debug Info:</strong><br>
                            {{ exception.message }}
                        </div>
                    {% elseif is_granted('ROLE_INTERNAL') and exception.message is defined %}
                        <div class="debug-message">
                            <strong>Internal Error Info:</strong><br>
                            {{ exception.message }}
                        </div>
                    {% endif %}
                    <div class="mt-4">
                        <a href="{{ path('front_index') }}" class="btn btn-info text-white px-4">
                            {{ "Retourner à l'accueil"|trans({}, 'exception') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </body>
