<!DOCTYPE html>
<html>
<head>
    {% block meta %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {% endblock meta %}
    <title>{% block title %}{{ swagger_data.spec.info.title }}{% endblock title %}</title>
    <style>
        body {
            background: #0f1018;
            padding-top: 64px;
        }
        .api-topbar {
            align-items: center;
            background: rgba(10, 11, 19, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 12px 32px -24px rgba(0, 0, 0, 0.6);
            display: flex;
            font-family: 'Hankengrotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            gap: 1rem;
            height: 64px;
            justify-content: space-between;
            left: 0;
            padding: 0 24px;
            position: fixed;
            right: 0;
            top: 0;
            z-index: 50;
        }
        .api-topbar-brand {
            align-items: center;
            color: #f4f5fa;
            display: inline-flex;
            font-size: 15px;
            font-weight: 700;
            gap: .65rem;
            letter-spacing: -.005em;
            line-height: 1;
        }
        .api-topbar-brand::before {
            background: #ff7100;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(255, 113, 0, 0.18);
            content: '';
            display: inline-block;
            height: 8px;
            width: 8px;
        }
        .api-topbar-meta {
            align-items: center;
            color: rgba(244, 245, 250, 0.55);
            display: inline-flex;
            font-size: 11px;
            font-weight: 600;
            gap: .85rem;
            letter-spacing: .14em;
            line-height: 1;
            text-transform: uppercase;
        }
        .api-topbar-tag {
            background: rgba(255, 113, 0, 0.14);
            border: 1px solid rgba(255, 113, 0, 0.35);
            border-radius: 999px;
            color: #ff7100;
            padding: .4rem .75rem;
        }
        @media (max-width: 768px) {
            body { padding-top: 56px; }
            .api-topbar { height: 56px; padding: 0 16px; }
            .api-topbar-meta { display: none; }
            .api-topbar-brand { font-size: 13px; }
        }
        .api-back-link {
            align-items: center;
            background: rgba(15, 16, 24, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 999px;
            bottom: 24px;
            box-shadow: 0 24px 50px -28px rgba(0, 0, 0, 0.7);
            color: #f4f5fa;
            display: inline-flex;
            font-family: 'Hankengrotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            font-size: 13px;
            font-weight: 600;
            gap: .55rem;
            letter-spacing: .04em;
            line-height: 1;
            padding: .75rem 1.25rem .75rem 1rem;
            position: fixed;
            right: 24px;
            text-decoration: none;
            transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
            z-index: 110;
        }
        .api-back-link svg {
            color: #ff7100;
            transition: transform .2s ease, color .2s ease;
        }
        .api-back-link:hover,
        .api-back-link:focus {
            background: #ff7100;
            border-color: #ff7100;
            color: #ffffff;
            transform: translateY(-1px);
        }
        .api-back-link:hover svg,
        .api-back-link:focus svg {
            color: #ffffff;
            transform: translateX(-3px);
        }
        @media (max-width: 768px) {
            .api-back-link {
                bottom: 12px;
                right: 12px;
                padding: .6rem 1rem .6rem .85rem;
                font-size: 12px;
            }
        }
    </style>
</head>
<body>
    {% block top_bar %}
        <header class="api-topbar" role="banner">
            <span class="api-topbar-brand">{{ swagger_data.spec.info.title|default('API') }}</span>
            <span class="api-topbar-meta">
                <span class="api-topbar-tag">Admin dev</span>
                <span>v{{ swagger_data.spec.info.version|default('1.0.0') }}</span>
            </span>
        </header>
    {% endblock top_bar %}
    {% block back_link %}
        <a href="{{ path('admin_dashboard') }}" class="api-back-link" aria-label="Retour au tableau de bord">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5"/>
                <path d="M12 19l-7-7 7-7"/>
            </svg>
            <span>Retour au tableau de bord</span>
        </a>
    {% endblock back_link %}
    {% block swagger_ui %}
        <script id="api-reference" type="application/json">{{ swagger_data.spec|json_encode(65)|raw }}</script>
    {% endblock swagger_ui %}
    {% block swagger_initialization %}
        {% if scalar_config is not empty %}
        <script>
            document.getElementById('api-reference').dataset.configuration = JSON.stringify({{ scalar_config|json_encode(65)|raw }});
        </script>
        {% endif %}

        {# Auto CSRF: fetches a token on load and injects X-CSRF-Token on every same-origin mutating call (fetch + XHR).
           Re-fetches and retries once on 403 to handle session-side token expiration. #}
        <script>
            (function () {
                var csrfUrl = {{ path('admin_mail_tests_csrf')|json_encode|raw }};
                var csrfToken = null;
                var inflight = null;

                function fetchTokenSync() {
                    try {
                        var xhr = new XMLHttpRequest();
                        xhr.open('GET', csrfUrl, false);
                        xhr.withCredentials = true;
                        xhr.setRequestHeader('Accept', 'application/json');
                        xhr.send(null);
                        if (xhr.status >= 200 && xhr.status < 300) {
                            var data = JSON.parse(xhr.responseText || '{}');
                            csrfToken = data && data.csrf_token ? data.csrf_token : null;
                        }
                    } catch (e) {}
                    return csrfToken;
                }

                function fetchTokenAsync() {
                    if (inflight) return inflight;
                    var nativeFetch = window.__nativeFetch || window.fetch;
                    inflight = nativeFetch(csrfUrl, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : { csrf_token: '' }; })
                        .then(function (data) {
                            csrfToken = data && data.csrf_token ? data.csrf_token : null;
                            inflight = null;
                            return csrfToken;
                        })
                        .catch(function () { inflight = null; return null; });
                    return inflight;
                }

                function isMutating(method) {
                    if (!method) return false;
                    var m = String(method).toUpperCase();
                    return m === 'POST' || m === 'PUT' || m === 'PATCH' || m === 'DELETE';
                }

                function isSameOrigin(url) {
                    try {
                        var u = new URL(url, window.location.href);
                        return u.origin === window.location.origin;
                    } catch (e) { return false; }
                }

                function isCsrfEndpoint(url) {
                    if (!url) return false;
                    try {
                        var u = new URL(url, window.location.href);
                        return u.pathname === new URL(csrfUrl, window.location.href).pathname;
                    } catch (e) { return false; }
                }

                function injectHeader(init, token) {
                    init = init || {};
                    var headers = init.headers;
                    if (headers instanceof Headers) {
                        headers.set('X-CSRF-Token', token);
                    } else if (Array.isArray(headers)) {
                        headers = headers.filter(function (h) { return String(h[0]).toLowerCase() !== 'x-csrf-token'; });
                        headers.push(['X-CSRF-Token', token]);
                        init.headers = headers;
                    } else {
                        init.headers = Object.assign({}, headers || {}, { 'X-CSRF-Token': token });
                    }
                    if (!init.credentials) init.credentials = 'same-origin';
                    return init;
                }

                /* ---- fetch wrapper ---- */
                var nativeFetch = window.fetch.bind(window);
                window.__nativeFetch = nativeFetch;
                window.fetch = function (input, init) {
                    var url = typeof input === 'string' ? input : (input && input.url);
                    var method = (init && init.method) || (input && input.method) || 'GET';
                    if (!isSameOrigin(url) || !isMutating(method) || isCsrfEndpoint(url)) {
                        return nativeFetch(input, init);
                    }
                    var run = function (token) {
                        var nextInit = injectHeader(init || {}, token || '');
                        if (typeof input === 'string') {
                            return nativeFetch(input, nextInit);
                        }
                        return nativeFetch(new Request(input, nextInit));
                    };
                    var promise = csrfToken ? Promise.resolve(csrfToken) : fetchTokenAsync();
                    return promise.then(run).then(function (response) {
                        if (response && response.status === 403) {
                            return fetchTokenAsync().then(function (fresh) {
                                if (!fresh) return response;
                                return run(fresh);
                            });
                        }
                        return response;
                    });
                };

                /* ---- XHR wrapper ---- */
                var XHROpen = XMLHttpRequest.prototype.open;
                var XHRSend = XMLHttpRequest.prototype.send;
                XMLHttpRequest.prototype.open = function (method, url) {
                    this.__csrfMethod = method;
                    this.__csrfUrl = url;
                    return XHROpen.apply(this, arguments);
                };
                XMLHttpRequest.prototype.send = function (body) {
                    var self = this;
                    if (isMutating(self.__csrfMethod) && isSameOrigin(self.__csrfUrl) && !isCsrfEndpoint(self.__csrfUrl)) {
                        if (!csrfToken) fetchTokenSync();
                        if (csrfToken) {
                            try { self.setRequestHeader('X-CSRF-Token', csrfToken); } catch (e) {}
                        }
                        try { self.withCredentials = true; } catch (e) {}
                    }
                    return XHRSend.apply(self, arguments);
                };

                // Preload the token so the first call is instant.
                fetchTokenAsync();
            })();
        </script>

        {{ nelmioAsset(assets_mode, 'scalar/scalar.standalone.js') }}

        {# When the API client modal opens, open its internal sidebar automatically so the request fields are visible.
           We wait for the toggle's aria-pressed/aria-expanded attribute to be set, then click if closed. #}
        <script>
            (function () {
                var handled = new WeakSet();
                function isClosed(btn) {
                    var pressed = btn.getAttribute('aria-pressed');
                    var expanded = btn.getAttribute('aria-expanded');
                    if (pressed === null && expanded === null) return null;
                    if (pressed === 'false' || expanded === 'false') return true;
                    return false;
                }
                function maybeOpen() {
                    document.querySelectorAll('.scalar-sidebar-toggle').forEach(function (btn) {
                        if (handled.has(btn)) return;
                        var closed = isClosed(btn);
                        if (closed === null) return; // attribute not set yet, retry on next mutation
                        if (closed) {
                            try { btn.click(); } catch (e) {}
                        }
                        handled.add(btn);
                    });
                }
                var mo = new MutationObserver(function () { maybeOpen(); });
                mo.observe(document.body, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['aria-pressed', 'aria-expanded']
                });
                maybeOpen();
            })();
        </script>
    {% endblock swagger_initialization %}
</body>
</html>
