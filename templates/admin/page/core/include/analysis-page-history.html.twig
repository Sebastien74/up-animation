{%- trans_default_domain 'admin' -%}

{#
   Shared snapshot-history table for the analysis surfaces (detail page + layout modal).
   Expects `history` (a list of PageAnalysis snapshots) and an optional `titleTag`.
#}

{%- set titleTag = titleTag|default('h2') -%}

{%- if history is defined and history|length > 1 -%}
    <section class="pa-group">
        <header class="pa-group-head">
            <{{ titleTag }} class="pa-group-title">{{ "Historique"|trans|raw }}</{{ titleTag }}>
            <span class="pa-group-count">{{ history|length }} {{ "relevés"|trans|raw }}</span>
        </header>
        <div class="table-responsive app-table">
            <table class="table table-striped responsive-cards mb-0">
                <thead>
                    <tr>
                        <th class="align-middle px-4">{{ "Date"|trans }}</th>
                        <th class="align-middle text-center px-4">{{ "Statut"|trans }}</th>
                        <th class="align-middle text-center px-4">{{ "Indice"|trans }}</th>
                        <th class="align-middle text-center px-4">{{ "Poids"|trans }}</th>
                        <th class="align-middle text-center px-4">{{ "Problèmes"|trans }}</th>
                        <th class="align-middle px-4">{{ "Source"|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {%- for snap in history -%}
                        {%- set sScore = snap.score -%}
                        {%- set sState = sScore is null ? 'is-none' : (sScore >= 90 ? 'is-good' : (sScore >= 60 ? 'is-warn' : 'is-bad')) -%}
                        {%- set sHttpState = snap.httpStatus is null ? 'is-none' : (snap.httpStatus >= 400 ? 'is-bad' : (snap.httpStatus >= 300 ? 'is-warn' : 'is-good')) -%}
                        <tr>
                            <td class="align-middle px-4" data-label="{{ "Date"|trans|striptags }}">
                                <span class="text-nowrap">{{ snap.createdAt ? snap.createdAt|date('d/m/Y H:i') : '-' }}</span>
                                {%- if loop.first %} <span class="pa-history-now">{{ "actuel"|trans|raw }}</span>{% endif -%}
                            </td>
                            <td class="align-middle text-center px-4" data-label="{{ "Statut"|trans|striptags }}">
                                <span class="score-pill {{ sHttpState }}">{{ snap.httpStatus is null ? '-' : snap.httpStatus }}</span>
                            </td>
                            <td class="align-middle text-center px-4" data-label="{{ "Indice"|trans|striptags }}">
                                <span class="score-pill {{ sState }}">{{ sScore is null ? '-' : sScore }}</span>
                            </td>
                            <td class="align-middle text-center px-4" data-label="{{ "Poids"|trans|striptags }}">{{ snap.htmlKb }} Ko</td>
                            <td class="align-middle text-center px-4" data-label="{{ "Problèmes"|trans|striptags }}">{{ snap.severityHigh + snap.severityMedium + snap.severityLow }}</td>
                            <td class="align-middle px-4" data-label="{{ "Source"|trans|striptags }}">
                                <span class="pa-type-pill">{{ snap.source == 'cron' ? "Automatique"|trans : "Manuel"|trans }}</span>
                            </td>
                        </tr>
                    {%- endfor -%}
                </tbody>
            </table>
        </div>
    </section>
{%- endif -%}
