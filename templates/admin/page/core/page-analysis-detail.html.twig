{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set interfaceLabels = {page: "Pages"|trans, newscast: "Actualités"|trans, catalogproduct: "Produits"|trans} -%}
{%- set typeLabel = interfaceLabels[interface]|default(interface) -%}
{%- set pageCode = url.code ?: '/' -%}

{%- set pageIcon = 'rocket' -%}
{%- set pageTitle = "Analyse"|trans ~ ' · /' ~ pageCode -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-dashboard', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-page-analysis', null, 'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    <div id="page-analysis-detail" class="pt-2 pb-5"
         data-run-url="{{ runUrl }}">

        <div class="perf-inspector-head pa-detail-head mb-4">
            <div class="pa-detail-headline">
                <span class="pa-type-pill">{{ typeLabel }}</span>
                <h1 class="perf-inspector-title mt-2">{{ name is defined and name ? name : '/'~pageCode }}</h1>
                {%- if name is defined and name -%}
                    <a href="{{ previewUrl }}" target="_blank" rel="noopener" class="pa-page-url d-inline-block mt-1">/{{ pageCode }}</a>
                {%- endif -%}
                <p class="perf-inspector-desc">
                    {{ "Détail de la dernière analyse en preview. Indice indicatif, ce n'est pas une mesure Lighthouse."|trans|raw }}
                </p>
            </div>
            <div class="pa-detail-actions d-flex align-items-center gap-2">
                <a href="{{ previewUrl }}" target="_blank" rel="noopener" class="btn-app small d-inline-flex align-items-center gap-2">
                    <i class="icm-external-link-alt"></i><span>{{ "Ouvrir la page"|trans|striptags }}</span>
                </a>
                <button type="button" class="pa-detail-run btn-app small d-inline-flex align-items-center gap-2">
                    <i class="icm-rocket"></i><span>{{ "Relancer l'analyse"|trans|striptags }}</span>
                </button>
                {%- if latest is not null -%}
                    <button type="button" class="btn-app danger small d-inline-flex align-items-center gap-2"
                            data-bs-toggle="modal" data-bs-target="#pa-delete-modal"
                            data-pa-action="{{ path('admin_page_analysis_clear_page', {website: websiteId(), url: url.id}) }}"
                            data-pa-scope="page" data-pa-label="/{{ pageCode }}">
                        <i class="icm-trash"></i><span>{{ "Supprimer les données"|trans|striptags }}</span>
                    </button>
                {%- endif -%}
            </div>
        </div>

        {%- if latest is null -%}
            <div class="table-responsive app-table">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <td class="px-4">
                                <div class="py-3 d-flex flex-column align-items-center justify-content-center gap-2 text-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="btn-icon info icm-info"></i>{{ "Cette page n'a pas encore été analysée."|trans|raw }}
                                    </div>
                                    <p class="perf-inspector-desc mb-0">
                                        {{ "Lancez une première analyse pour visualiser les problèmes détectés."|trans|raw }}
                                    </p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {%- else -%}
            {%- set report = latest.report -%}
            {%- set meta = report.meta|default({}) -%}
            {%- set score = latest.score -%}
            {%- set httpStatus = latest.httpStatus -%}
            {%- set isHttpError = httpStatus is not null and httpStatus >= 400 -%}
            {%- set scoreState = score is null ? 'is-none' : (score >= 90 ? 'is-good' : (score >= 60 ? 'is-warn' : 'is-bad')) -%}

            <div class="perf-inspector-summary mb-4">
                <div class="perf-summary-tile pa-score-tile">
                    <span class="tile-label">{{ "Indice"|trans|raw }}</span>
                    {%- if isHttpError -%}
                        <span class="score-pill score-pill-lg is-bad" title="{{ "Erreur HTTP"|trans|striptags }} {{ httpStatus }}">{{ "Err"|trans }} {{ httpStatus }}</span>
                    {%- else -%}
                        <span class="score-pill score-pill-lg {{ scoreState }}">{{ score is null ? '—' : score }}</span>
                    {%- endif -%}
                </div>
                <div class="perf-summary-tile">
                    <span class="tile-label">{{ "Problèmes"|trans|raw }}</span>
                    <span class="tile-value">{{ latest.severityHigh + latest.severityMedium + latest.severityLow }}</span>
                    <span class="tile-sub">{{ latest.severityHigh }} {{ "critiques"|trans|raw }} · {{ latest.severityMedium }} {{ "à surveiller"|trans|raw }} · {{ latest.severityLow }} {{ "mineurs"|trans|raw }}</span>
                </div>
                <div class="perf-summary-tile">
                    <span class="tile-label">{{ "Poids HTML"|trans|raw }}</span>
                    <span class="tile-value">{{ latest.htmlKb }} Ko</span>
                </div>
                <div class="perf-summary-tile">
                    <span class="tile-label">{{ "Requêtes"|trans|raw }}</span>
                    <span class="tile-value">{{ latest.requests }}</span>
                </div>
                <div class="perf-summary-tile">
                    <span class="tile-label">{{ "DOM"|trans|raw }}</span>
                    <span class="tile-value">{{ latest.domCount }}</span>
                    <span class="tile-sub">{{ latest.imagesCount }} {{ "images"|trans|raw }}</span>
                </div>
                <div class="perf-summary-tile">
                    <span class="tile-label">{{ "Rendu"|trans|raw }}</span>
                    <span class="tile-value">{{ latest.renderMs is not null ? latest.renderMs ~ ' ms' : '—' }}</span>
                </div>
            </div>

            {%- if latest.createdAt -%}
                <p class="perf-inspector-desc mb-4">{{ "Dernière analyse :"|trans }} {{ latest.createdAt|date('d/m/Y H:i') }}</p>
            {%- endif -%}

            {%- include 'admin/page/core/include/page-analysis-findings.html.twig' with {groups: report.groups} only -%}

            <div class="mt-4">
                {%- include 'admin/page/core/include/page-analysis-history.html.twig' with {history: history} only -%}
            </div>
        {%- endif -%}

    </div>

    {%- if latest is not null -%}
        {%- include 'admin/page/core/include/page-analysis-delete-modal.html.twig' -%}
    {%- endif -%}

{%- endblock -%}
