{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageIcon = 'tachometer-alt' -%}
{%- set pageTitle = "Tableau de bord"|trans -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-dashboard', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-dashboard', null,  'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {%- set isInternal = granted('ROLE_INTERNAL') -%}
    {%- set hasSeo = isInternal and noSeoCounts is defined and noSeoCounts['total'] is defined -%}
    {%- set seoCount = hasSeo ? noSeoCounts['total'] : 0 -%}
    {%- set hasNotFound = isInternal and notFoundUrls is defined -%}
    {%- set notFoundCount = notFoundCount is defined ? notFoundCount : 0 -%}
    {%- set hasMailStats = mailStats is defined and mailStats -%}
    {%- set hasPerf = isInternal and performanceStats is defined and performanceStats -%}
    {%- set hasFeeds = (hasInstagramFeed is defined and hasInstagramFeed) or (hasTikTokFeed is defined and hasTikTokFeed) -%}
    {%- set hasSearchValues = 'search'|moduleActive(configuration) and searchValues.count > 0 and granted('ROLE_SEARCH_ENGINE') -%}
    {%- set hasStrip = hasSeo or hasNotFound or hasMailStats or hasPerf or hasSearchValues -%}
    {%- set userLocale = app.request.locale -%}
    {%- set today = 'now'|date('Y-m-d H:i:s') -%}
    {%- set hourNow = 'now'|date('H')|number_format(0) -%}
    {%- set greetingKey = (hourNow >= 5 and hourNow < 18) ? "Bonjour" : "Bonsoir" -%}
    {%- set userFirstName = app.user.firstName is defined and app.user.firstName ? app.user.firstName : null -%}

    <div id="dashboard" class="pb-5">

        {#-- 1 — Hero (editorial split: greeting block / meta column) --#}
        <section class="dashboard-hero reveal">
            <div class="hero-grid">
                <h1 class="hero-title mb-0">
                    {{ greetingKey|trans }}{% if userFirstName %}, <span class="hero-name">{{ userFirstName }}</span>{% endif %}<span class="hero-mark">.</span>
                </h1>
                <div class="hero-meta">
                    <span class="hero-date">{{ today|format_datetime(pattern='cccc d MMMM yyyy', locale=userLocale)|capitalize }}</span>
                    {%- if app.user.lastLogin is defined and app.user.lastLogin -%}
                        <span class="hero-last-login">
                            <i class="icm-clock"></i>
                            <span>{{ "Dernière connexion"|trans|raw }} {{ app.user.lastLogin|ago }}</span>
                        </span>
                    {%- endif -%}
                </div>
            </div>
        </section>

        {#-- 2 — KPI strip (horizontal, compact) --#}
        {%- if hasStrip -%}
            <section class="dashboard-strip reveal">
                <ul class="kpi-grid reset">
                    {%- if hasSeo -%}
                        <li class="kpi-tile {{ seoCount > 0 ? 'is-warning' : 'is-clean' }}">
                            <a href="#kpi-target-seo" class="kpi-link">
                                <span class="kpi-label">{{ "SEO manquant"|trans|raw }}</span>
                                <span class="kpi-value">{{ seoCount }}</span>
                                <span class="kpi-unit">{{ seoCount > 1 ? "balises"|trans|raw : "balise"|trans|raw }}</span>
                            </a>
                        </li>
                    {%- endif -%}

                    {%- if hasNotFound -%}
                        <li class="kpi-tile {{ notFoundCount > 0 ? 'is-alert' : 'is-clean' }}">
                            <a href="#kpi-target-notfound" class="kpi-link">
                                <span class="kpi-label">{{ "Erreurs 404"|trans|raw }}</span>
                                <span class="kpi-value">{{ notFoundCount }}</span>
                                <span class="kpi-unit">{{ notFoundCount > 1 ? "URLs"|trans|raw : "URL"|trans|raw }}</span>
                            </a>
                        </li>
                    {%- endif -%}

                    {%- if hasMailStats -%}
                        <li class="kpi-tile">
                            <a href="#kpi-target-mail" class="kpi-link">
                                <span class="kpi-label">{{ "Mails 24 h"|trans|raw }}</span>
                                <span class="kpi-value">{{ mailStats.last24h }}</span>
                                <span class="kpi-unit">{{ mailStats.last24h > 1 ? "envois"|trans|raw : "envoi"|trans|raw }}</span>
                            </a>
                        </li>
                    {%- endif -%}

                    {%- if hasPerf -%}
                        {%- set slowTotal = performanceStats.recent.front.count + performanceStats.recent.admin.count -%}
                        <li class="kpi-tile {{ slowTotal > 0 ? 'is-warning' : 'is-clean' }}">
                            <a href="#kpi-target-perf" class="kpi-link">
                                <span class="kpi-label">{{ "Requêtes lentes"|trans|raw }}</span>
                                <span class="kpi-value">{{ slowTotal }}</span>
                                <span class="kpi-unit">sur {{ performanceStats.window_hours }} h</span>
                            </a>
                        </li>
                    {%- endif -%}

                    {%- if hasSearchValues -%}
                        <li class="kpi-tile">
                            <a href="#stats-search" class="kpi-link">
                                <span class="kpi-label">{{ "Recherches"|trans|raw }}</span>
                                <span class="kpi-value">{{ searchValues.count }}</span>
                                <span class="kpi-unit">{{ searchValues.count > 1 ? "termes"|trans|raw : "terme"|trans|raw }}</span>
                            </a>
                        </li>
                    {%- endif -%}
                </ul>
            </section>
        {%- endif -%}

        {#-- 2 bis — Audience snapshot (7 days) --#}
        {%- if analyticsStats is defined and analyticsStats -%}
            <section class="dashboard-quick reveal">
                <header class="zone-head">
                    <h2 class="zone-title">{{ "Audience"|trans|raw }}</h2>
                    <span class="zone-aside">
                        {{ "Les 7 derniers jours"|trans|raw }}
                        &middot;
                        <a href="{{ path('admin_stats_view', {website: websiteId}) }}" class="d-inline-flex align-items-center gap-1">
                            {{ "Voir toutes les statistiques"|trans|raw }}<i class="icm-arrow-right"></i>
                        </a>
                    </span>
                </header>
                <ul class="kpi-grid reset">
                    <li class="kpi-tile is-clean">
                        <a href="{{ path('admin_stats_view', {website: websiteId}) }}" class="kpi-link">
                            <span class="kpi-label">{{ "Visiteurs uniques"|trans|raw }}</span>
                            <span class="kpi-value">{{ analyticsStats.totals.visitors|number_format(0, ',', ' ') }}</span>
                            <span class="kpi-unit">{{ "sur 7 jours"|trans|raw }}</span>
                        </a>
                    </li>
                    <li class="kpi-tile is-clean">
                        <a href="{{ path('admin_stats_view', {website: websiteId}) }}" class="kpi-link">
                            <span class="kpi-label">{{ "Sessions"|trans|raw }}</span>
                            <span class="kpi-value">{{ analyticsStats.totals.sessions|number_format(0, ',', ' ') }}</span>
                            <span class="kpi-unit">{{ "sur 7 jours"|trans|raw }}</span>
                        </a>
                    </li>
                    <li class="kpi-tile is-clean">
                        <a href="{{ path('admin_stats_view', {website: websiteId}) }}" class="kpi-link">
                            <span class="kpi-label">{{ "Pages vues"|trans|raw }}</span>
                            <span class="kpi-value">{{ analyticsStats.totals.pageviews|number_format(0, ',', ' ') }}</span>
                            <span class="kpi-unit">{{ "sur 7 jours"|trans|raw }}</span>
                        </a>
                    </li>
                </ul>
            </section>
        {%- endif -%}

        {#-- 3 — Quick links (modules) --#}
        <section class="dashboard-quick reveal">
            <header class="zone-head">
                <h2 class="zone-title">{{ "Accès rapides"|trans|raw }}</h2>
                <span class="zone-aside">{{ "Vos modules"|trans|raw }}</span>
            </header>

            <ul class="quick-grid reset">
                {%- if 'pages'|moduleActive(configuration) -%}
                    <li>
                        <a href="{{ path('admin_page_tree', {website: websiteId}) }}" class="quick-tile">
                            <span class="quick-icon"><i class="icm-file-alt"></i></span>
                            <span class="quick-title">{{ "Pages"|trans|raw }}</span>
                            <span class="quick-desc">{{ "Arborescence"|trans|raw }}</span>
                        </a>
                    </li>
                {%- endif -%}
                {%- if 'medias'|moduleActive(configuration) -%}
                    <li>
                        <a href="{{ path('admin_medias_library', {website: websiteId}) }}" class="quick-tile">
                            <span class="quick-icon"><i class="icm-images"></i></span>
                            <span class="quick-title">{{ "Médias"|trans|raw }}</span>
                            <span class="quick-desc">{{ "Bibliothèque"|trans|raw }}</span>
                        </a>
                    </li>
                {%- endif -%}
                {%- if 'newscast'|moduleActive(configuration) -%}
                    <li>
                        <a href="{{ path('admin_newscast_index', {website: websiteId}) }}" class="quick-tile">
                            <span class="quick-icon"><i class="icm-newspaper"></i></span>
                            <span class="quick-title">{{ "Actualités"|trans|raw }}</span>
                            <span class="quick-desc">{{ "Publications"|trans|raw }}</span>
                        </a>
                    </li>
                {%- endif -%}
                {%- if 'catalog'|moduleActive(configuration) -%}
                    <li>
                        <a href="{{ path('admin_catalog_index', {website: websiteId}) }}" class="quick-tile">
                            <span class="quick-icon"><i class="icm-store"></i></span>
                            <span class="quick-title">{{ "Catalogue"|trans|raw }}</span>
                            <span class="quick-desc">{{ "Produits"|trans|raw }}</span>
                        </a>
                    </li>
                {%- endif -%}
                {%- if 'form'|moduleActive(configuration) -%}
                    <li>
                        <a href="{{ path('admin_form_index', {website: websiteId}) }}" class="quick-tile">
                            <span class="quick-icon"><i class="icm-paper-plane"></i></span>
                            <span class="quick-title">{{ "Formulaires"|trans|raw }}</span>
                            <span class="quick-desc">{{ "Soumissions"|trans|raw }}</span>
                        </a>
                    </li>
                {%- endif -%}
                {%- if 'slider'|moduleActive(configuration) -%}
                    <li>
                        <a href="{{ path('admin_slider_index', {website: websiteId}) }}" class="quick-tile">
                            <span class="quick-icon"><i class="icm-sliders-h"></i></span>
                            <span class="quick-title">{{ "Sliders"|trans|raw }}</span>
                            <span class="quick-desc">{{ "Carrousels"|trans|raw }}</span>
                        </a>
                    </li>
                {%- endif -%}
            </ul>
        </section>

        {#-- 4 — Activity (mail + perf charts side by side) --#}
        {%- if hasMailStats or hasPerf -%}
            <section class="dashboard-activity reveal">
                <header class="zone-head">
                    <h2 class="zone-title">{{ "Activité récente"|trans|raw }}</h2>
                    <span class="zone-aside">
                        {%- if hasPerf -%}
                            {{ "Mails 30 j · perf"|trans|raw }} {{ performanceStats.window_hours }} h
                        {%- else -%}
                            {{ "30 derniers jours"|trans|raw }}
                        {%- endif -%}
                    </span>
                </header>

                <div class="activity-grid">

                    {%- if hasMailStats -%}
                        {%- set mailCounts = mailStats.counts -%}
                        {%- set mailDaily = mailStats.daily -%}
                        {%- set mailTotal = mailCounts.success + mailCounts.failed -%}
                        {%- set mailDailyMax = 0 -%}
                        {%- for day, row in mailDaily -%}
                            {%- if row.total > mailDailyMax -%}{%- set mailDailyMax = row.total -%}{%- endif -%}
                        {%- endfor -%}

                        <article id="kpi-target-mail" class="activity-card">
                            <header class="activity-card-head">
                                <h3 class="activity-card-title">{{ "Mails envoyés"|trans|raw }}</h3>
                                <ul class="activity-meta reset">
                                    <li>
                                        <span class="meta-swatch is-success" aria-hidden="true"></span>
                                        <span class="meta-value">{{ mailCounts.success }}</span>
                                        <span class="meta-label">{{ "réussis"|trans|raw }}</span>
                                    </li>
                                    <li>
                                        <span class="meta-swatch is-failed" aria-hidden="true"></span>
                                        <span class="meta-value">{{ mailCounts.failed }}</span>
                                        <span class="meta-label">{{ "échecs"|trans|raw }}</span>
                                    </li>
                                </ul>
                            </header>

                            <div class="chart-bars" role="img" aria-label="{{ "Histogramme des envois par jour"|trans|striptags }}">
                                {%- for day, row in mailDaily -%}
                                    {%- set successHeight = mailDailyMax > 0 ? (row.success / mailDailyMax * 100)|round : 0 -%}
                                    {%- set failedHeight = mailDailyMax > 0 ? (row.failed / mailDailyMax * 100)|round : 0 -%}
                                    {%- set dayLabel = day|slice(8, 2) -%}
                                    <div class="chart-bar-col" title="{{ day }} - {{ row.total }}">
                                        <div class="chart-bar-stack">
                                            <span class="chart-bar is-success" style="height: {{ successHeight }}%"></span>
                                            {%- if row.failed > 0 -%}
                                                <span class="chart-bar is-failed" style="height: {{ failedHeight }}%"></span>
                                            {%- endif -%}
                                        </div>
                                        <span class="chart-bar-label">{{ dayLabel }}</span>
                                    </div>
                                {%- endfor -%}
                            </div>

                            <footer class="activity-card-foot">
                                <span class="activity-card-summary">
                                    {{ mailTotal }} {{ mailTotal > 1 ? "envois enregistrés"|trans|raw : "envoi enregistré"|trans|raw }}
                                </span>
                                <a href="{{ path('admin_maillog_index', {website: websiteId()}) }}" class="activity-card-link">
                                    {{ "Journal"|trans|raw }} <i class="icm-arrow-right"></i>
                                </a>
                            </footer>
                        </article>
                    {%- endif -%}

                    {%- if hasPerf -%}
                        {%- set perf = performanceStats -%}
                        {%- set perfHourlyMax = 0 -%}
                        {%- for slot, counts in perf.hourly -%}
                            {%- set hSum = counts.front + counts.admin -%}
                            {%- if hSum > perfHourlyMax -%}{%- set perfHourlyMax = hSum -%}{%- endif -%}
                        {%- endfor -%}
                        {%- set frontTotal = perf.recent.front.count -%}
                        {%- set adminTotal = perf.recent.admin.count -%}
                        {%- set perfTotal = frontTotal + adminTotal -%}

                        <article id="kpi-target-perf" class="activity-card">
                            <header class="activity-card-head">
                                <h3 class="activity-card-title">{{ "Requêtes lentes"|trans|raw }}</h3>
                                <ul class="activity-meta reset">
                                    <li>
                                        <span class="meta-swatch is-front" aria-hidden="true"></span>
                                        <span class="meta-value">{{ frontTotal }}</span>
                                        <span class="meta-label">{{ "front"|trans|raw }}</span>
                                    </li>
                                    <li>
                                        <span class="meta-swatch is-admin" aria-hidden="true"></span>
                                        <span class="meta-value">{{ adminTotal }}</span>
                                        <span class="meta-label">{{ "back"|trans|raw }}</span>
                                    </li>
                                </ul>
                            </header>

                            <div class="chart-bars" role="img" aria-label="{{ "Histogramme des requêtes lentes par heure"|trans|striptags }}">
                                {%- for slot, counts in perf.hourly -%}
                                    {%- set hour = slot|split(' ')[1]|slice(0, 2) -%}
                                    {%- set frontH = perfHourlyMax > 0 ? (counts.front / perfHourlyMax * 100)|round : 0 -%}
                                    {%- set adminH = perfHourlyMax > 0 ? (counts.admin / perfHourlyMax * 100)|round : 0 -%}
                                    <div class="chart-bar-col" title="{{ slot }} - front {{ counts.front }} / back {{ counts.admin }}">
                                        <div class="chart-bar-stack">
                                            <span class="chart-bar is-front" style="height: {{ frontH }}%"></span>
                                            {%- if counts.admin > 0 -%}
                                                <span class="chart-bar is-admin" style="height: {{ adminH }}%"></span>
                                            {%- endif -%}
                                        </div>
                                        <span class="chart-bar-label">{{ hour }}</span>
                                    </div>
                                {%- endfor -%}
                            </div>

                            <footer class="activity-card-foot">
                                <span class="activity-card-summary">
                                    {{ "Avg"|trans|raw }} {{ perf.recent.front.avg_duration_ms }} ms · {{ "max"|trans|raw }} {{ perf.recent.front.max_duration_ms }} ms
                                </span>
                                <a href="{{ path('admin_performance_inspector', {area: 'front', website: websiteId()}) }}" class="activity-card-link">
                                    {{ "Inspecter"|trans|raw }} <i class="icm-arrow-right"></i>
                                </a>
                            </footer>
                        </article>
                    {%- endif -%}

                </div>
            </section>
        {%- endif -%}

        {#-- 5 — Performance details (buckets + top URLs) --#}
        {%- if hasPerf -%}
            {%- set perfBucketMax = 0 -%}
            {%- for label, counts in performanceStats.buckets -%}
                {%- set bSum = counts.front + counts.admin -%}
                {%- if bSum > perfBucketMax -%}{%- set perfBucketMax = bSum -%}{%- endif -%}
            {%- endfor -%}
            {%- set frontRoutes = performanceStats.top_routes.front -%}
            {%- set adminRoutes = performanceStats.top_routes.admin -%}
            {%- set mergedRoutes = frontRoutes|merge(adminRoutes) -%}

            <section class="dashboard-details reveal">
                <header class="zone-head">
                    <h2 class="zone-title">{{ "Performance détaillée"|trans|raw }}</h2>
                    {%- if performanceStats.last_seen_at -%}
                        <span class="zone-aside">{{ "dernière mesure"|trans|raw }} {{ performanceStats.last_seen_at }}</span>
                    {%- endif -%}
                </header>

                <div class="details-grid">

                    <article class="details-card">
                        <h3 class="details-card-title">{{ "Distribution des durées"|trans|raw }}</h3>
                        <ul class="bucket-list reset">
                            {%- for label, counts in performanceStats.buckets -%}
                                {%- set value = counts.front + counts.admin -%}
                                {%- set width = perfBucketMax > 0 ? (value / perfBucketMax * 100)|round : 0 -%}
                                {%- set severity = loop.index == 1 ? 'low'
                                    : (loop.index == 2 ? 'medium'
                                    : (loop.index == 3 ? 'high'
                                    : (loop.index == 4 ? 'critical' : 'extreme'))) -%}
                                <li class="bucket-row">
                                    <span class="bucket-label">{{ label }}</span>
                                    <span class="bucket-bar" aria-hidden="true">
                                        <span class="bucket-fill severity-{{ severity }}" style="width: {{ width }}%"></span>
                                    </span>
                                    <span class="bucket-count">{{ value }}</span>
                                </li>
                            {%- endfor -%}
                        </ul>
                    </article>

                    <article class="details-card">
                        <h3 class="details-card-title">{{ "Top URLs lentes"|trans|raw }}</h3>
                        {%- if mergedRoutes is empty -%}
                            <p class="details-empty">{{ "Aucune requête lente"|trans|raw }}</p>
                        {%- else -%}
                            <ol class="routes-list reset">
                                {%- for uri, count in mergedRoutes|slice(0, 8) -%}
                                    <li class="routes-row">
                                        <span class="routes-name" title="{{ uri }}">{{ uri }}</span>
                                        <span class="routes-count">{{ count }}</span>
                                    </li>
                                {%- endfor -%}
                            </ol>
                        {%- endif -%}
                    </article>

                </div>
            </section>
        {%- endif -%}

        {#-- 6 — Attention (SEO + 404 alerts, side by side) --#}
        {%- if hasSeo or hasNotFound -%}
            <section class="dashboard-attention reveal">
                <header class="zone-head">
                    <h2 class="zone-title">{{ "À traiter"|trans|raw }}</h2>
                </header>

                <div class="attention-grid">

                    {%- if hasSeo -%}
                        <article id="kpi-target-seo" class="attention-card {{ seoCount > 0 ? 'is-warning' : 'is-clean' }}">
                            <header class="attention-head">
                                <span class="attention-tag">{{ "SEO"|trans|raw }}</span>
                                <span class="attention-count">{{ seoCount }}</span>
                                <span class="attention-unit">{{ seoCount > 1 ? "balises"|trans|raw : "balise"|trans|raw }}</span>
                            </header>
                            <p class="attention-desc">
                                {%- if seoCount > 0 -%}
                                    {{ "Renseignez les balises manquantes pour améliorer la visibilité sur les moteurs de recherche."|trans|raw }}
                                {%- else -%}
                                    {{ "Toutes les balises SEO sont renseignées."|trans|raw }}
                                {%- endif -%}
                            </p>

                            {%- if allLocales|length > 1 and seoCount > 0 -%}
                                <ul class="locales-bars reset">
                                    {%- for locale, count in noSeoCounts|unset('total') -%}
                                        {%- if count >= 0 -%}
                                            <li class="locale-row">
                                                <span class="locale-flag">
                                                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                                                         data-src="{{ asset('/medias/icons/flags/'~locale~'.svg') }}"
                                                         width="14" height="14"
                                                         alt="{{ languageName(locale, userLocale)|striptags }}"
                                                         class="img-fluid fit-cover lazy-load">
                                                </span>
                                                <span class="locale-name">{{ languageName(locale, userLocale) }}</span>
                                                <span class="locale-bar" aria-hidden="true">
                                                    <span class="locale-bar-fill" style="width: {{ seoCount > 0 ? (count / seoCount * 100)|round : 0 }}%"></span>
                                                </span>
                                                <span class="locale-count">{{ count }}</span>
                                            </li>
                                        {%- endif -%}
                                    {%- endfor -%}
                                </ul>
                            {%- endif -%}

                            <a href="{{ path('admin_seo_edit', {website: websiteId(), entitylocale: defaultLocale}) }}" class="attention-cta">
                                <span>{{ seoCount > 0 ? "Compléter le SEO"|trans|raw : "Vérifier le SEO"|trans|raw }}</span>
                                <i class="icm-arrow-right"></i>
                            </a>
                        </article>
                    {%- endif -%}

                    {%- if hasNotFound -%}
                        {%- set notFoundFeedLimit = 5 -%}
                        <article id="kpi-target-notfound" class="attention-card {{ notFoundCount > 0 ? 'is-alert' : 'is-clean' }}">
                            <header class="attention-head">
                                <span class="attention-tag">{{ "404"|trans|raw }}</span>
                                <span class="attention-count">{{ notFoundCount }}</span>
                                <span class="attention-unit">{{ notFoundCount > 1 ? "erreurs"|trans|raw : "erreur"|trans|raw }}</span>
                            </header>
                            <p class="attention-desc">
                                {%- if notFoundCount > 0 -%}
                                    {{ "URLs introuvables à rediriger pour préserver le référencement et l'expérience utilisateur."|trans|raw }}
                                {%- else -%}
                                    {{ "Aucune URL introuvable détectée."|trans|raw }}
                                {%- endif -%}
                            </p>

                            {%- if notFoundCount > 0 -%}
                                <ul class="notfound-feed reset">
                                    {%- for entity in notFoundUrls|slice(0, notFoundFeedLimit) -%}
                                        {%- set displayUri = entity.uri ?: entity.url -%}
                                        <li class="notfound-row">
                                            <span class="notfound-uri" title="{{ entity.url }}">{{ displayUri|truncate(54) }}</span>
                                            <span class="notfound-date">{{ entity.createdAt|ago }}</span>
                                            {%- if routeExist('admin_notfoundurl_redirection') -%}
                                                <a href="{{ path('admin_notfoundurl_redirection', {website: websiteId(), notfoundUrl: entity.id}) }}"
                                                   class="notfound-action"
                                                   aria-label="{{ "Créer une redirection"|trans|striptags }}">
                                                    <i class="icm-arrow-right"></i>
                                                </a>
                                            {%- endif -%}
                                        </li>
                                    {%- endfor -%}
                                </ul>
                            {%- endif -%}

                            <a href="{{ path('admin_notfoundurl_index', {website: websiteId(), type: 'front', category: 'url'}) }}" class="attention-cta">
                                <span>{{ notFoundCount > 0 ? "Traiter les 404"|trans|raw : "Consulter le suivi"|trans|raw }}</span>
                                <i class="icm-arrow-right"></i>
                            </a>
                        </article>
                    {%- endif -%}

                </div>
            </section>
        {%- endif -%}

        {#-- 7 — Search stats (module search) --#}
        {%- if hasSearchValues -%}
            <section id="stats-search" class="dashboard-search reveal">
                <header class="zone-head">
                    <h2 class="zone-title">{{ "Recherches effectuées"|trans|raw }}</h2>
                    <span class="zone-aside">{{ "Module recherche"|trans|raw }}</span>
                </header>

                <div class="search-panel">
                    <ul class="search-feed reset">
                        {%- for value in searchValues -%}
                            <li id="value-row-{{ value.id }}" class="search-row">
                                <span class="search-row-marker" aria-hidden="true"></span>
                                <span class="search-row-text" title="{{ value.text }}">{{ value.text }}</span>
                                <span class="search-row-metrics">
                                    <span class="search-metric">
                                        <span class="search-metric-value">{{ value.counter }}</span>
                                        <span class="search-metric-label">{{ value.counter > 1 ? "recherches"|trans|raw : "recherche"|trans|raw }}</span>
                                    </span>
                                    <span class="search-metric">
                                        <span class="search-metric-value">{{ value.resultCount }}</span>
                                        <span class="search-metric-label">{{ value.resultCount > 1 ? "résultats"|trans|raw : "résultat"|trans|raw }}</span>
                                    </span>
                                </span>
                                <a href="{{ path('admin_searchvalue_delete', {website: website.id, searchvalue: value.id}) }}"
                                   data-bs-toggle="tooltip" title="{{ "Supprimer"|trans|striptags }}"
                                   data-target="#value-row-{{ value.id }}"
                                   class="search-row-action swal-delete-link cursor"
                                   aria-label="{{ "Supprimer"|trans|striptags }}">
                                    {{ 'fas trash'|icon(12, 14) }}
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>

                    {% include 'admin/core/include/pagination.html.twig' with {pagination: searchValues} %}
                </div>
            </section>
        {%- endif -%}

        {#-- 8 — Tools (feeds sync, discreet bottom row) --#}
        {%- if hasFeeds -%}
            <section class="dashboard-tools reveal">
                <div class="tools-row">
                    <div class="tools-info">
                        <h3 class="tools-title">{{ "Feeds sociaux"|trans|raw }}</h3>
                        <p class="tools-desc">
                            {{ "Synchronisation automatique au chargement d'une page, 2 fois par jour maximum. Utilisez le bouton pour forcer une mise à jour."|trans|raw }}
                        </p>
                    </div>
                    <form method="post" action="{{ path('admin_feed_sync', {website: websiteId()}) }}" class="tools-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_feed_sync') }}">
                        <button type="submit" class="btn btn-primary">
                            {{ "Synchroniser maintenant"|trans|raw }}
                        </button>
                    </form>
                </div>
            </section>
        {%- endif -%}

    </div>
{%- endblock -%}
