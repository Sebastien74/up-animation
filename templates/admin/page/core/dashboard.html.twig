{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageIcon = 'tachometer-alt' -%}
{%- set pageTitle = "Tableau de bord"|trans -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-dashboard', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-dashboard', null,  'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {%- set isInternal = granted('ROLE_INTERNAL') -%}
    {%- set hasSeo = isInternal and noSeoCounts is defined and noSeoCounts['total'] is defined -%}
    {%- set userLocale = app.request.locale -%}
    {%- set today = 'now'|date('Y-m-d H:i:s') -%}
    {%- set hourNow = 'now'|date('H')|number_format(0) -%}
    {%- set greetingKey = (hourNow >= 5 and hourNow < 18) ? "Bonjour" : "Bonsoir" -%}
    {%- set userFirstName = app.user.firstName is defined and app.user.firstName ? app.user.firstName : null -%}

    <div id="dashboard" class="pt-2 pb-5">

        {#-- Hero --#}
        <section class="dashboard-hero reveal">
            <div class="hero-inner">
                <div class="hero-meta-top">
                    {{ seasonIcon()|icon(15, 15, 'hero-season') }}
                    <span class="hero-date">{{ today|format_datetime(pattern='cccc d MMMM yyyy', locale=userLocale)|capitalize }}</span>
                </div>
                <h1 class="hero-title mb-0">
                    <span class="hero-greeting">
                        {{ greetingKey|trans }}{% if userFirstName %}, <span class="hero-name">{{ userFirstName }}</span>{% endif %}.
                    </span>
                    <span class="hero-welcome">{{ "Ravi de vous retrouver"|trans|raw }}<span class="hero-mark">.</span></span>
                </h1>
                {%- if app.user.lastLogin is defined and app.user.lastLogin -%}
                    <div class="hero-bottom mt-3">
                        <span class="hero-last-login">
                            <i class="icm-clock"></i>{{ "Dernière connexion"|trans|raw }} {{ app.user.lastLogin|ago }}
                        </span>
                    </div>
                {%- endif -%}
            </div>
            <span class="hero-grid-deco" aria-hidden="true"></span>
        </section>

        {#-- SEO (feature panel) --#}
        {%- if hasSeo -%}
            {%- set seoCount = noSeoCounts['total'] -%}
            <section class="dashboard-seo mt-5 reveal">
                <div class="seo-panel {{ seoCount > 0 ? 'is-warning' : 'is-clean' }}">

                    <div class="seo-left">
                        <span class="seo-tag">{{ "SEO"|trans|raw }}</span>
                        <span class="seo-number">{{ seoCount }}</span>
                        <span class="seo-unit">{{ seoCount > 1 ? "balises"|trans|raw : "balise"|trans|raw }}</span>
                    </div>

                    <div class="seo-body">
                        <h2 class="seo-headline">
                            {%- if seoCount > 0 -%}
                                {{ "SEO manquant à compléter."|trans|raw }}
                            {%- else -%}
                                {{ "Référencement à jour."|trans|raw }}
                            {%- endif -%}
                        </h2>
                        <p class="seo-desc">
                            {%- if seoCount > 0 -%}
                                {{ "Renseignez les balises manquantes pour améliorer la visibilité de votre site sur les moteurs de recherche."|trans|raw }}
                            {%- else -%}
                                {{ "Toutes les balises SEO sont renseignées. Continuez ainsi."|trans|raw }}
                            {%- endif -%}
                        </p>

                        {%- if allLocales|length > 1 and seoCount > 0 -%}
                            <ul class="seo-locales reset">
                                {%- for locale, count in noSeoCounts|unset('total') -%}
                                    {%- if count >= 0 -%}
                                        <li class="locale-row">
                                            <span class="locale-flag">
                                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                                                     data-src="{{ asset('/medias/icons/flags/'~locale~'.svg') }}"
                                                     width="16" height="16"
                                                     alt="{{ languageName(locale, userLocale)|striptags }}"
                                                     class="img-fluid fit-cover lazy-load">
                                            </span>
                                            <span class="locale-name">{{ languageName(locale, userLocale) }}</span>
                                            <span class="locale-bar" aria-hidden="true">
                                                <span class="locale-bar-fill" style="width: {{ seoCount > 0 ? (count / seoCount * 100)|round : 0 }}%"></span>
                                            </span>
                                            <span class="locale-count">{{ count }}</span>
                                        </li>
                                    {%- endif -%}
                                {%- endfor -%}
                            </ul>
                        {%- endif -%}

                        <a href="{{ path('admin_seo_edit', {website: websiteId(), entitylocale: defaultLocale}) }}" class="seo-cta">
                            <span>{{ seoCount > 0 ? "Compléter le SEO"|trans|raw : "Vérifier le SEO"|trans|raw }}</span>
                            <i class="icm-arrow-right"></i>
                        </a>
                    </div>

                </div>
            </section>
        {%- endif -%}

        {#-- Accès rapides --#}
        <section class="dashboard-shortcuts mt-5">
            <div class="section-label mb-3">
                <span class="label-line" aria-hidden="true"></span>
                <span class="label-text">{{ "Accès rapides"|trans|raw }}</span>
                <span class="label-aside">{{ "Vos modules"|trans|raw }}</span>
            </div>
            <div class="shortcuts-grid">
                {%- if 'pages'|moduleActive(configuration) -%}
                    <a href="{{ path('admin_page_tree', {website: websiteId}) }}" class="shortcut-tile reveal">
                        <span class="shortcut-icon"><i class="icm-file-alt"></i></span>
                        <span class="shortcut-body">
                            <span class="shortcut-title">{{ "Pages"|trans|raw }}</span>
                            <span class="shortcut-desc">{{ "Arborescence éditoriale"|trans|raw }}</span>
                        </span>
                        <span class="shortcut-arrow" aria-hidden="true"><i class="icm-arrow-right"></i></span>
                    </a>
                {%- endif -%}
                {%- if 'medias'|moduleActive(configuration) -%}
                    <a href="{{ path('admin_medias_library', {website: websiteId}) }}" class="shortcut-tile reveal">
                        <span class="shortcut-icon"><i class="icm-images"></i></span>
                        <span class="shortcut-body">
                            <span class="shortcut-title">{{ "Médias"|trans|raw }}</span>
                            <span class="shortcut-desc">{{ "Bibliothèque"|trans|raw }}</span>
                        </span>
                        <span class="shortcut-arrow" aria-hidden="true"><i class="icm-arrow-right"></i></span>
                    </a>
                {%- endif -%}
                {%- if 'newscast'|moduleActive(configuration) -%}
                    <a href="{{ path('admin_newscast_index', {website: websiteId}) }}" class="shortcut-tile reveal">
                        <span class="shortcut-icon"><i class="icm-newspaper"></i></span>
                        <span class="shortcut-body">
                            <span class="shortcut-title">{{ "Actualités"|trans|raw }}</span>
                            <span class="shortcut-desc">{{ "Publications"|trans|raw }}</span>
                        </span>
                        <span class="shortcut-arrow" aria-hidden="true"><i class="icm-arrow-right"></i></span>
                    </a>
                {%- endif -%}
                {%- if 'form'|moduleActive(configuration) -%}
                    <a href="{{ path('admin_form_index', {website: websiteId}) }}" class="shortcut-tile reveal">
                        <span class="shortcut-icon"><i class="icm-paper-plane"></i></span>
                        <span class="shortcut-body">
                            <span class="shortcut-title">{{ "Formulaires"|trans|raw }}</span>
                            <span class="shortcut-desc">{{ "Soumissions reçues"|trans|raw }}</span>
                        </span>
                        <span class="shortcut-arrow" aria-hidden="true"><i class="icm-arrow-right"></i></span>
                    </a>
                {%- endif -%}
                {%- if 'slider'|moduleActive(configuration) -%}
                    <a href="{{ path('admin_slider_index', {website: websiteId}) }}" class="shortcut-tile reveal">
                        <span class="shortcut-icon"><i class="icm-sliders-h"></i></span>
                        <span class="shortcut-body">
                            <span class="shortcut-title">{{ "Sliders"|trans|raw }}</span>
                            <span class="shortcut-desc">{{ "Carrousels"|trans|raw }}</span>
                        </span>
                        <span class="shortcut-arrow" aria-hidden="true"><i class="icm-arrow-right"></i></span>
                    </a>
                {%- endif -%}
            </div>
        </section>

    </div>
{%- endblock -%}
