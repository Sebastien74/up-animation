{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set interfaceLabels = {page: "Pages"|trans, newscast: "Actualités"|trans, catalogproduct: "Produits"|trans} -%}
{%- set typeLabel = interfaceLabels[interface]|default(interface) -%}
{%- set pageCode = url.code ?: '/' -%}

{%- set pageIcon = 'rocket' -%}
{%- set pageTitle = "Analyse"|trans ~ ' · ' ~ (name is defined and name ? name : '/' ~ pageCode) -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-dashboard', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-analysis-page', null, 'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    <div id="analysis-page-detail" class="pt-2 pb-5"
         data-run-url="{{ runUrl }}"
         {% if psiEnabled %}data-psi-url="{{ psiUrl }}"{% endif %}>

        {%- if reportMarkdown -%}
            <textarea id="pa-md-source" class="d-none" aria-hidden="true" tabindex="-1">{{ reportMarkdown }}</textarea>
        {%- endif -%}

        <div class="perf-inspector-head pa-detail-head mb-4">
            <div class="pa-detail-headline">
                <span class="pa-type-pill">{{ typeLabel }}</span>
                <h1 class="perf-inspector-title mt-2">{{ name is defined and name ? name : '/'~pageCode }}</h1>
                {%- if name is defined and name -%}
                    <a href="{{ previewUrl }}" target="_blank" rel="noopener" class="pa-page-url d-inline-block mt-1">/{{ pageCode }}</a>
                {%- endif -%}
                <p class="perf-inspector-desc">
                    {{ "Détail de la dernière analyse en preview. Indice indicatif, ce n'est pas une mesure Lighthouse."|trans|raw }}
                </p>
            </div>
            <div class="pa-detail-actions d-flex align-items-center gap-2">
                <a href="{{ previewUrl }}" target="_blank" rel="noopener" class="btn-app small d-inline-flex align-items-center gap-2">
                    <i class="icm-external-link-alt"></i><span>{{ "Ouvrir la page"|trans|striptags }}</span>
                </a>
                <button type="button" class="pa-detail-run btn-app small d-inline-flex align-items-center gap-2">
                    <i class="icm-rocket"></i><span>{{ "Relancer l'analyse"|trans|striptags }}</span>
                </button>
                {%- if psiEnabled -%}
                    <button type="button" class="pa-psi-run btn-app small d-inline-flex align-items-center gap-2"
                            data-running-label="{{ "Mesure en cours…"|trans|striptags }}">
                        <i class="icm-google"></i><span>{{ "Lancer PageSpeed"|trans|striptags }}</span>
                    </button>
                {%- endif -%}
                {%- if reportMarkdown -%}
                    <button type="button" class="pa-detail-copy-md btn-app small d-inline-flex align-items-center gap-2"
                            data-copied-label="{{ "Copié !"|trans|striptags }}">
                        <i class="icm-copy"></i><span>{{ "Copier l'analyse (.md)"|trans|striptags }}</span>
                    </button>
                {%- endif -%}
                {%- if psiEnabled and psiMarkdown -%}
                    <button type="button" class="psi-copy-md btn-app small d-inline-flex align-items-center gap-2"
                            data-copied-label="{{ "Copié !"|trans|striptags }}">
                        <i class="icm-copy"></i><span>{{ "Copier PageSpeed (.md)"|trans|striptags }}</span>
                    </button>
                {%- endif -%}
                {%- if latest is not null -%}
                    <button type="button" class="btn-app danger small d-inline-flex align-items-center gap-2"
                            data-bs-toggle="modal" data-bs-target="#pa-delete-modal"
                            data-pa-action="{{ path('admin_page_analysis_clear_page', {website: websiteId(), url: url.id}) }}"
                            data-pa-scope="page" data-pa-label="/{{ pageCode }}"
                            data-pa-return="{{ path('admin_page_analysis_detail', {website: websiteId(), url: url.id, interface: interface}) }}">
                        <i class="icm-trash"></i><span>{{ "Supprimer les données"|trans|striptags }}</span>
                    </button>
                {%- endif -%}
            </div>
        </div>

        {%- if psiEnabled -%}
            <ul class="nav nav-tabs pa-detail-tabs mb-4" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pa-tab-internal" data-bs-toggle="tab"
                            data-bs-target="#pa-pane-internal" type="button" role="tab"
                            aria-controls="pa-pane-internal" aria-selected="true">
                        <i class="icm-rocket" aria-hidden="true"></i> {{ "Analyse interne"|trans }}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pa-tab-psi" data-bs-toggle="tab"
                            data-bs-target="#pa-pane-psi" type="button" role="tab"
                            aria-controls="pa-pane-psi" aria-selected="false">
                        <i class="icm-google" aria-hidden="true"></i> {{ "PageSpeed Insights"|trans }}
                    </button>
                </li>
            </ul>
            <div class="tab-content pa-detail-tab-content">
                <div class="tab-pane fade show active" id="pa-pane-internal" role="tabpanel" aria-labelledby="pa-tab-internal">
                    {%- include 'admin/page/core/include/analysis-page-internal.html.twig' with {latest: latest, history: history} only -%}
                </div>
                <div class="tab-pane fade" id="pa-pane-psi" role="tabpanel" aria-labelledby="pa-tab-psi">
                    {%- if psi is not null -%}
                        {%- include 'admin/page/core/include/analysis-page-psi.html.twig' with {psi: psi, psiMarkdown: psiMarkdown} only -%}
                    {%- else -%}
                        <div class="psi-panel psi-panel-empty mb-4">
                            <span class="psi-badge"><i class="icm-rocket" aria-hidden="true"></i> {{ "PageSpeed Insights"|trans }}</span>
                            <p class="perf-inspector-desc mb-0">
                                {{ "Lancez une mesure PageSpeed pour obtenir les scores réels Google et la liste des points à corriger."|trans|raw }}
                            </p>
                        </div>
                    {%- endif -%}
                </div>
            </div>
        {%- else -%}
            {%- include 'admin/page/core/include/analysis-page-internal.html.twig' with {latest: latest, history: history} only -%}
        {%- endif -%}

    </div>

    {%- if latest is not null -%}
        {%- include 'admin/page/core/include/analysis-page-delete-modal.html.twig' -%}
    {%- endif -%}

{%- endblock -%}
