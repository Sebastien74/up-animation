{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageTitle = file ?: "Logs"|trans -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Logs"|trans }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-development', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {%- set severities = {
        critical:  {label: "Critique"|trans,  icon: 'exclamation-triangle', modifier: 'is-critical'},
        warning:   {label: "Avertissement"|trans, icon: 'whistle',           modifier: 'is-warning'},
        error:     {label: "Erreur"|trans,    icon: 'exclamation-triangle', modifier: 'is-warning'},
        alert:     {label: "Alerte"|trans,    icon: 'whistle',              modifier: 'is-warning'},
        success:   {label: "Succès"|trans,    icon: 'check-circle',         modifier: 'is-success'},
        undefined: {label: "Info"|trans,      icon: 'info-circle',          modifier: 'is-info'}
    } -%}

    <div id="log-page" class="pt-2 pb-5">

        <div class="log-head mb-4">
            <div class="log-head-line mb-3">
                <span class="log-meta-chip">
                    <i class="icm-file"></i>
                    <span>{{ file }}</span>
                </span>
                <span class="log-meta-chip">
                    <i class="icm-stack"></i>
                    <span>{{ logs|length }}&nbsp;{{ logs|length > 1 ? "entrées"|trans : "entrée"|trans }}</span>
                </span>
            </div>
            <h1 class="log-title">{{ file }}</h1>
        </div>

        <section>
            <div class="section-label mb-3">
                <span class="label-line" aria-hidden="true"></span>
                <span class="label-text">{{ "Dernières entrées"|trans }}</span>
                <span class="label-aside">{{ "Top"|trans }}&nbsp;50</span>
            </div>

            <div class="log-feed">
                {%- for log in logs|reverse -%}
                    {%- if log -%}
                        {%- set severity = severities[log.status] is defined ? severities[log.status] : severities.undefined -%}
                        <article class="log-row {{ severity.modifier }}">
                            <header class="log-row-head">
                                <span class="log-row-channel">
                                    <i class="icm-{{ severity.icon }}"></i>
                                    <span>{{ log.code }}</span>
                                </span>
                                {%- if log.date|isDateTime -%}
                                    <span class="log-row-time">
                                        <i class="icm-clock"></i>
                                        <span>{{ log.date|date('d/m/Y H:i:s') }}</span>
                                    </span>
                                {%- endif -%}
                            </header>
                            <pre class="log-row-body">{{ log.message }}</pre>
                        </article>
                    {%- endif -%}
                {%- endfor -%}

                {%- if logs|length == 0 -%}
                    <div class="log-empty">
                        <i class="icm-info-circle"></i>
                        <span>{{ "Aucune entrée dans ce fichier."|trans }}</span>
                    </div>
                {%- endif -%}
            </div>
        </section>

    </div>

{%- endblock -%}
