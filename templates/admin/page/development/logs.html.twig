{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set websiteId = websiteId() -%}
{%- set pageTitle = "Logs"|trans -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-development', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    <div id="logs-page" class="pt-2 pb-5">

        {%- if logFiles -%}
            <section class="mb-5">
                <div class="section-label mb-3">
                    <span class="label-line" aria-hidden="true"></span>
                    <span class="label-text">{{ "Fichiers permanents"|trans|raw }}</span>
                    <span class="label-aside">{{ logFiles|length }}</span>
                </div>
                <div class="logs-panel">
                    <ul class="logs-feed">
                        {%- for logFile in logFiles -%}
                            {%- set modifier = 'is-info' -%}
                            {%- if 'critical' in logFile or 'error' in logFile -%}{% set modifier = 'is-critical' %}{% endif -%}
                            {%- if 'deprecations' in logFile -%}{% set modifier = 'is-warning' %}{% endif -%}
                            <li>
                                <a href="{{ path('admin_log', {locale: masterRequestGet('locale'), website: websiteId, file: logFile}) }}"
                                   class="log-file-link {{ modifier }}">
                                    <span class="log-file-dot" aria-hidden="true"></span>
                                    <span class="log-file-name">{{ logFile }}</span>
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
            </section>
        {%- endif -%}

        {%- if dailyLogs -%}
            <section>
                <div class="section-label mb-3">
                    <span class="label-line" aria-hidden="true"></span>
                    <span class="label-text">{{ "Logs quotidiens"|trans|raw }}</span>
                    <span class="label-aside">{{ dailyLogs|length }}&nbsp;{{ dailyLogs|length > 1 ? "jours"|trans|raw : "jour"|trans|raw }}</span>
                </div>

                <div class="logs-grid">
                    {%- for key, logDay in dailyLogs -%}
                        {%- for logDay, logFiles in logDay -%}
                            <article class="logs-panel">
                                <header class="logs-panel-head">
                                    <i class="icm-calendar"></i>
                                    <span>{{ logDay|format_datetime(pattern='EEEE d MMMM y', locale=app.request.locale)|capitalize }}</span>
                                    <span class="logs-panel-count">{{ logFiles|length }}</span>
                                </header>
                                <ul class="logs-feed">
                                    {%- for logFile in logFiles -%}
                                        {%- set modifier = 'is-info' -%}
                                        {%- if 'critical' in logFile or 'error' in logFile -%}{% set modifier = 'is-critical' %}{% endif -%}
                                        {%- if 'deprecations' in logFile -%}{% set modifier = 'is-warning' %}{% endif -%}
                                        <li>
                                            <a href="{{ path('admin_log', {locale: masterRequestGet('locale'), website: websiteId, file: logFile}) }}"
                                               class="log-file-link {{ modifier }}">
                                                <span class="log-file-dot" aria-hidden="true"></span>
                                                <span class="log-file-name">{{ logFile }}</span>
                                            </a>
                                        </li>
                                    {%- endfor -%}
                                </ul>
                            </article>
                        {%- endfor -%}
                    {%- endfor -%}
                </div>
            </section>
        {%- endif -%}

        {%- if not logFiles and not dailyLogs -%}
            <div class="log-empty">
                <i class="icm-info-circle"></i>
                <span>{{ "Aucun fichier de log."|trans }}</span>
            </div>
        {%- endif -%}

    </div>

{%- endblock -%}
