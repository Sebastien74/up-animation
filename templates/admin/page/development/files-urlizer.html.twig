{%- trans_default_domain 'admin' -%}

<div class="modal fade" id="files-urlizer-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border refer-preloader text-start pb-5 pt-3">
            {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'modal-preloader', full: true} only -%}
            <div class="modal-header">
                <span class="modal-icon text-center w-100"><span class="icon-wrap"><i class="icm-file-alt"></i></span></span>
                <button class="btn-close btn-icon position-absolute" data-bs-dismiss="modal" aria-label="{{"Fermer"|trans|raw }}">
                    <i class="icm-times"></i>
                </button>
            </div>
            <div class="modal-body d-flex">
                <div class="container my-auto ajax-content">
                    <h2 class="main-title text-center fw-bold mb-5">{{ "Urlizer"|trans|raw }}</h2>
                    {{ form_start(form, {attr: {
                        id: 'files-rename-form',
                        action: path('admin_file_rename_tool'),
                        novalidate: "novalidate"
                    }}) }}
                        {{ form_row(form.files) }}
                        <div class="w-100 text-center modal-buttons mt-4">
                            <button class="btn-app" data-bs-dismiss="modal">{{ "Annuler"|trans|raw }}</button>
                            <button type="submit" class="btn-app refresh">{{ "Générer une archive"|trans|raw }}</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>