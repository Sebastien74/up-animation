{%- trans_default_domain 'admin' -%}

<div class="modal fade" id="files-urlizer-modal" tabindex="-1" role="dialog"
     aria-labelledby="files-urlizer-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border refer-preloader pb-3">
            {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'modal-preloader', full: true} only -%}
            <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                <span class="modal-icon w-100">
                    <span class="icon-wrap">
                        <i class="icm-file-alt"></i>
                    </span>
                </span>
                <h2 id="files-urlizer-modal-label" class="modal-title fw-bold mt-3 mb-0">{{ "Urlizer"|trans|raw }}</h2>
                <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                    <i class="icm-times"></i>
                </button>
            </div>
            <div class="modal-body px-3 px-md-5">
                <div class="ajax-content">
                    {{ form_start(form, {attr: {
                        id: 'files-rename-form',
                        action: path('admin_file_rename_tool'),
                        novalidate: "novalidate"
                    }}) }}
                        {{ form_row(form.files) }}
                        <div class="w-100 text-center modal-buttons mt-4 d-flex flex-wrap justify-content-center gap-2">
                            <button type="button" class="btn-app muted d-inline-flex align-items-center gap-2" data-bs-dismiss="modal">
                                <i class="icm-ban"></i><span>{{ "Annuler"|trans|raw }}</span>
                            </button>
                            <button type="submit" class="btn-app refresh d-inline-flex align-items-center gap-2">
                                <i class="icm-archive"></i><span>{{ "Générer une archive"|trans|raw }}</span>
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>