{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- block title -%}{{ "Infos projet"|trans|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Infos projet"|trans }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-development', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    <div class="card mb-3">
        <h4 class="main-subtitle"><i class="icm-exclamation-circle"></i>{{ "Infos"|trans }}</h4>
        <table class="table table-striped mb-0">
            <tr>
                <td>{{ 'Poids total'|trans|raw }}</td>
                <td>{{ totalSize|formatBytes() }}</td>
            </tr>
            <tr>
                <td>{{ 'Nombre de fichiers'|trans|raw }}</td>
                <td>{{ filesCount|number_format(0, ',', ' ') }}</td>
            </tr>
        </table>
    </div>

    <ul id="files-sizes-ifo-list">
        {%- for directory, size in directoriesSizes -%}
            <li class="mt-3">
                <i class="icm-folder-open"></i>{{ directory }} : {{ size|formatBytes() }}
                {%- if subDirectoriesSizes[directory] is defined -%}
                    <ul>
                        {%- for subDirectory, subSize in subDirectoriesSizes[directory] -%}
                            <li>
                                <i class="icm-folder"></i>{{ directory~'/'~subDirectory }} : {{ subSize|formatBytes() }}
                            </li>
                        {%- endfor -%}
                    </ul>
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>

{%- endblock -%}