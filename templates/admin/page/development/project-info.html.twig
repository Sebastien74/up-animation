{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- block title -%}{{ "Infos projet"|trans|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Infos projet"|trans|raw }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-development', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    <div id="project-info-page" class="reveal-stagger">

        <section class="feature-panel panel-split mb-4 reveal">
            <div class="panel-left">
                <span class="panel-tag">{{ "Projet"|trans|raw }}</span>
                <span class="panel-number">{{ filesCount|number_format(0, ',', ' ') }}</span>
                <span class="panel-unit">{{ filesCount > 1 ? "fichiers"|trans|raw : "fichier"|trans|raw }}</span>
            </div>
            <div class="panel-body">
                <h2 class="panel-headline">{{ "Poids du projet."|trans|raw }}</h2>
                <p class="panel-desc">
                    {{ "Total occupé sur le disque :"|trans|raw }} <strong>{{ totalSize|formatBytes() }}</strong>.
                    {{ "Réparti sur"|trans|raw }} {{ directoriesSizes|length }}&nbsp;{{ directoriesSizes|length > 1 ? "dossiers de premier niveau"|trans|raw : "dossier de premier niveau"|trans|raw }}.
                </p>
            </div>
        </section>

        <div class="section-label mb-3 reveal">
            <span class="label-line" aria-hidden="true"></span>
            <span class="label-text">{{ "Répartition"|trans|raw }}</span>
            <span class="label-aside">{{ directoriesSizes|length }}&nbsp;{{ directoriesSizes|length > 1 ? "dossiers"|trans|raw : "dossier"|trans|raw }}</span>
        </div>

        <ul class="size-breakdown reveal">
            {%- for directory, size in directoriesSizes -%}
                {%- set pct = totalSize > 0 ? (size / totalSize * 100) : 0 -%}
                <li class="size-item">
                    <div class="size-row">
                        <span class="size-head">
                            <i class="icm-folder-open" aria-hidden="true"></i>
                            <span class="size-name">{{ directory }}</span>
                        </span>
                        <span class="size-meta">
                            <span class="size-bytes">{{ size|formatBytes() }}</span>
                            <span class="size-pct">{{ pct|number_format(1, ',', ' ') }}&nbsp;%</span>
                        </span>
                    </div>
                    <div class="size-track" role="presentation">
                        <span class="size-fill" style="width: {{ pct|round(2) }}%;"></span>
                    </div>
                    {%- if subDirectoriesSizes[directory] is defined -%}
                        <ul class="size-subs">
                            {%- for subDirectory, subSize in subDirectoriesSizes[directory] -%}
                                {%- set subPct = size > 0 ? (subSize / size * 100) : 0 -%}
                                <li class="size-sub">
                                    <span class="size-sub-name">
                                        <i class="icm-folder" aria-hidden="true"></i>{{ subDirectory }}
                                    </span>
                                    <span class="size-sub-bytes">{{ subSize|formatBytes() }}</span>
                                    <span class="size-sub-track" role="presentation">
                                        <span class="size-sub-fill" style="width: {{ subPct|round(2) }}%;"></span>
                                    </span>
                                </li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}
                </li>
            {%- endfor -%}
        </ul>

    </div>

{%- endblock -%}