{%- trans_default_domain 'admin' -%}

<div class="modal fade modal-event-agenda"
     id="modal-event-agenda" tabindex="-1" role="dialog">
    <div class="ajax-content">
        {{ form_start(form, {attr: {
            novalidate: "novalidate",
            action: form_route,
            id: 'modal-event-agenda-form'
        }}) }}
            <div class="modal-dialog modal-dialog-centered modal-md" role="document">
                <div class="modal-content border">
                    <div class="modal-header">
                        {%- if entity.id -%}
                            <a class="btn-transparent sa-warning swal-delete-link"
                               href="{{ path('admin_agendaperiod_delete', {website: websiteId(), agendaperiod: entity.id}) }}"
                               data-bs-toggle="tooltip"
                               title="{{"Supprimer"|trans|striptags }}"
                               data-type="collection">
                                <i class="icm-trash"></i>
                            </a>
                        {%- endif -%}
                        <span class="modal-icon text-center w-100"><span class="icon-wrap"><i class="icm-download"></i></span></span>
                        <button class="btn-close btn-icon" data-bs-dismiss="modal" aria-label="{{"Fermer"|trans }}">
                            <i class="icm-times"></i>
                        </button>
                    </div>
                    <div class="modal-body pe-4 ps-4">
                        <div class="row">
                            {{ form_row(form) }}
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>