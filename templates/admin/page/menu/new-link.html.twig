{%- trans_default_domain 'admin' -%}

{{ form_start(form, {attr: {
    id: "link-form",
    novalidate: "novalidate",
    action: path('admin_link_new', {website: websiteId(), menu: menu, entitylocale: entitylocale})
}}) }}
    <div id="link-form-content" class="row">
        {%- include 'admin/core/form/edit-fields-base.html.twig' with {form: form} only -%}
        {%- if form.save is defined -%}
            {{ form_row(form.save) }}
        {%- else -%}
            <div class="form-group">
                <button id="link_save" type="submit" class="btn-app d-inline-flex align-items-center gap-2">
                    <i class="icm-plus"></i><span>{{ "Ajouter au menu"|trans|raw }}</span>
                </button>
            </div>
        {%- endif -%}
    </div>
{{ form_end(form) }}