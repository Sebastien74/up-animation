{%- extends "admin/page/documentation/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set docNavIcons = ['compass', 'shield-check', 'credit-card', 'cog', 'terminal', 'sitemap', 'database', 'server', 'stream', 'rocket'] -%}

{%- block title -%}{{ "Documentation"|trans|striptags }}{%- endblock -%}

{%- block body -%}
    {%- if featured -%}
        <section class="doc-feature" aria-labelledby="doc-feature-title">
            <div class="doc-feature-head">
                <span class="doc-feature-badge"><i class="icm-rocket" aria-hidden="true"></i></span>
                <div>
                    <p class="doc-feature-kicker">{{ "Avant tout déploiement"|trans|raw }}</p>
                    <h2 class="doc-feature-title" id="doc-feature-title">{{ featured.title }}</h2>
                </div>
                <a class="doc-feature-link" href="{{ path('admin_documentation_page', {slug: featured.slug}) }}">
                    {{ "Ouvrir la page"|trans|raw }}<i class="icm-chevron-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="doc-content doc-feature-content">{{ featured.markdown|markdown_to_html }}</div>
        </section>
    {%- endif -%}

    <div class="doc-hero">
        <span class="doc-hero-badge"><i class="icm-book-open" aria-hidden="true"></i></span>
        <h1 class="doc-hero-title">{{ "Documentation technique"|trans|raw }}</h1>
        <p class="doc-hero-text">{{ "Guides internes : déploiement, dépannage, services et API du projet."|trans|raw }}</p>
    </div>

    {%- if navPages is empty -%}
        <div class="doc-empty">{{ "Aucune documentation disponible pour le moment."|trans|raw }}</div>
    {%- else -%}
        <div class="doc-grid">
            {%- for page in navPages|filter(page => not (featured and page.slug == featured.slug)) -%}
                <a class="doc-tile" href="{{ path('admin_documentation_page', {slug: page.slug}) }}">
                    <span class="doc-tile-head">
                        <span class="doc-tile-icon"><i class="icm-{{ docNavIcons[loop.index0 % docNavIcons|length] }}" aria-hidden="true"></i></span>
                        <span class="doc-tile-title">{{ page.title }}</span>
                    </span>
                    {%- if page.excerpt -%}
                        <span class="doc-tile-excerpt">{{ page.excerpt }}</span>
                    {%- endif -%}
                    <span class="doc-tile-more">{{ "Parcourir"|trans|raw }}</span>
                </a>
            {%- endfor -%}
        </div>
    {%- endif -%}

    {%- if externalResources is defined and externalResources is not empty -%}
        <p class="doc-grid-label">{{ "Outils & API"|trans|raw }}</p>
        <div class="doc-grid">
            {%- for resource in externalResources -%}
                <a class="doc-tile" href="{{ path(resource.route) }}">
                    <span class="doc-tile-head">
                        <span class="doc-tile-icon"><i class="{{ resource.icon }}" aria-hidden="true"></i></span>
                        <span class="doc-tile-title">{{ resource.title }}</span>
                    </span>
                    {%- if resource.excerpt -%}
                        <span class="doc-tile-excerpt">{{ resource.excerpt }}</span>
                    {%- endif -%}
                    <span class="doc-tile-more">{{ "Parcourir"|trans|raw }}</span>
                </a>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock -%}
