{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageIcon = 'globe' -%}

{%- block title -%}{{ "Traductions"|trans|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Traductions"|trans|raw }}{%- endblock -%}
{%- set allLocales = website().configuration.allLocales -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-translation', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-translation', null,  'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}
    <span>
        <a href="{{ lastRoute() }}" class="btn-back mb-3"
           data-bs-toggle="tooltip" title="{{"Retourner à la page précédente"|trans }}"
           aria-label="{{"Retourner à la page précédente"|trans|striptags }}">
            <i class="icm-reply"></i>
        </a>
    </span>
    <div id="translations-domains">
        <div class="table-responsive app-table">
            <table class="table table-striped responsive-cards">
                <thead>
                <tr>
                    <th class="align-middle keys-td">{{ "Domaine"|trans }}</th>
                    <th class="align-middle keys-td">{{ "Clé du contenu"|trans }}</th>
                    <th class="align-middle forms-td">{%- if allLocales|length > 1 -%}{{ "Langues"|trans }}{%- else -%}{{ "Texte"|trans }}{%- endif -%}</th>
                    <th class="align-middle actions-td text-center">{{ "Actions"|trans }}</th>
                </tr>
                </thead>
                <tbody>
                    {%- for domain in domains -%}
                        {%- for unit in domain.units -%}
                            {{ render_esi(path('admin_translationunit_edit', {website: websiteId(), translationunit: unit.id, displayDomain: true} )) }}
                        {%- endfor -%}
                    {%- endfor -%}
                </tbody>
            </table>
        </div>
    </div>
{%- endblock -%}
