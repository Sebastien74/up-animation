<form role="search" class="form-search"
      action="{{ path('admin_translation_search_edit', {website: websiteId}) }}"
      method="GET">
    <div class="input-group search-input-group">
        <div class="input-group-text">
            <button type="submit" class="search-btn btn-icon" data-bs-toggle="tooltip" title="{{ "Rechercher"|trans|striptags }}">
                <i class="icm-search"></i>
            </button>
        </div>
        <input name="search" placeholder="{{ "Rechercher"|trans }}" class="form-control" type="text">
    </div>
</form>