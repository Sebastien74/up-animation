{%- trans_default_domain 'admin' -%}

<div class="sidebar-search-field translation-search-field">
    <i class="icm-search" aria-hidden="true"></i>
    <input type="search"
           class="translation-search-input"
           autocomplete="off"
           spellcheck="false"
           placeholder="{{ "Rechercher une traduction"|trans|striptags }}"
           aria-label="{{ "Rechercher une traduction"|trans|striptags }}">
    <button type="button"
            class="sidebar-search-clear translation-search-clear"
            aria-label="{{ "Effacer la recherche"|trans|striptags }}">
        <i class="icm-times" aria-hidden="true"></i>
    </button>
</div>
