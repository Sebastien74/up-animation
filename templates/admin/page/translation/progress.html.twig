{%- trans_default_domain 'admin' -%}

<div id="translation-progress">

    {%- set allLocales = website().configuration.allLocales -%}
    {%- set total = 0 -%}

    {%- for domain, locales in translations -%}
        {%- if domain != '_undefined' -%}
            {%- for locale, localeTranslations in locales -%}
                {%- set total = total + localeTranslations|length -%}
            {%- endfor -%}
        {%- endif -%}
    {%- endfor -%}

    <h4 class="text-center mb-1">{{ "Synchronisation de la base de données"|trans|replace({'__': ''}) }}</h4>
    <b class="italic mb-4 w-100 text-center d-inline-block">
        <span id="main-counter" data-count="0" data-total="{{ total }}">0</span>/{{ total }} {{ "clés de traductions"|trans|replace({'__': ''}) }}
    </b>

    <div class="row m-0">
        {%- for domain, locales in translations -%}
            {%- if domain != '_undefined' -%}
                {%- set isFirst = true -%}
                {%- for locale, localeTranslations in locales -%}
                    {%- if locale in allLocales -%}
                        <div class="{% if not multiCols %}col-12{% else %}col-md-6 col-lg-4 col-xl-3{% endif %}">
                            <div class="progress-block card p-3 mb-3" data-progress-href="#progress-{{ loop.index~"-"~locale }}">
                                <strong class="w-100 d-inline-flex align-items-center gap-2 mb-2">
                                    {%- if allLocales|length > 1 -%}
                                        <span class="locale-badge">
                                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="{{ locale|languageName }}"
                                                 data-src=" {{ asset('/medias/icons/flags/'~locale~'.svg') }}"
                                                 class="img-fluid lazy-load" height="17" width="17">
                                        </span>
                                    {%- endif -%}
                                    {{ domain|trans|raw }}
                                    <small class="italic">
                                        <span class="counter">0</span>/{{ localeTranslations|length }}
                                    </small>
                                </strong>
                                <ul id="domain-{{ domain~"-"~locale }}"
                                    data-count="{{ localeTranslations|length }}"
                                    data-progress="0"
                                    class="translation-list reset undo d-none"
                                    data-locale="{{ locale }}"
                                    data-domain="{{ domain }}"
                                    data-batch-url="{{ path('admin_translation_generate_batch', {website: websiteId(), locale: locale, domain: domain|url_encode}) }}">
                                    {%- set items = [] -%}
                                    {%- for keyName, content in localeTranslations -%}
                                        {%- set items = items|merge([{keyName: keyName, content: content}]) -%}
                                    {%- endfor -%}
                                    <script type="application/json" class="domain-translations">
                                        {{ items|json_encode|raw }}
                                    </script>
                                </ul>
                                <div id="progress-{{ loop.index~"-"~locale }}" class="progress">
                                    <div class="progress-bar progress-bar-striped" role="progressbar" style="width: 0" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
        {%- endfor -%}
    </div>

</div>