{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set name = 'singular'|trans([], domain.name) and 'singular'|trans([], domain.name) != 'singular'
    ? 'singular'|trans([], domain.name) : domain.adminName -%}
{%- set pageIcon = 'globe' -%}
{%- set allLocales = website().configuration.allLocales -%}

{%- block title -%}{{ "Contenus :"|trans~' '~name|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Contenus :"|trans~' '~name }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-translation', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-translation', null,  'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}
    <div id="entities-index" class="translations-domain">
        <div class="d-flex align-items-center gap-2 mb-4">
            {%- if searchForm -%}
                {%- include 'admin/core/form/index-search-form.html.twig' with {form: searchForm} -%}
            {%- endif -%}
            <a href="{{ lastRoute() }}" class="btn-icon ms-auto"
               data-bs-toggle="tooltip" title="{{"Retourner à la page précédente"|trans|striptags }}"
               aria-label="{{"Retourner à la page précédente"|trans|striptags }}">
                <i class="icm-reply"></i>
            </a>
        </div>
        <div id="result" class="position-relative">
            {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'index-preloader', full: true} only -%}
            <div class="table-responsive app-table">
                <table class="table table-striped responsive-cards">
                    <thead>
                        <tr>
                            <th class="align-middle px-4">{{ "Clé du contenu"|trans|raw }}</th>
                            <th class="align-middle px-4">{%- if allLocales|length > 1 -%}{{ "Langues"|trans|raw }}{%- else -%}{{ "Texte"|trans|raw }}{%- endif -%}</th>
                            <th class="align-middle px-4 text-end">{{ "Actions"|trans|raw }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {%- for unit in pagination -%}
                            {{ render_esi(path('admin_translationunit_edit', {website: websiteId(), translationunit: unit.id} )) }}
                        {%- endfor -%}
                    </tbody>
                </table>
            </div>
            {%- include 'admin/core/include/pagination.html.twig' -%}
        </div>
    </div>
{%- endblock -%}
