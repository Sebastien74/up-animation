{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageIcon = 'globe' -%}

{%- block title -%}{{ "Groupes de traductions"|trans|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Groupes de traductions"|trans|raw }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-translation', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-translation', null,  'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {%- set toExtract = pagination.getTotalItemCount is defined and pagination.getTotalItemCount == 0 and not masterRequestGet('index_search')
        or pagination|length == 0 and not masterRequestGet('index_search') -%}
    {%- set allLocales = interface.website.configuration.allLocales -%}
    {%- set defaultLocale = interface.website.configuration.locale -%}
    {%- set stats = domains|transStats -%}

    {%- if granted('ROLE_INTERNAL') -%}
        <div class="d-flex align-items-center flex-wrap gap-2 mb-4">
            <button type="button" class="translation-extract-btn cursor btn-app d-inline-flex align-items-center gap-2" data-domain="only_front">
                <i class="icm-sync-alt"></i><span>{{ "Extraire le front"|trans|raw }}</span>
            </button>
            <button type="button" class="translation-extract-btn cursor btn-app d-inline-flex align-items-center gap-2" data-domain="all">
                <i class="icm-sync-alt"></i><span>{{ "Extraire tout"|trans|raw }}</span>
            </button>
            {%- if not toExtract -%}
                <a href="{{ path('admin_intls_export', { website: websiteId }) }}" class="btn-app d-inline-flex align-items-center gap-2">
                    <i class="icm-upload"></i><span>{{ "Exporter les traductions"|trans|raw }}</span>
                </a>
                <button type="button" class="btn-app d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#import-modal">
                    <i class="icm-download"></i><span>{{ "Importer les traductions"|trans|raw }}</span>
                </button>
                <a class="btn-app d-inline-flex align-items-center gap-2" href="{{ path('admin_translation_cache_clear', { website: websiteId }) }}">
                    <i class="icm-broom"></i><span>{{ "Invalider le cache"|trans|raw }}</span>
                </a>
                <button type="button" class="translation-translate-btn cursor btn-app d-inline-flex align-items-center gap-2"
                        data-csrf="{{ csrf_token('machine_translate') }}"
                        data-confirm-title="{{ "Tout traduire ?"|trans|striptags }}"
                        data-confirm-text="{{ "Les traductions manquantes seront générées automatiquement (à relire avant diffusion)."|trans|striptags }}">
                    <i class="icm-globe"></i><span>{{ "Tout traduire"|trans|raw }}</span>
                </button>
                {%- set newTranslationForm = render_esi(path("admin_translation_new", {website: websiteId()})) -%}
                {%- set importTranslationModal = render_esi(path('admin_intls_import', {website: websiteId()} )) -%}
                {{ newTranslationForm|raw }}
                {{ importTranslationModal|raw }}
            {%- endif -%}
        </div>
    {%- endif -%}

    {%- include 'admin/page/translation/generator.html.twig' -%}

    {%- if not toExtract -%}

        <div id="translations-domains-index">

            <div class="d-flex align-items-center gap-2 mb-4">
                {%- if searchForm -%}
                    {%- include 'admin/core/form/index-search-form.html.twig' with {form: searchForm} -%}
                {%- endif -%}
                {%- set domainsPath = masterRequestGet('domains') ? path('admin_translationdomain_index', {website: website.id})
                    : path('admin_translationdomain_index', {website: website.id, domains: 'admin'}) -%}
                {%- set domainslabel = masterRequestGet('domains') ? "Traductions front"|trans : "Traductions admin"|trans -%}
                <a href="{{ domainsPath }}" class="btn-app d-flex align-items-center ms-auto">
                    <i class="icm-eye"></i><span>{{ domainslabel|raw }}</span>
                </a>
            </div>

            <div id="result" class="position-relative">

                {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'index-preloader', full: true} only -%}

                <div class="table-responsive app-table">
                    <table class="table table-striped responsive-cards">
                        <thead>
                            <tr>
                                <th class="align-middle px-4">{{ "Groupe"|trans|raw }}</th>
                                {%- for transLocale in allLocales -%}
                                    <th class="align-middle px-4">
                                        <div class=" d-flex align-items-center">
                                            {%- if allLocales|length > 1 -%}
                                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=" {{ asset('/medias/icons/flags/'~transLocale~'.svg') }}"
                                                     data-bs-toggle="tooltip" title="{{ languageName(transLocale, app.user.locale) }}"
                                                     class="img-fluid lazy-load float-start me-2" height="14" width="19">
                                            {%- endif -%}
                                            {%- if stats[transLocale] is defined -%}
                                                <span class="d-inline-block fw-500">{{ stats[transLocale]['words'] }} {{ "mots"|trans|raw }}</span>
                                            {%- endif -%}
                                        </div>
                                    </th>
                                {%- endfor -%}
                            </tr>
                        </thead>
                        <tbody>
                            {%- set singularTrans = 'singular'|trans([], 'admin') -%}
                            {%- for entity in pagination -%}
                                {%- set name = 'singular'|trans([], entity.name) and 'singular'|trans([], entity.name) != singularTrans
                                    ? 'singular'|trans([], entity.name) : entity.adminName -%}
                                {%- if name != '_undefined' -%}
                                    <tr class="{% if loop.index is even %}even{% else %}odd{% endif %}">
                                        <td class="align-middle px-4">
                                            <div class="row">
                                                <div class="col-7 my-auto">
                                                    <div class="d-flex align-items-center">
                                                        <span class="domain-label">{{ name }}</span>
                                                        {%- if granted('ROLE_INTERNAL') -%}
                                                            <div class="d-flex gap-2 ms-auto ps-2">
                                                                {%- if entity.forTranslator -%}
                                                                    <span class="btn-icon info small"
                                                                          data-bs-toggle="tooltip"
                                                                          data-tooltip-variant="info"
                                                                          title="{{"Pour le traducteur"|trans|striptags }}">
                                                                        <i class="icm-globe"></i></span>
                                                                {%- endif -%}
                                                                {%- if entity.extract -%}
                                                                    <span class="btn-icon info small"
                                                                          data-bs-toggle="tooltip"
                                                                          data-tooltip-variant="info"
                                                                          title="{{"À exporter"|trans|striptags }}">
                                                                        <i class="icm-upload"></i></span>
                                                                {%- endif -%}
                                                            </div>
                                                        {%- endif -%}
                                                    </div>
                                                </div>
                                                <div class="col-5 text-end">
                                                    <div class="d-flex gap-2">
                                                        {%- if granted('ROLE_INTERNAL') -%}
                                                            <a href="{{ path('admin_translationdomain_edit', {website: websiteId(), translationdomain: entity.id}) }}"
                                                               data-bs-toggle="tooltip" title="{{"Éditer le groupe"|trans|striptags }}"
                                                               class="btn-icon small">
                                                                <i class="icm-pencil-alt"></i>
                                                            </a>
                                                            <button type="button" class="translation-extract-btn btn-icon small cursor"
                                                                    data-bs-toggle="tooltip" title="{{ "Extraire"|trans|striptags }}"
                                                                    aria-label="{{ "Extraire"|trans|striptags }}"
                                                                    data-larges="1"
                                                                    data-domain="{{ entity.name }}">
                                                                <i class="icm-retweet-alt"></i>
                                                            </button>
                                                        {%- endif -%}
                                                        <a href="{{ path('admin_translationsdomain_edit', {website: websiteId(), translationdomain: entity.id}) }}"
                                                           data-bs-toggle="tooltip" title="{{"Éditer les contenus"|trans|striptags }}"
                                                           class="btn-icon small">
                                                            <i class="icm-list-ul"></i>
                                                        </a>
                                                        {%- if granted('ROLE_INTERNAL') -%}
                                                            <a class="btn-icon danger small sa-warning swal-delete-link"
                                                               data-bs-toggle="tooltip" title="{{"Supprimer"|trans|striptags }}"
                                                               href="{{ path('admin_translationsdomain_delete', {website: websiteId(), translationdomain: entity.id}) }}">
                                                                <i class="icm-trash"></i>
                                                            </a>
                                                        {%- endif -%}
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        {%- for transLocale in interface.website.configuration.allLocales -%}
                                            <td class="align-middle px-4">
                                                {%- if stats[entity.name]['units'][transLocale] is defined -%}
                                                    <small>{{ stats[entity.name]['units'][transLocale] }}/{{ stats[entity.name]['units']['count'][transLocale] }} <span class="d-inline-block"> - {{ stats[entity.name][transLocale]['words'] }} {{ 'mots'|trans|raw }}</span></small>
                                                    <div class="progress">
                                                        {%- set percent = stats[entity.name]['units'][transLocale]|percent(stats[entity.name]['units']['count'][transLocale]) -%}
                                                        {%- set color = percent >= 100 ? 'success' : (percent >= 66 ? 'info' : (percent >= 33 ? 'warning' : 'danger')) -%}
                                                        <div class="progress-bar progress-bar-striped bg-{{ color }} wow animated progress-animated" style="width: {{ percent }}%; height:6px;" role="progressbar"></div>
                                                    </div>
                                                {%- else -%}
                                                    <small class="text-warning lh-1 d-inline-block">{{ "Vous devez regénérer les traductions !"|trans|unescape|raw }}</small>
                                                {%- endif -%}
                                            </td>
                                        {%- endfor -%}
                                    </tr>
                                {%- endif -%}
                            {%- endfor -%}
                        </tbody>
                    </table>
                </div>

                {%- include 'admin/core/include/pagination.html.twig' -%}

            </div>
        </div>

    {%- endif -%}

{%- endblock -%}
