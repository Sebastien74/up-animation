{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageTitle = "Site :"|trans~" "~entity.adminName -%}
{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-website', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-website', null,  'admin', {defer: true}) }}
    {{ parent() }}
{%- endblock -%}

{%- set tabs = {
    configuration: {
        title: "Configuration"|trans,
        icon: "cog"
    },
    domains: {
        title: "Domaines"|trans,
        icon: "rss"
    },
    modules: {
        title: "Modules"|trans,
        icon: "sliders-h"
    },
    themes: {
        title: "Thèmes"|trans,
        icon: "atom"
    },
    apis: {
        title: "APIS"|trans,
        icon: "meteor"
    },
    security: {
        title: "Sécurité"|trans,
        icon: "shield-check"
    },
    emails: {
        title: "Emails"|trans,
        icon: "at"
    },
    development: {
        title: "Développement"|trans,
        icon: "code"
    }} -%}

{%- block body -%}
    <div id="website-edition" class="d-inline-block w-100">
        {{ form_start(form, {attr: {novalidate: "novalidate", id: 'website-form'}}) }}
            <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4" role="tablist">
                {%- for tabId, config in tabs -%}
                    <li class="nav-item">
                        <a id="nav-{{ tabId }}-tab" class="btn-app{%- if loop.first -%} active{%- endif -%}" data-bs-toggle="tab" href="#{{ tabId }}" role="tab" aria-selected="{{ loop.first }}">
                            <i class="icm-{{ config.icon }}"></i>
                            {{ config.icon|icon(17, 17, 'dark me-sm-2') }}
                            <span class="d-none d-sm-inline-block">{{ config.title }}</span>
                        </a>
                    </li>
                {%- endfor -%}
            </ul>
            <div class="tab-content">
                {%- for tabId, config in tabs -%}
                    <div class="tab-pane {%- if loop.first -%} active{%- endif -%}" id="{{ tabId }}" role="tabpanel" aria-labelledby="nav-{{ tabId }}-tab">
                        {%- include 'admin/page/website/include/website/'~tabId~'.html.twig' -%}
                    </div>
                {%- endfor -%}
            </div>
            {%- include 'admin/core/form/save/footer-only.html.twig' -%}
        {{ form_end(form) }}
    </div>
{%- endblock -%}
