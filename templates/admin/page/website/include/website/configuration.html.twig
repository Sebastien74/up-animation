{% trans_default_domain 'admin' %}

{% set schemeAndHost = defaultLocale|domain(website) %}

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-cog"></i>{{ "Global"|trans }}</h4>
                <div class="row">
                    {{ form_row(form.adminName) }}
                    {{ form_row(form.slug) }}
                    {{ form_row(form.configuration.charset) }}
                    {{ form_row(form.configuration.cacheExpiration) }}
                    {{ form_row(form.configuration.gdprFrequency) }}
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-copy"></i>{{ "Pages"|trans }}</h4>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="{{ schemeAndHost~"/check.php" }}" target="_blank" class="d-flex align-items-center gap-2" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-shield-check"></i></span>{{ 'Recommandations'|trans }}</a></li>
                    <li><a href="https://validator.schema.org/" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-shield-check"></i></span>{{ 'validator.schema.org'|trans }}</a></li>
                    <li><a href="https://www.serpworx.com/check-security-headers?url={{ app.request.schemeAndHttpHost }}" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-shield-check"></i></span>{{ 'Check security headers'|trans }}</a></li>
                    <li><a href="{{ schemeAndHost~"/phpinfo.php" }}" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-php"></i></span>{{ 'phpinfo.php'|trans }}</a></li>
                    <li><a href="{{ schemeAndHost~"/sitemap.xml?preview=true" }}" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-sitemap"></i></span>{{ 'sitemap.xml'|trans }}</a></li>
                    <li><a href="{{ schemeAndHost~"/robots.txt?preview=true" }}" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-robot"></i></span>{{ 'robots.txt'|trans }}</a></li>
                    <li><a href="/_error/404" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-unlink"></i></span>{{ "Page 404"|trans }}</a></li>
                    <li><a href="https://prompt.agence-felix.fr/security/login" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-alien"></i></span>{{ "Prompt AI"|trans }}</a></li>
                    {% if not website.configuration.onlineStatus %}
                        {% set domain = app.user.locale is defined ? app.user.locale|domain() : null %}
                        {% set scheme = not domain ? path('front_index') : domain %}
                        <li><a href="{{ scheme }}?disabled_ips=true" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-tools"></i></span>{{ "Vérifier la page de maintenance sans les IPS autorisées"|trans }}</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-flag"></i>{{ "Statuts"|trans }}</h4>
                <div class="row">
                    {{ form_row(form.configuration.onlineStatus) }}
                    {{ form_row(form.configuration.asDefault) }}
                    {{ form_row(form.configuration.seoStatus) }}
                    {{ form_row(form.configuration.accessibilityStatus) }}
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-cube"></i>{{ "Éléments"|trans }}</h4>
                <div class="row">
                    {{ form_row(form.configuration.fullWidth) }}
                    {{ form_row(form.configuration.preloader) }}
                    {{ form_row(form.configuration.scrollTopBtn) }}
                    {{ form_row(form.configuration.breadcrumb) }}
                    {{ form_row(form.configuration.subNavigation) }}
                    {{ form_row(form.configuration.progressiveWebApp) }}
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-tools"></i>{{ "Administration"|trans }}</h4>
                <div class="row">
                    {{ form_row(form.configuration.adminAdvertising) }}
                    {{ form_row(form.configuration.collapsedAdminTrees) }}
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-globe"></i>{{ "Internationalisation"|trans }}</h4>
                <div class="row">
                    {{ form_row(form.configuration.locale) }}
                    {{ form_row(form.configuration.locales) }}
                    {{ form_row(form.configuration.onlineLocales) }}
                    {{ form_row(form.configuration.transDomains) }}
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-photo-video"></i>{{ "Médias"|trans }}</h4>
                <div class="row">
                    {{ form_row(form.configuration.mediasSecondary) }}
                    {{ form_row(form.configuration.duplicateMediasStatus) }}
                    {{ form_row(form.configuration.mediasCategoriesStatus) }}
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body pb-2">
                <h4 class="main-subtitle"><i class="icm-burn"></i>{{ "Audit"|trans }}</h4>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="https://gtmetrix.com" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-tachometer-alt-slowest"></i></span>{{ 'GTmetrix'|trans }}</a></li>
                    <li><a href="https://web.dev/measure/" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-tachometer-alt-slowest"></i></span>{{ 'Measure web.dev'|trans }}</a></li>
                    <li><a href="https://validator.w3.org" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-file-code"></i></span>{{ 'W3C Validation'|trans }}</a></li>
                    <li><a href="https://developers.google.com/search/reference/overview" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-chart-line"></i></span>{{ 'Microdata'|trans }}</a></li>
                    <li><a href="https://search.google.com/test/rich-results" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-chart-line"></i></span>{{ 'Microdata Validator'|trans }}</a></li>
                    <li><a href="https://search.google.com/structured-data/testing-tool?utm_campaign=devsite&utm_medium=jsonld&utm_source=paywalled-content" target="_blank" class="d-flex align-items-center gap-2"><span class="btn-icon small"><i class="icm-chart-line"></i></span>{{ 'Microdata tests'|trans }}</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
