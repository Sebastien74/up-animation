{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageTitle = "Élements de site"|trans -%}
{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-icons-library', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {{ form_start(form, {attr: {id: "website-elements-form", class: "reveal", novalidate: "novalidate", action: app.request.uri, id: 'form-'~entity.id}}) }}

        <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4 flex-wrap" role="tablist">
            <li class="nav-item">
                <a class="btn-app active d-inline-flex align-items-center gap-2" id="media-tab" data-bs-toggle="tab" href="#media" role="tab" aria-controls="media" aria-selected="true">
                    <i class="icm-photo-video" aria-hidden="true"></i><span>{{ "Médias"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app d-inline-flex align-items-center gap-2" id="social-tab" data-bs-toggle="tab" href="#social" role="tab" aria-controls="social" aria-selected="false">
                    <i class="icm-share-alt" aria-hidden="true"></i><span>{{ "Réseaux sociaux"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app d-inline-flex align-items-center gap-2" id="color-tab" data-bs-toggle="tab" href="#color" role="tab" aria-controls="color" aria-selected="false">
                    <i class="icm-palette" aria-hidden="true"></i><span>{{ "Couleurs"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app d-inline-flex align-items-center gap-2" id="css-classes-tab" data-bs-toggle="tab" href="#css-classes" role="tab" aria-controls="css-classes" aria-selected="false">
                    <i class="icm-paint-brush" aria-hidden="true"></i><span>{{ "Classes personnalisées / Style"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app d-inline-flex align-items-center gap-2" id="libraries-tab" data-bs-toggle="tab" href="#libraries" role="tab" aria-controls="libraries" aria-selected="false">
                    <i class="icm-books" aria-hidden="true"></i><span>{{ "Librairies"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app d-inline-flex align-items-center gap-2" id="others-tab" data-bs-toggle="tab" href="#others" role="tab" aria-controls="others" aria-selected="false">
                    <i class="icm-cog" aria-hidden="true"></i><span>{{ "Autres"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app d-inline-flex align-items-center gap-2" href="https://realfavicongenerator.net/" target="_blank" rel="noopener noreferrer">
                    <i class="icm-atom-alt" aria-hidden="true"></i><span class="d-none d-sm-inline-block">{{ "Générateur de favicons"|trans|raw }}</span>
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="media" role="tabpanel" aria-labelledby="media-tab">
                {%- include 'admin/page/website/include/configuration/medias.html.twig' -%}
            </div>
            <div class="tab-pane fade" id="social" role="tabpanel" aria-labelledby="social-tab">
                {%- include 'admin/page/website/include/configuration/social-network.html.twig' -%}
            </div>
            <div class="tab-pane fade" id="color" role="tabpanel" aria-labelledby="color-tab">
                {%- include 'admin/page/website/include/configuration/colors.html.twig' -%}
            </div>
            <div class="tab-pane fade" id="css-classes" role="tabpanel" aria-labelledby="css-classes-tab">
                {%- include 'admin/page/website/include/configuration/style.html.twig' -%}
            </div>
            <div class="tab-pane fade" id="libraries" role="tabpanel" aria-labelledby="libraries-tab">
                {%- include 'admin/page/website/include/configuration/libraries.html.twig' -%}
            </div>
            <div class="tab-pane fade" id="others" role="tabpanel" aria-labelledby="others-tab">
                {%- include 'admin/page/website/include/configuration/others.html.twig' -%}
            </div>
        </div>

        {%- include 'admin/core/form/save/footer-only.html.twig' -%}

    {{ form_end(form) }}

{%- endblock -%}