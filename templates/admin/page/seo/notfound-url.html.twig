{% extends "admin/base.html.twig" %}

{% trans_default_domain 'admin' %}

{% block title %}{{ "Erreurs 404"|trans|htmlEntities }}{% endblock %}
{% block pageTitle %}{{ "Erreurs 404"|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}

    {% set pages = [
        { title: 'Front'|trans, type: 'front', category: 'url', count: all['front']['url']|length },
        { title: 'Front ressources'|trans, type: 'front', category: 'resource', count: all['front']['resource']|length },
        { title: 'Admin'|trans, type: 'admin', category: 'url', count: all['admin']['url']|length },
        { title: 'Admin ressources'|trans, type: 'admin', category: 'resource', count: all['admin']['resource']|length }
    ] %}

    <div id="notfound-urls-index" class="card d-inline-block w-100 border-0">

        <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4" role="tablist">
            {% for page in pages %}
                {% if granted('ROLE_INTERNAL') or loop.first %}
                    <li class="nav-item">
                        {% set active = page.type == type and page.category == category %}
                        <a href="{{ path("admin_notfoundurl_index", {website: websiteId(), type: page.type, category: page.category}) }}"
                           class="btn-app{% if active %} active{% endif %}">
                            <i class="icm-info"></i><span>{{ page.title }}</span>
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
            {% if 'delete'|moduleActive(configuration) and pagination|length > 0 %}
                <li class="nav-item ms-auto">
                    <a href="{{ path("admin_notfoundurl_delete_all", {website: websiteId(), type: type, category: category}) }}"
                       class="btn-app danger swal-delete-link">
                        <i class="icm-trash"></i><span>{{ 'Tout supprimer'|trans }}</span>
                    </a>
                </li>
            {% endif %}
        </ul>

        <div class="table-responsive app-table">
            <table class="table table-striped table-bordered table-dark responsive-cards mb-0">
                <thead>
                    <tr>
                        <th class="align-middle px-4">{{ "Jour"|trans }}</th>
                        <th class="align-middle column-url px-4">{{ "URL"|trans }}</th>
                        <th class="align-middle text-end px-4">{{ "Actions"|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in pagination %}
                        <tr id="entity-row-{{ entity.id }}">
                            <td class="align-middle px-4" data-label="{{ "Jour"|trans }}">{{ entity.createdAt|format_datetime(pattern='cccc dd MMMM Y HH:mm', locale=app.request.locale) }}</td>
                            <td class="align-middle px-4" data-label="{{ "URL"|trans }}">{{ entity.url }}</td>
                            <td class="align-middle text-end px-4" data-label="{{ "Actions"|trans }}">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    {{ render_esi(path('admin_notfoundurl_redirection', {website: websiteId(), notfoundUrl: entity.id} )) }}
                                    {% if routeExist('admin_notfoundurl_delete') and 'delete'|moduleActive(configuration) %}
                                        <a href="{{ path('admin_notfoundurl_delete', {website: websiteId(), notfoundurl: entity.id}) }}"
                                           data-bs-toggle="tooltip" title="{{ "Supprimer"|trans|striptags }}"
                                           data-target="#entity-row-{{ entity.id }}"
                                           class="btn-icon small danger swal-delete-link">
                                            <i class="icm-trash"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'admin/core/include/pagination.html.twig' %}

    </div>



{% endblock %}