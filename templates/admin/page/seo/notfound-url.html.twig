{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- block title -%}{{ "Erreurs 404"|trans|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ "Erreurs 404"|trans|raw }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {%- set pages = [
        { title: 'Front'|trans, type: 'front', category: 'url', count: all['front']['url']|length },
        { title: 'Front ressources'|trans, type: 'front', category: 'resource', count: all['front']['resource']|length },
        { title: 'refonte-admin'|trans, type: 'admin', category: 'url', count: all['admin']['url']|length },
        { title: 'refonte-admin ressources'|trans, type: 'admin', category: 'resource', count: all['admin']['resource']|length }
    ] -%}

    {%- set currentCount = all[type][category] is defined ? all[type][category]|length : 0 -%}

    <div id="notfound-urls-index">

        <section class="feature-panel panel-split mb-4 reveal {{ currentCount > 0 ? 'is-warning' : 'is-clean' }}">
            <div class="panel-left">
                <span class="panel-tag">{{ "404"|trans|raw }}</span>
                <span class="panel-number">{{ currentCount }}</span>
                <span class="panel-unit">{{ currentCount > 1 ? "erreurs"|trans|raw : "erreur"|trans|raw }}</span>
            </div>
            <div class="panel-body">
                <h2 class="panel-headline">
                    {%- if currentCount > 0 -%}
                        {{ "Erreurs 404 à traiter."|trans|raw }}
                    {%- else -%}
                        {{ "Aucune erreur détectée."|trans|raw }}
                    {%- endif -%}
                </h2>
                <p class="panel-desc">
                    {%- if currentCount > 0 -%}
                        {{ "Identifiez les URLs introuvables pour mettre en place les redirections nécessaires et préserver le SEO."|trans|raw }}
                    {%- else -%}
                        {{ "Aucune URL introuvable sur cette catégorie. Le suivi reste actif."|trans|raw }}
                    {%- endif -%}
                </p>
            </div>
        </section>

        <div class="d-flex gap-2 flex-wrap mb-4">
            <div class="nav nav-tabs gap-2 border-0 me-auto" role="tablist">
                {%- for page in pages -%}
                    {%- if granted('ROLE_INTERNAL') or loop.first -%}
                        {%- set active = page.type == type and page.category == category -%}
                        <a href="{{ path("admin_notfoundurl_index", {website: websiteId(), type: page.type, category: page.category}) }}"
                           class="btn-app {% if active %} active{% endif %}">
                            <i class="icm-info"></i><span>{{ page.title }}</span>
                        </a>
                    {%- endif -%}
                {%- endfor -%}
            </div>
            {%- if 'delete'|moduleActive(configuration) and pagination|length > 0 -%}
                <a href="{{ path("admin_notfoundurl_delete_all", {website: websiteId(), type: type, category: category}) }}"
                   class="btn-app danger swal-delete-link">
                    <i class="icm-trash"></i><span>{{ 'Tout supprimer'|trans|raw }}</span>
                </a>
            {%- endif -%}
        </div>

        <div class="table-responsive app-table">
            <table class="table table-striped responsive-cards mb-0">
                <thead>
                    <tr>
                        <th class="align-middle px-4">{{ "Jour"|trans|raw }}</th>
                        <th class="align-middle column-url px-4">{{ "URL"|trans|raw }}</th>
                        <th class="align-middle text-end px-4">{{ "Actions"|trans|raw }}</th>
                    </tr>
                </thead>
                <tbody>
                    {%- for entity in pagination -%}
                        <tr id="entity-row-{{ entity.id }}">
                            <td class="align-middle px-4" data-label="{{"Jour"|trans|raw }}">{{ entity.createdAt|format_datetime(pattern='cccc dd MMMM Y HH:mm', locale=app.request.locale) }}</td>
                            <td class="align-middle px-4" data-label="{{"URL"|trans|raw }}">{{ entity.url }}</td>
                            <td class="align-middle text-end px-4" data-label="{{"Actions"|trans|raw }}">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    {{ render_esi(path('admin_notfoundurl_redirection', {website: websiteId(), notfoundUrl: entity.id} )) }}
                                    {%- if routeExist('admin_notfoundurl_delete') and 'delete'|moduleActive(configuration) -%}
                                        <a href="{{ path('admin_notfoundurl_delete', {website: websiteId(), notfoundurl: entity.id}) }}"
                                           data-bs-toggle="tooltip" title="{{"Supprimer"|trans|striptags }}"
                                           data-target="#entity-row-{{ entity.id }}"
                                           class="btn-icon small danger swal-delete-link">
                                            <i class="icm-trash"></i>
                                        </a>
                                    {%- endif -%}
                                </div>
                            </td>
                        </tr>
                    {%- else -%}
                        <tr>
                            <td colspan="12" class="px-4">
                                <div class="py-2 d-flex align-items-center justify-content-center gap-2">
                                    <i class="btn-icon info icm-info"></i>{{ "Aucun résultat"|trans|raw }}
                                </div>
                            </td>
                        </tr>
                    {%- endfor -%}
                </tbody>
            </table>
        </div>

        {%- include 'admin/core/include/pagination.html.twig' -%}

    </div>

{%- endblock -%}