{%- trans_default_domain 'admin' -%}

<div id="edition-container" class="card">

    <div class="card-body">

        <h5 class="main-subtitle"><i class="icm-code"></i>{{ "Balises métas"|trans|raw }}</h5>

        {{ form_start(form, {attr: {
            id: 'seo-form-'~entity.id,
            novalidate: "novalidate"
        }}) }}

            <div class="row">
                {{ form_row(form.metaTitle) }}
                {{ form_row(form.metaTitleSecond) }}
                {{ form_row(form.metaDescription) }}
                {{ form_row(form.footerDescription) }}
                {{ form_row(form.noAfterDash) }}
            </div>

            <div class="row m-0">
                <div class="col-md-8 ps-0"><button class="autocomplete btn-app info w-100 mb-3"><i class="icm-magic"></i><span>{{ "Saisie automatique"|trans|raw }}</span></button></div>
                <div class="col-md-4 pe-0"><button class="resetautocomplete btn-app secondary w-100 mb-3"><i class="icm-retweet"></i><span>{{ "Réinitialiser"|trans|raw }}</span></button></div>
            </div>

            <div class="row">
                {{ form_row(form.metaOgTitle) }}
                {{ form_row(form.metaOgDescription) }}
            </div>

            <div class="form-group text-end mb-0 mt-3">
                <button type="submit" id="submit-seo" class="btn-app info w-100"><i class="icm-save"></i><span>{{ "Enregistrer"|trans|raw }}</span></button>
            </div>

        {{ form_end(form) }}

    </div>

</div>
