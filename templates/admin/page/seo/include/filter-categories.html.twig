{%- trans_default_domain 'admin' -%}

{%- set currentCategory = currentCategory is not defined or not currentCategory ? 'page' : currentCategory -%}
{%- set categoriesCount = entities|length + (models is defined ? 1 : 0) -%}

{# Maps each interface name to an Icomoon glyph; defaults to a neutral tag for unknown categories. #}
{%- set categoryIcons = {
    'page': 'file-alt',
    'agenda': 'calendar-alt',
    'agendainformation': 'calendar-alt',
    'agendaperiod': 'calendar-alt',
    'catalog': 'shopping-cart',
    'catalogcategory': 'folder',
    'catalogsubcategory': 'folder',
    'catalogproduct': 'tag',
    'cataloglisting': 'list-ul',
    'productteaser': 'tag',
    'newscast': 'newspaper',
    'newscastcategory': 'folder',
    'newscastlisting': 'list-ul',
    'newscasttag': 'tag',
    'newscastteaser': 'newspaper',
    'gallery': 'images',
    'gallerycategory': 'folder',
    'gallerylisting': 'list-ul',
    'galleryteaser': 'images',
    'portfolio': 'briefcase',
    'portfoliocard': 'briefcase',
    'portfoliocategory': 'folder',
    'portfoliolisting': 'list-ul',
    'portfolioteaser': 'briefcase',
    'recruitmentjob': 'user-tie',
    'recruitmentcategory': 'folder',
    'recruitmentcontract': 'file-alt',
    'recruitmentlisting': 'list-ul',
    'contact': 'envelope',
    'faq': 'question-circle',
    'faqquestion': 'question-circle',
    'map': 'map-marked-alt',
    'mapcategory': 'folder',
    'mappoint': 'map-marked-alt',
    'form': 'clipboard-list',
    'formcontact': 'envelope',
    'formcalendar': 'calendar-alt',
    'stepform': 'clipboard-list',
    'contactstepform': 'clipboard-list',
    'timelinestep': 'history',
    'slider': 'images',
    'search': 'search',
    'securitymessage': 'bullhorn',
    'securitygroup': 'users',
    'securitycompany': 'briefcase',
    'gdprcookie': 'shield-alt',
    'gdprcategory': 'shield-alt',
    'gdprgroup': 'shield-alt',
    'campaign': 'bullhorn',
    'newsletteremail': 'envelope',
} -%}

<div class="section-label mb-3">
    <span class="label-line" aria-hidden="true"></span>
    <span class="label-text">{{ "Catégories"|trans|raw }}</span>
    <span class="label-aside">{{ categoriesCount }}&nbsp;{{ categoriesCount > 1 ? "types"|trans|raw : "type"|trans|raw }}</span>
</div>

<div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
    {%- for category, item in entities -%}
        {%- set label = item['main'][1].classname is defined ? item['main'][1].classname : (item[0].classname is defined ? item[0].classname : null) -%}
        {%- set categoryIcon = categoryIcons[category]|default('tag') -%}
        <a id="v-pills-{{ category }}-tab"
           class="btn-app small {% if currentCategory == category %} active{% endif %}"
           data-bs-toggle="pill"
           href="#v-pills-{{ category }}"
           role="tab"
           aria-controls="v-pills-{{ category }}"
           aria-selected="false">
            {%- set entityDomain = 'entity_'~category -%}
            {%- set label = 'plural'|trans([], entityDomain) and 'plural'|trans([], entityDomain) != 'plural'
                ? 'plural'|trans([], entityDomain) : label -%}
            <i class="icm-{{ categoryIcon }}"></i><span>{{ label }}</span>
        </a>
    {%- endfor -%}
    {%- if models is defined -%}
        <a id="v-pills-models-tab"
           class="btn-app small {% if currentCategory == 'models' %} active{% endif %}"
           data-bs-toggle="pill"
           href="#v-pills-models"
           role="tab"
           aria-controls="v-pills-models"
           aria-selected="false">
            <i class="icm-layer-group"></i><span>{{ "Modèles"|trans|raw }}</span>
        </a>
    {%- endif -%}
</div>

<hr>

<div class="tab-content" id="v-pills-tab-tree">

    {%- for category, item in entities -%}
        <div class="tab-pane fade no-border{% if currentCategory == category %} show active{% endif %}" id="v-pills-{{ category }}" role="tabpanel" aria-labelledby="v-pills-{{ category }}-tab">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <form role="search" class="seo-search d-inline-block w-100 me-2">
                    <div class="input-group">
                        <span class="input-group-text"><i class="icm-search"></i></span>
                        <input placeholder="{{"Rechercher"|trans|raw }}" class="form-control" type="text" data-target=".entities-list">
                    </div>
                </form>
                <div class="tree-toggle-actions d-flex align-items-center">
                    <span class="expand-all-entities" data-bs-toggle="tooltip" title="{{"Tout afficher"|trans|raw }}">
                        <i class="icm-arrow-alt-to-bottom"></i>
                    </span>
                    <span class="collapse-all-entities d-none" data-bs-toggle="tooltip" title="{{"Tout cacher"|trans|raw }}">
                        <i class="icm-arrow-alt-to-top"></i>
                    </span>
                </div>
            </div>
            <ul class="entities-list tree-list ps-0 list-unstyled">
                {%- set items = item['main'] is defined ? item['main'] : item -%}
                {%- for itemEntity in items -%}
                    {%- include 'admin/page/seo/include/link-element.html.twig' with {config: itemEntity, tree: item, currentUrl: currentUrl, entitylocale: entitylocale} only -%}
                {%- endfor -%}
            </ul>
        </div>
    {%- endfor -%}

    {%- set isModel = currentCategory == 'models' -%}

    {%- if models is defined -%}
        <div class="tab-pane fade no-border{% if isModel %} show active{% endif %}" id="v-pills-models" role="tabpanel" aria-labelledby="v-pills-models-tab">
            <form role="search" class="seo-search d-inline-block w-100 mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="icm-search"></i></span>
                    <input placeholder="{{"Rechercher"|trans|raw }}" class="form-control" type="text" data-target=".models-list">
                </div>
            </form>
            <ul class="models-list tree-list">
                {%- for model in models -%}
                    <li class="item">
                        <span class="item-link">
                            <a href="{{ path('admin_seo_model_edit', {website: websiteId(), model: model.id, entitylocale: entitylocale}) }}"
                               class="link-item {% if isModel and entity.id == model.id %} active bold{% endif %}">
                                {%- set modelInterface = model.className|interface -%}
                                {%- set entityDomain = 'entity_'~modelInterface.name -%}
                                {%- set label = 'plural'|trans([], entityDomain) and 'plural'|trans([], entityDomain) != 'plural'
                                    ? 'plural'|trans([], entityDomain) : model.className -%}
                                {%- if model.adminName -%}
                                    {%- set label = label~" ("~model.adminName~")" -%}
                                {%- endif -%}
                                {{ label|raw }}
                            </a>
                        </span>
                    </li>
                {%- endfor -%}
            </ul>
        </div>
    {%- endif -%}

</div>