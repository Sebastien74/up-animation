{%- trans_default_domain 'admin' -%}

<div id="edition-container" class="card">

    <div class="card-body">

        <h5 class="main-subtitle"><i class="icm-code"></i>{{ "Balises métas"|trans|raw }}</h5>

        {{ form_start(form, {attr: {
            id: 'seo-form-'~entity.id,
            novalidate: "novalidate"
        }}) }}

            <div class="row">
                {{ form_row(form.metaTitle) }}
                {{ form_row(form.metaDescription) }}
                {{ form_row(form.metaCanonical) }}
                {{ form_row(form.url.asIndex) }}
                {{ form_row(form.url.hideInSitemap) }}
            </div>

            <h4 class="main-subtitle cursor w-100 collapsed" data-bs-toggle="collapse" href="#collapse-open-graph" role="button" aria-expanded="false" aria-controls="collapse-open-graph">
                <i class="icm-share-alt"></i>{{ "Open graph tags"|trans|raw }}
                <i class="icm-chevron-down ms-auto small"></i>
            </h4>

            <div class="collapse col-12 collapseOG" id="collapse-open-graph">
                <div class="row pt-3">
                    <div class="col-md-8">
                        <button class="autocomplete btn-app info w-100 mb-3"><i class="icm-magic"></i><span>{{ "Saisie automatique"|trans|raw }}</span></button>
                    </div>
                    <div class="col-md-4">
                        <button class="resetautocomplete btn-app secondary w-100 mb-3"><i class="icm-retweet"></i><span>{{ "Réinitialiser"|trans|raw }}</span></button>
                    </div>
                    <div class="row pt-3">
                        {{ form_row(form.metaOgTitle) }}
                        {{ form_row(form.metaOgDescription) }}
                        {{ form_row(form.metaOgTwitterCard) }}
                        {{ form_row(form.metaOgTwitterHandle) }}
                        <div class="col-12">
                            {%- include 'admin/page/media/modal-btn.html.twig' with {classname: class} -%}
                            {{ form_row(form.mediaRelation.media.uploadedFile) }}
                            <div class="d-none">
                                {{ form_row(form.mediaRelation.shape) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="main-subtitle cursor w-100 collapsed" data-bs-toggle="collapse" href="#collapse-url" role="button" aria-expanded="false" aria-controls="collapse-url">
                <i class="icm-link"></i>{{ "URL"|trans|raw }}
                <i class="icm-chevron-down ms-auto small"></i>
            </h4>

            <div class="collapse" id="collapse-url">
                <div class="row pt-3">
                    {{ form_row(form.url.code) }}
                    {{ form_row(form.url.online) }}
                    {%- if form.url.indexPage is defined -%}
                        {{ form_row(form.url.indexPage) }}
                    {%- endif -%}
                </div>
            </div>

            <h4 class="main-subtitle cursor w-100 collapsed" data-bs-toggle="collapse" href="#collapse-options" role="button" aria-expanded="false" aria-controls="collapse-options">
                <i class="icm-plus-circle"></i>{{ "Options"|trans|raw }}
                <i class="icm-chevron-down ms-auto small"></i>
            </h4>

            <div class="collapse col-12" id="collapse-options">
                <div class="row pt-3">
                    {{ form_row(form.metaTitleSecond) }}
                    {{ form_row(form.author) }}
                    {{ form_row(form.footerDescription) }}
                    {{ form_row(form.breadcrumbTitle) }}
                    {{ form_row(form.noAfterDash) }}
                </div>
            </div>

            {%- if website.seoConfiguration.microData -%}

                <h4 class="main-subtitle cursor w-100 collapsed" data-bs-toggle="collapse" href="#collapse-microdata" role="button" aria-expanded="false" aria-controls="collapse-microdata">
                    <i class="icm-server"></i>{{ "Microdata"|trans|raw }}
                    <i class="icm-chevron-down ms-auto small"></i>
                </h4>

                <div class="collapse col-12" id="collapse-microdata">
                    <div class="row pt-3">
                        {{ form_row(form.authorType) }}
                        {{ form_row(form.metadata) }}
                    </div>
                </div>

            {%- endif -%}

            <div class="form-group text-end mb-0 mt-3">
                <button type="submit" id="submit-seo" class="btn-app info w-100"><i class="icm-save"></i><span>{{ "Enregistrer"|trans|raw }}</span></button>
            </div>

        {{ form_end(form) }}

    </div>

</div>

