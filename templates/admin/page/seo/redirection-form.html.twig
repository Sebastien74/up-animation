{%- trans_default_domain 'admin' -%}

{%- set configuration = website.configuration -%}
{%- set defaultLocale = configuration.locale -%}
{%- set allLocales = configuration.allLocales -%}

<tr id="entity-row-{{ entity.id }}">
    {{ form_start(form, {attr: {
        novalidate: "novalidate",
        action: path('admin_redirection_form', {website: websiteId(), redirection: entity.id}),
        id: 'redirection-form-'~entity.id
    }}) }}
        <td id="group-locale-{{ entity.id }}" class="col-locale refresh-group{%- if allLocales|length <= 1 -%} d-none{% endif %}">
            {{ form_row(form.locale, {id: 'redirection_locale_'~entity.id}) }}
        </td>
        <td id="group-old-{{ entity.id }}" class="refresh-group align-middle">
            {{ form_row(form.old, {id: 'redirection_locale_'~entity.id}) }}
        </td>
        <td id="group-new-{{ entity.id }}" class="refresh-group align-middle">
            {{ form_row(form.new, {id: 'redirection_locale_'~entity.id}) }}
        </td>
        <td class="align-middle text-end actions">
            <button type="submit" class="btn-app ajax-save-row"
                    data-form-id="redirection-form-{{ entity.id }}"
                    aria-label="{{ "Enregistrer"|trans|striptags }}">
                <i class="icm-save"></i>
                <i class="icm-spinner-third"></i>
            </button>
            {%- if 'delete'|moduleActive(configuration) -%}
                <a href="{{ path('admin_redirection_delete', {website: websiteId(), redirection: entity.id}) }}"
                   data-bs-toggle="tooltip" title="{{ "Supprimer"|trans|striptags }}"
                   aria-label="{{ "Supprimer"|trans|striptags }}"
                   data-target="#entity-row-{{ entity.id }}"
                   class="swal-delete-link">
                    <i class="icm-trash ms-3"></i>
                </a>
            {%- endif -%}
            <div class="d-none">{{ form_rest(form) }}</div>
        </td>
    {{ form_end(form) }}
</tr>