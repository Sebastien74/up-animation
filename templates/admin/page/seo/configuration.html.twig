{% extends "admin/base.html.twig" %}

{% trans_default_domain 'admin' %}

{% set pageTitle = "Configuration"|trans %}
{% block title %}{{ pageTitle|htmlEntities }}{% endblock %}
{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}

    {{ form_start(form, {attr: {novalidate: "novalidate", action: app.request.uri, id: 'form-'~entity.id}}) }}
        <div id="edit-form-{{ interface.name }}" class="card radius-top">
            <div class="card-body radius-top p-0">
                <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4" role="tablist">
                    <li class="nav-item">
                        <a class="btn-app active" id="nav-seo-tab" data-bs-toggle="tab" href="#seo" role="tab" aria-selected="true">
                            <i class="icm-chart-line"></i><span>{{ 'Référencement'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn-app" id="nav-social-tab" data-bs-toggle="tab" href="#social" role="tab" aria-selected="false">
                            <i class="icm-share-alt"></i><span>{{ 'Réseaux sociaux'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        {% set sitemap = defaultLocale|domain~"/sitemap.xml?preview=true" %}
                        <a href="{{ sitemap }}" target="_blank" class="btn-app">
                            <i class="icm-sitemap"></i><span>{{ 'sitemap.xml'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        {% set robots = defaultLocale|domain~"/robots.txt?preview=true" %}
                        <a href="{{ robots }}" target="_blank" class="btn-app">
                            <i class="icm-robot"></i><span>{{ 'robots.txt'|trans }}</span>
                        </a>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active pt-2" id="seo" role="tabpanel" aria-labelledby="nav-seo-tab">
                        {% include 'admin/page/seo/include/configuration.html.twig' %}
                    </div>
                    <div class="tab-pane fade pt-2" id="social" role="tabpanel" aria-labelledby="nav-social-tab">
                        {% include 'admin/page/seo/include/social-network.html.twig' with {socialsNetworks: form.website.information.socialNetworks} %}
                    </div>
                </div>
                {% include 'admin/core/form/save/footer-only.html.twig' %}
            </div>
        </div>
    {{ form_end(form) }}

{% endblock %}