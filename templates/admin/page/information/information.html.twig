{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set transDomain = interface.name is defined and interface.name
    ? 'entity_'~interface.name : null -%}

{%- if pageTitle is not defined or pageTitle is defined and not pageTitle -%}
    {%- set title = 'singular'|trans([], transDomain) and 'singular'|trans([], transDomain) != 'singular'
        ? 'singular'|trans([], transDomain) : 'Édition'|trans~" "~interface.name -%}
    {%- set pageTitle = entity.adminName is defined and entity.adminName ? title~' : '~entity.adminName : title -%}
{%- endif -%}

{%- set activeTab = masterRequestGet('tab') ? masterRequestGet('tab') : 'description' -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}

    {{ form_start(form, {attr: {novalidate: "novalidate", action: app.request.uri, id: 'form-'~interface.name}}) }}

        <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4" role="tablist">
            <li class="nav-item">
                <a class="btn-app {% if activeTab == 'description' %} active{% endif %}" id="description-tab" data-bs-toggle="tab" href="#description" role="tab" aria-controls="description" aria-selected="true">
                    <i class="icm-align-center"></i><span>{{ "Descriptions"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app {% if activeTab == 'phones' %} active{% endif %}" id="phones-tab" data-bs-toggle="tab" href="#phones" role="tab" aria-controls="phones" aria-selected="false">
                    <i class="icm-phone"></i><span>{{ "Numéros de téléphone"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app {% if activeTab == 'emails' %} active{% endif %}" id="emails-tab" data-bs-toggle="tab" href="#emails" role="tab" aria-controls="emails" aria-selected="false">
                    <i class="icm-at"></i><span>{{ "E-mails"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app {% if activeTab == 'addresses' %} active{% endif %}" id="addresses-tab" data-bs-toggle="tab" href="#addresses" role="tab" aria-controls="addresses" aria-selected="false">
                    <i class="icm-map-marked"></i><span>{{ "Adresses"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app {% if activeTab == 'networks' %} active{% endif %}" id="networks-tab" data-bs-toggle="tab" href="#networks" role="tab" aria-controls="networks" aria-selected="false">
                    <i class="icm-rss"></i><span>{{ "Réseaux sociaux"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="btn-app {% if activeTab == 'legal-notice' %} active{% endif %}" id="legal-notice-tab" data-bs-toggle="tab" href="#legal-notice" role="tab" aria-controls="legal-notice" aria-selected="false">
                    <i class="icm-balance-scale-left"></i><span>{{ "Mentions légales"|trans|raw }}</span>
                </a>
            </li>
            <li class="nav-item ms-auto">
                <a class="btn-app active">
                    <i class="icm-globe-stand"></i>{{ "Votre IP :"|trans|raw }}
                    <span class="badge ip-badge d-flex align-items-center justify-content-center">{{ currentIP() }}</span>
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade{% if activeTab == 'description' %} show active{% endif %}" id="description" role="tabpanel" aria-labelledby="description-tab">
                {%- include 'admin/core/form/edit-fields-base.html.twig' with {
                    excludes: ['phones', 'emails', 'addresses', 'socialNetworks', 'legals', 'save'],
                    form: form,
                    entity: entity,
                    classname: interface.classname
                } only -%}
            </div>
            <div class="tab-pane fade{% if activeTab == 'phones' %} show active{% endif %}" id="phones" role="tabpanel" aria-labelledby="phones-tab">
                {%- include 'admin/core/form/edit-fields-base.html.twig' with {
                    excludes: ['intls', 'emails', 'addresses', 'socialNetworks', 'legals', 'save'],
                    form: form,
                    entity: entity,
                    classname: interface.classname
                } only -%}
            </div>
            <div class="tab-pane fade{% if activeTab == 'emails' %} show active{% endif %}" id="emails" role="tabpanel" aria-labelledby="emails-tab">
                {%- include 'admin/core/form/edit-fields-base.html.twig' with {
                    excludes: ['intls', 'phones', 'addresses', 'socialNetworks', 'legals', 'save'],
                    form: form,
                    entity: entity,
                    classname: interface.classname
                } only -%}
            </div>
            <div class="tab-pane fade{% if activeTab == 'addresses' %} show active{% endif %}" id="addresses" role="tabpanel" aria-labelledby="addresses-tab">
                {%- include 'admin/core/form/edit-fields-base.html.twig' with {
                    excludes: ['intls', 'phones', 'socialNetworks', 'emails', 'legals', 'save'],
                    form: form,
                    entity: entity,
                    classname: interface.classname
                } only -%}
            </div>
            <div class="tab-pane fade{% if activeTab == 'networks' %} show active{% endif %}" id="networks" role="tabpanel" aria-labelledby="networks-tab">
                {%- include 'admin/page/information/social-network.html.twig' with {socialsNetworks: form.socialNetworks} -%}
            </div>
            <div class="tab-pane fade{% if activeTab == 'legal-notice' %} show active{% endif %}" id="legal-notice" role="tabpanel" aria-labelledby="legal-notice-tab">
                {%- include 'admin/core/form/edit-fields-base.html.twig' with {
                    excludes: ['intls', 'phones', 'emails', 'addresses', 'socialNetworks', 'save'],
                    form: form,
                    entity: entity,
                    classname: interface.classname
                } only -%}
            </div>
        </div>

        {%- include 'admin/core/form/save/footer-only.html.twig' -%}

    {{ form_end(form) }}

{%- endblock -%}