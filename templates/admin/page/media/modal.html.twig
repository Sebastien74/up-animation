{%- trans_default_domain 'admin' -%}

{%- set asCopy = asCopy is defined ? asCopy : false -%}

<div id="medias-library-modal"
     class="modal fade"
     data-type="{{ type }}"
     tabindex="-1" role="dialog"
     aria-labelledby="medias-library-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xxl" role="document">
        <div class="modal-content border refer-preloader pb-3">
            {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'modal-preloader', full: true} only -%}
            <div class="d-none">
                {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'medias-preloader', full: true} only -%}
            </div>
            <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                <span class="modal-icon w-100">
                    <span class="icon-wrap">
                        <i class="icm-images"></i>
                    </span>
                </span>
                <h2 id="medias-library-modal-label" class="modal-title fw-bold mt-3 mb-0">{{ "Choisir dans la bibliothèque"|trans|raw }}</h2>
                <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                    <i class="icm-times"></i>
                </button>
            </div>
            <div class="modal-body px-3 px-md-5">
                <div class="row text-center mx-auto justify-content-center mb-4">
                    {%- include 'admin/page/media/search.html.twig' with {form: form} only -%}
                </div>
                <div class="row g-3">
                    <div id="folders-col" class="col-12 col-md-4 pe-md-4">
                        <div id="root-btn-wrap" class="position-relative d-flex align-items-center flex-wrap gap-2 mb-3">
                            {%- set collapsedAdminTrees = configuration.entity.collapsedAdminTrees is defined
                                ? configuration.entity.collapsedAdminTrees : website().entity.configuration.collapsedAdminTrees -%}
                            <button type="button" id="nestable-expand-all" class="btn-icon info-lighten cursor{% if not collapsedAdminTrees %} d-none{% endif %}"
                                    data-bs-toggle="tooltip" title="{{ "Dépiler"|trans|striptags }}"
                                    aria-label="{{ "Dépiler"|trans|striptags }}">
                                <i class="icm-arrow-alt-to-bottom"></i>
                            </button>
                            <button type="button" id="nestable-collapse-all" class="btn-icon info-lighten cursor{% if collapsedAdminTrees %} d-none{% endif %}"
                                    data-bs-toggle="tooltip" title="{{ "Empiler"|trans|striptags }}"
                                    aria-label="{{ "Empiler"|trans|striptags }}">
                                <i class="icm-arrow-alt-to-top"></i>
                            </button>
                            <a href="{{ path('admin_medias_library', {website: websiteId()}) }}"
                               id="root-btn"
                               class="ajax-get-refresh btn-app info flex-grow-1 d-inline-flex align-items-center justify-content-center gap-2"
                               data-target="#medias-results"
                               data-target-loader="#medias-preloader">
                                <i class="icm-eye"></i><span>{{ "Racine"|trans|raw }}</span>
                            </a>
                        </div>
                        {%- include 'admin/core/include/nestable.html.twig' with {
                            routenameInterface: "folder",
                            customTitle: 'Afficher les médias'|trans,
                            customIcon: 'icm-eye',
                            customClass: 'ajax-get-refresh',
                            customBtn: 'info',
                            targetLoader: '#medias-preloader',
                            targetAjax: '#medias-results',
                            customRoute: 'admin_medias_library',
                            customRole: 'ROLE_EDIT'
                        } -%}
                    </div>
                    <div class="col-12 col-md-8 position-relative">
                        {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'library-preloader', full: false} only -%}
                        {%- include 'admin/page/media/medias-list.html.twig' -%}
                        {%- if not asCopy -%}
                            <div class="w-100 text-center mt-4 pt-2">
                                <button type="button" id="save-file-library" class="btn-app d-inline-flex align-items-center gap-2"
                                        data-type="{{ type }}" data-options="{{ options|json_encode }}">
                                    <i class="icm-plus"></i><span>{{ "Ajouter"|trans|raw }}</span>
                                </button>
                            </div>
                        {%- endif -%}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>