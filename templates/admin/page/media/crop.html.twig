{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageIcon = 'crop-alt' -%}
{%- set pageTitle = "Redimensionner"|trans -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-medias-cropper', null, 'admin') }}
{%- endblock -%}

{%- block javascripts -%}
    {{ encore_entry_script_tags('admin-medias-cropper', null,  'admin', {defer: true}) }}
    <script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js"
            integrity="sha384-GNFwBvfVxBkLMJpYMOABq3c+d3KnQxudP/mGPkzpZSTYykLBNsZEnG2D9G/X/+7D" crossorigin="anonymous" defer></script>
    {{ parent() }}
{%- endblock -%}

{%- block body -%}
    <section id="medias-croppers-index" class="cropper-page">
        <header class="zone-head cropper-page-head">
            <div class="cropper-page-heading">
                <h1 class="zone-title">
                    <span class="cropper-page-eyebrow">{{ "Redimensionner"|trans|raw }}</span>
                    <span class="cropper-page-media">
                        <i class="icm-image cropper-page-icon" aria-hidden="true"></i>
                        <span class="cropper-page-name">{{ media.originalName }}</span>
                    </span>
                </h1>
            </div>
            <div class="cropper-page-actions">
                <a href="{{ path('admin_medias_library', {website: websiteId}) }}"
                   class="btn-icon"
                   data-bs-toggle="tooltip"
                   title="{{ "Retourner aux médias"|trans|striptags }}"
                   aria-label="{{ "Retourner aux médias"|trans|striptags }}">
                    <i class="icm-reply"></i>
                </a>
            </div>
        </header>

        {%- if thumbs -%}
            <div class="row cropper-grid" data-masonry='{"percentPosition": true }'>
                {%- for thumb in thumbs -%}
                    <div class="col-sm-6 col-lg-4 mb-3 cropper-grid-item">
                        {{ render_esi(path('admin_media_cropper', {media: media.id, thumbConfiguration: thumb.id, website: website.id} )) }}
                    </div>
                {%- endfor -%}
            </div>
        {%- else -%}
            <div class="cropper-empty">
                {%- include 'admin/include/alert.html.twig' with {display: "alert", alert: "info", message: "Cette image n'est pas utilisée ou paramétrée pour le redimensionnement."|trans} only -%}
            </div>
        {%- endif -%}
    </section>
{%- endblock -%}
