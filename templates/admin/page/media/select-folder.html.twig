{%- trans_default_domain 'admin' -%}

{%- if form is defined -%}

    {{ form_start(form, {attr: {
        id: "select-folder-form",
        class: "d-inline-block",
        action: path('admin_folder_select', {website: websiteId()}),
        novalidate: "novalidate"}}) }}
        <div id="select-folder" class="modal fade text-start" tabindex="-1" role="dialog" aria-labelledby="select-folder">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border pb-4">
                    <div class="modal-header border-0">
                        <span class="modal-icon text-center w-100"><span class="icon-wrap"><i class="icm-share-square"></i></span></span>
                        <button class="btn-icon small position-absolute end-0 me-3" data-bs-dismiss="modal" aria-hidden="true">
                            <i class="icm-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <h5 class="main-title text-center fw-bold mb-4">{{ "Sélectionnez un dossier de destination"|trans|raw }}</h5>
                        {%- for field in form.children -%}
                            {%- if field.vars.name != 'save' and field.vars.name != 'saveEdit' -%}
                                {{ form_row(form[field.vars.name]) }}
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                    <div class="w-100 text-center modal-buttons mt-4">
                        {%- if form.save is defined -%}
                            {{ form_widget(form.save) }}
                        {%- endif -%}
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

{%- endif -%}