{%- trans_default_domain 'admin' -%}

<article class="thumb-tile">
    <div class="thumb-tile-preview">
        {{ media|file({desktop: thumbConfiguration}, {asMedia: true, lazyLoad: false, forceThumb: true}) }}
    </div>

    <div class="thumb-tile-body">
        <header class="thumb-tile-head">
            <span class="thumb-tile-label">{{ "Taille"|trans|raw }}</span>
            <span class="thumb-tile-size">
                {%- if configuration.width != "" and configuration.height != "" -%}
                    <span class="thumb-tile-dim">{{ configuration.width }}<span class="thumb-tile-unit">px</span></span>
                    <span class="thumb-tile-cross" aria-hidden="true">×</span>
                    <span class="thumb-tile-dim">{{ configuration.height }}<span class="thumb-tile-unit">px</span></span>
                {%- elseif configuration.width != "" and configuration.height == "" -%}
                    <span class="thumb-tile-dim">{{ configuration.width }}<span class="thumb-tile-unit">px</span></span>
                    <span class="thumb-tile-cross" aria-hidden="true">×</span>
                    <span class="thumb-tile-dim thumb-tile-dim-auto">{{ "auto"|trans|raw }}</span>
                {%- elseif configuration.width == "" and configuration.height != "" -%}
                    <span class="thumb-tile-dim thumb-tile-dim-auto">{{ "auto"|trans|raw }}</span>
                    <span class="thumb-tile-cross" aria-hidden="true">×</span>
                    <span class="thumb-tile-dim">{{ configuration.height }}<span class="thumb-tile-unit">px</span></span>
                {%- else -%}
                    <span class="thumb-tile-dim thumb-tile-dim-auto">{{ "auto"|trans|raw }}</span>
                    <span class="thumb-tile-cross" aria-hidden="true">×</span>
                    <span class="thumb-tile-dim thumb-tile-dim-auto">{{ "auto"|trans|raw }}</span>
                {%- endif -%}
            </span>
        </header>

        {%- if configuration.actions|length > 0 -%}
            <div class="thumb-tile-usage">
                <span class="thumb-tile-usage-label">{{ "Utilisé dans"|trans|raw }}</span>
                <ul class="thumb-tile-usage-list reset">
                    {%- for action in configuration.actions -%}
                        <li>{{ action.adminName }}</li>
                    {%- endfor -%}
                </ul>
            </div>
        {%- endif -%}

        <footer class="thumb-tile-foot">
            <button type="button"
                    class="btn-app thumb-tile-action thumb-tile-action-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#crop-modal-{{ configuration.id }}">
                <i class="icm-crop-alt"></i>
                <span>{{ "Redimensionner"|trans|raw }}</span>
            </button>
            {%- if thumb.id -%}
                <a href="{{ path('admin_thumb_delete', {website: websiteId(), thumb: thumb.id}) }}"
                   class="btn-icon thumb-tile-action-reset swal-delete-link"
                   data-bs-toggle="tooltip"
                   title="{{ "Réinitialiser"|trans|striptags }}"
                   aria-label="{{ "Réinitialiser"|trans|striptags }}">
                    <i class="icm-retweet"></i>
                </a>
            {%- endif -%}
        </footer>
    </div>
</article>

<div id="crop-modal-{{ configuration.id }}"
     class="modal fade crop-modal"
     tabindex="-1" role="dialog"
     aria-labelledby="crop-modal-{{ configuration.id }}-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content refer-preloader">
            {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'modal-preloader', full: true} only -%}
            <div class="modal-header flex-column align-items-center text-center pb-0">
                <span class="modal-icon w-100">
                    <span class="icon-wrap">
                        <i class="icm-crop-alt"></i>
                    </span>
                </span>
                <h2 id="crop-modal-{{ configuration.id }}-label" class="modal-title mt-3 mb-0">{{ "Redimensionner"|trans|raw }}</h2>
                <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                    <i class="icm-times"></i>
                </button>
            </div>
            <div class="modal-body px-3 px-md-5">
                <div class="ajax-content">
                    {{ form_start(form, {attr: {
                        id: "cropForm"~media.id,
                        novalidate: "novalidate",
                        action: path("admin_media_cropper", {
                            website: websiteId(),
                            media: media.id,
                            thumbConfiguration: configuration.id
                        })}}) }}

                        {%- set fileInfo = website()|fileInfo(media.originalName) -%}

                        <div class="cropper-wrap"
                             data-width="{{ thumb.width }}"
                             data-height="{{ thumb.height }}">
                            <div class="img-container">
                                <img src="{{ asset(fileInfo.path) }}" class="image img-fluid" alt="{{ "Image"|trans|striptags }}" />
                            </div>

                            <div class="cropper-toolbar mt-3">
                                <div class="cropper-toolbar-tools docs-buttons">
                                    <div class="btn-group" role="group" aria-label="{{ "Zoom"|trans|striptags }}">
                                        <span class="btn-icon small cursor zoom-in" data-bs-toggle="tooltip" title="{{ "Zoomer"|trans|raw }}">
                                            <i class="icm-search-plus"></i>
                                        </span>
                                        <span class="btn-icon small cursor zoom-out" data-bs-toggle="tooltip" title="{{ "Dézoomer"|trans|raw }}">
                                            <i class="icm-search-minus"></i>
                                        </span>
                                    </div>
                                    <div class="btn-group" role="group" aria-label="{{ "Déplacement"|trans|striptags }}">
                                        <span class="btn-icon small cursor move-start" data-bs-toggle="tooltip" title="{{ "Décaler l'image à gauche"|trans|raw }}">
                                            <i class="icm-arrow-left"></i>
                                        </span>
                                        <span class="btn-icon small cursor move-end" data-bs-toggle="tooltip" title="{{ "Décaler l'image à droite"|trans|raw }}">
                                            <i class="icm-arrow-right"></i>
                                        </span>
                                        <span class="btn-icon small cursor move-up" data-bs-toggle="tooltip" title="{{ "Monter l'image"|trans|raw }}">
                                            <i class="icm-arrow-up"></i>
                                        </span>
                                        <span class="btn-icon small cursor move-down" data-bs-toggle="tooltip" title="{{ "Descendre l'image"|trans|raw }}">
                                            <i class="icm-arrow-down"></i>
                                        </span>
                                    </div>
                                    <div class="btn-group" role="group" aria-label="{{ "Rotation"|trans|striptags }}">
                                        <span class="btn-icon small cursor rotate-start" data-bs-toggle="tooltip" title="{{ "Retourner l'image vers la gauche"|trans|raw }}">
                                            <i class="icm-undo"></i>
                                        </span>
                                        <span class="btn-icon small cursor rotate-end" data-bs-toggle="tooltip" title="{{ "Retourner l'image vers la droite"|trans|raw }}">
                                            <i class="icm-redo"></i>
                                        </span>
                                    </div>
                                    <div class="btn-group" role="group" aria-label="{{ "Inversion"|trans|striptags }}">
                                        <span data-scale="-1" class="btn-icon small cursor flip-horizontal" data-bs-toggle="tooltip" title="{{ "Inverser l'image"|trans|raw }}">
                                            <i class="icm-arrows-h"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="cropper-toolbar-data docs-data">
                                    <div class="cropper-toolbar-fields">
                                        {%- for field in form.children -%}
                                            {%- if field.vars.name != 'save' and field.vars.name != 'saveEdit' -%}
                                                {{ form_row(form[field.vars.name]) }}
                                            {%- endif -%}
                                        {%- endfor -%}
                                    </div>
                                    {%- if isInfinite -%}
                                        <span class="btn-icon cursor refresh-cropper-sizes cropper-toolbar-refresh" data-bs-toggle="tooltip" title="{{ "Rafraichir"|trans|raw }}">
                                            <i class="icm-sync"></i>
                                        </span>
                                    {%- endif -%}
                                </div>
                            </div>
                        </div>

                        <div class="w-100 text-center modal-buttons mt-4">
                            {{ form_row(form.save) }}
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
