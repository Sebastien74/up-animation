<!DOCTYPE html>

{%- set website = website is defined and website ? website : website() -%}
{%- set cacheClearDate = website.cacheClearDate is defined and website.cacheClearDate ? website.cacheClearDate|date('Y-m-d') : null -%}

<html lang="{{ app.request.locale }}"
      data-debug="{{ isDebug() }}"
      data-cache="{{ cacheClearDate }}"
      data-nonce="{{ csp_nonce() }}">

    <head>

        {%- trans_default_domain 'admin' -%}

        {%- set websiteId = website.id is defined and website.id ? website.id : websiteId() -%}
        {%- set configuration = website.configuration -%}
        {%- set defaultLocale = configuration.locale -%}
        {%- set allLocales = configuration.allLocales -%}
        {%- set logos = website.configuration.logos -%}
        {%- set isCustomPath = logos['security-logo'] is defined and logos['security-logo'] -%}
        {%- set intlsModules = website|intlsModules -%}
        {%- set userClass = granted("ROLE_INTERNAL") ? 'internal' : 'admin' -%}
        {%- set userEditClass = 'edit'|moduleActive(configuration) ? 'editor' : 'visitor' -%}
        {%- set bodyClass = block('bodyClass') is defined ? ' '~block('bodyClass')~' '~urlize(masterRequestGet('_route'))  : ' '~urlize(masterRequestGet('_route')) -%}
        {%- set adminInformation = website.information -%}
        {%- set defaultTitle = isCustomPath and adminInformation.title is defined and adminInformation.title ? adminInformation.title : "Up Animations CMS"|trans|striptags -%}
        {%- set cmsAuthorTitle = 'Up Animations!'|trans -%}
        {%- set cssTheme = adminTheme() -%}
        {%- set isDarkTheme = cssTheme == 'dark' -%}

        <!-- Metas -->
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="description" content="{{ defaultTitle|striptags }}"/>
        <meta name="author" content="{{ cmsAuthorTitle|striptags }}"/>
        <meta name="robots" content="index"/>

        <!-- Favicon icon -->
        <link rel="icon" type="image/png" href="{{ asset('build/admin/images/theme/favicons/favicon-96x96.png', 'admin') }}" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('build/admin/images/theme/favicons/favicon.svg', 'admin') }}" />
        <link rel="shortcut icon" href="{{ asset('build/admin/images/theme/favicons/favicon.ico', 'admin') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('build/admin/images/theme/favicons/apple-touch-icon.png', 'admin') }}" />
        <meta name="apple-mobile-web-app-title" content="Up!" />
        <link rel="manifest" href="{{ asset('build/admin/images/theme/favicons/site.webmanifest', 'admin') }}" />
        <meta property="og:image" content="{{ asset('build/admin/images/theme/favicons/share.jpg', 'admin') }}">

        <!-- Title -->
        {%- set metaTitle = block('title') is defined ? block('title') : "Bienvenue !!"|trans -%}
        <title>
            {% block title %}
                {%- if metaTitle is defined -%}
                    {{ metaTitle|htmlEntities }}
                {%- else -%}
                    {{ "Bienvenue !!"|trans|raw }}
                {%- endif -%}
            {% endblock %}
            | {{ defaultTitle }}
        </title>

        {%- block stylesheets -%}
            {{ encore_entry_link_tags('admin-'~cssTheme, null, 'admin') }}
            <link rel="preload" href="{{ asset('build/admin/admin-fonts.css', 'admin') }}" as="style" onload="this.onload=null;this.rel='stylesheet'" nonce="{{ csp_nonce() }}">
            <noscript><link rel="stylesheet" href="{{ asset('build/admin/admin-fonts.css', 'admin') }}" nonce="{{ csp_nonce() }}"></noscript>
            {%- if displayFrontFonts is defined and displayFrontFonts -%}
                <!-- Front fonts -->
                {%- if (configuration.template)|asGoogleFont -%}
                    <link rel="preconnect" href="https://fonts.googleapis.com">
                    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
                {%- endif -%}
                <link rel="preload" href="{{ asset('build/front/'~configuration.template~'/front-'~configuration.template~'-fonts.css', 'front_'~(configuration.template|replace({'-': '_'}))) }}" as="style" onload="this.onload=null;this.rel='stylesheet'" nonce="{{ csp_nonce() }}">
                <noscript><link rel="stylesheet" href="{{ asset('build/front/'~configuration.template~'/front-'~configuration.template~'-fonts.css', 'front_'~(configuration.template|replace({'-': '_'}))) }}" nonce="{{ csp_nonce() }}"></noscript>
            {%- endif -%}
            {%- if stylesSrc is defined -%}
                {%- for webpackEntry, webpackName in stylesSrc -%}
                    {{ encore_entry_link_tags(webpackEntry, null, 'admin') }}
                {%- endfor -%}
            {%- endif -%}
        {%- endblock -%}

    </head>

    <body id="skin-admin-body" class="skin-default fixed-header skin-admin {{ userClass~" "~userEditClass }}{{ bodyClass }}" data-id="{{ websiteId }}">

        <a href="#admin-body" class="skip-link visually-hidden-focusable">{{ 'Aller au contenu'|trans }}</a>

        {%- include 'admin/include/stripe-preloader.html.twig' with {preloaderId: 'main-preloader', preloaderClass: 'main-preloader', visible: false, full: true} only -%}

        <div id="main-wrapper">
            {%- include 'admin/include/header.html.twig' with {
                pageIcon: pageIcon is defined ? pageIcon : null,
                pageTitle: block('pageTitle') is defined ? block('pageTitle') : 'Administration'|trans,
                breadcrumb: breadcrumb is defined ? breadcrumb : false,
            } only -%}
            {%- include 'admin/include/sidebar/layout.html.twig' -%}
            <div class="page-wrapper">
                <div class="container-fluid px-3 px-md-4 px-xl-5 pt-4">
                    {%- include 'admin/include/breadcrumb.html.twig' -%}
                    <div id="admin-body" tabindex="-1">
                        {%- if disabledFlashBag is not defined -%}
                            {%- include 'admin/include/flashbag.html.twig' -%}
                        {%- endif -%}
                        {%- block body -%}{%- endblock -%}
                    </div>
                </div>
            </div>
            {%- if granted('ROLE_INTERNAL') -%}
                {%- include 'admin/include/sidebar-opposite/layout.html.twig' -%}
            {%- endif -%}
            <div class="sidebar-backdrop" aria-hidden="true"></div>
            <footer id="admin-footer" class="footer position-relative text-xs-center px-3 px-md-4 px-xl-5 d-flex align-items-center mt-4">
                <span class="btn-icon small me-2"><i class="icm-copyright"></i></span>{{ 'now'|date('Y') }} - {{ cmsAuthorTitle|raw }}
            </footer>
            {%- include 'admin/include/translations.html.twig' -%}
            <span id="cms-plugins-data" class="d-none"
                  data-admin-theme="{{ cssTheme }}"
                  data-colors-editor="{{ website|appColors('color') }}"
                  data-fonts-css-editor="{{ asset('build/front/'~configuration.template~'/front-default-fonts.css', 'front_'~(configuration.template|replace({'-': '_'}))) }}"
                  data-fonts-format-editor="{{ configuration|appAdminFonts('family') }}">
            </span>
        </div>

        {%- block javascripts -%}
            {{ jsRouting() }}
            <script src="{{ asset('bundles/tinymce/ext/tinymce/tinymce.min.js') }}" defer></script>
            <script src="{{ asset('bundles/tinymce/ext/tinymce-webcomponent.js') }}" type="module" defer></script>
            {%- if isIE() -%}
                {{ encore_entry_script_tags('browsers', null,  'vendor', {defer: true}) }}
            {%- endif -%}
            {%- if scriptsSrc is defined -%}
                {%- for webpackEntry, webpackName in scriptsSrc -%}
                    {{ encore_entry_script_tags(webpackEntry, null,  webpackName, {defer: true}) }}
                {%- endfor -%}
            {%- endif -%}
            {{ encore_entry_script_tags('admin-vendor', null, 'admin', {defer: true}) }}
        {%- endblock -%}

        {%- if app.request.cookies.get('IS_IMPERSONATOR_FRONT') -%}
            <div class="toast fade show always-show top-right position-fixed" role="alert" aria-live="assertive"
                 aria-atomic="true">
                <div class="toast-header bg-danger">
                    <strong class="me-auto">{{ "Alerte sécurité"|trans|raw }}</strong>
                    <button class="btn-close btn-icon btn-close btn-icon-white" data-bs-dismiss="toast" aria-label="{{"Fermer"|trans|raw }}"></button>
                </div>
                <div class="toast-body">
                    <small class="mb-2 d-inline-block w-100">{{ "Vous avez une session d'utilisateur front ouverte. Pensez à vous déconnecter"|trans|raw }}</small>
                </div>
            </div>
        {%- endif -%}

    </body>

</html>