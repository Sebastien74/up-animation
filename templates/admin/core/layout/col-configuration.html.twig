{%- trans_default_domain 'admin' -%}

<div class="modal-wrapper">
    <div class="modal fade modal-col-configuration layout-modal"
         id="modal-col-configuration" tabindex="-1" role="dialog"
         aria-labelledby="modal-col-configuration-{{ interface['name']~'-'~entity.id }}-label" aria-hidden="true">
        {{ form_start(form, {attr: {
            novalidate: "novalidate",
            action: path('admin_col_configuration', {website: websiteId(), col: col.id}),
            id: 'col-configuration-form',
            class: 'edit-element-form'
        }}) }}
            <div class="modal-dialog modal-dialog-centered modal-xxl" role="document">
                <div class="modal-content border">
                    <div class="modal-header">
                        <span class="modal-icon text-center w-100"><span class="icon-wrap"><i class="icm-cog"></i></span></span>
                        <button class="btn-close btn-icon" data-bs-dismiss="modal" aria-label="{{"Fermer"|trans|raw }}">
                            <i class="icm-times"></i>
                        </button>
                    </div>
                    <div class="modal-body pe-4 ps-4">

                        <h2 class="main-title text-center fw-500 mb-5">{{ "Configuration de la colonne"|trans|raw }}</h2>

                        <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4 justify-content-center" id="col-configuration-tab" role="tablist">
                            <li class="nav-item text-center">
                                <a class="btn-app active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab" aria-controls="general" aria-selected="true">
                                    <i class="icm-star"></i>{{ "Général"|trans|raw }}
                                </a>
                            </li>
                            {%- if form.transition.vars.choices is defined and form.transition.vars.choices|length > 0 -%}
                                <li class="nav-item text-center">
                                    <a class="btn-app" id="animation-tab" data-bs-toggle="tab" href="#animation" role="tab" aria-controls="animation" aria-selected="false">
                                        <i class="icm-hurricane"></i>{{ "Animation / Styles"|trans|raw }}
                                    </a>
                                </li>
                            {%- endif -%}
                            <li class="nav-item text-center">
                                <a class="btn-app" id="fingerprint-tab" data-bs-toggle="tab" href="#fingerprint" role="tab" aria-controls="fingerprint" aria-selected="false">
                                    <i class="icm-fingerprint"></i>{{ "Identifiants"|trans|raw }}
                                </a>
                            </li>
                            <li class="nav-item text-center">
                                <a class="btn-app" id="screens-tab" data-bs-toggle="tab" href="#screens" role="tab" aria-controls="screens" aria-selected="false">
                                    <i class="icm-desktop"></i>{{ "Écrans"|trans|raw }}
                                </a>
                            </li>
                            <li class="nav-item text-center">
                                <a class="btn-app" id="blocks-tab" data-bs-toggle="tab" href="#blocks" role="tab" aria-controls="blocks" aria-selected="false">
                                    <i class="icm-th-large"></i>{{ "Blocs"|trans|raw }}
                                </a>
                            </li>
                            {%- if form.intls is defined -%}
                                <li class="nav-item text-center">
                                    <a class="btn-app" id="content-tab" data-bs-toggle="tab" href="#content" role="tab" aria-controls="content" aria-selected="false">
                                        <i class="icm-text"></i>{{ "Contenu"|trans|raw }}
                                    </a>
                                </li>
                            {%- endif -%}
                        </ul>

                        <div class="tab-content config-tabs-content" id="col-configuration-tab-content">
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0 show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                                <div class="row">
                                    <div class="col-md-6">
                                        {%- include 'admin/core/layout/margins.html.twig' -%}
                                    </div>
                                    <div class="col-md-6">
                                        <h2 class="main-subtitle small text-center mb-3">{{ "Alignements"|trans|raw }}</h2>
                                        <div class="row">
                                            {%- if form.alignment is defined -%}
                                                {{ form_row(form.alignment) }}
                                            {%- endif -%}
                                            {%- if form.elementsAlignment is defined -%}
                                                {{ form_row(form.elementsAlignment) }}
                                            {%- endif -%}
                                            {%- if form.verticalAlign is defined -%}
                                                {{ form_row(form.verticalAlign) }}
                                            {%- endif -%}
                                            {%- if form.endAlign is defined -%}
                                                {{ form_row(form.endAlign) }}
                                            {%- endif -%}
                                        </div>
                                        <h2 class="main-subtitle small text-center mb-3">{{ "Autres"|trans|raw }}</h2>
                                        <div class="row">
                                            {%- if form.fullSize is defined -%}
                                                {{ form_row(form.fullSize) }}
                                            {%- endif -%}
                                            {%- if form.hide is defined -%}
                                                {{ form_row(form.hide) }}
                                            {%- endif -%}
                                            {%- if form.sticky is defined -%}
                                                {{ form_row(form.sticky) }}
                                            {%- endif -%}
                                            {%- if form.hideLocales is defined -%}
                                                {{ form_row(form.hideLocales) }}
                                            {%- endif -%}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {%- if form.transition.vars.choices is defined and form.transition.vars.choices|length > 0 -%}
                                <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="animation" role="tabpanel" aria-labelledby="animation-tab">
                                    <div class="row">
                                        <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Animation"|trans|raw }}</h2>
                                        {{ form_row(form.transition) }}
                                        {{ form_row(form.delay) }}
                                        {{ form_row(form.duration) }}
                                        <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Styles"|trans|raw }}</h2>
                                        <div class="row justify-content-center">
                                            {%- if form.shadow is defined -%}
                                                {{ form_row(form.shadow) }}
                                            {%- endif -%}
                                            {%- if form.shadowMobile is defined -%}
                                                {{ form_row(form.shadowMobile) }}
                                            {%- endif -%}
                                            {%- if form.zIndex is defined -%}
                                                {{ form_row(form.zIndex) }}
                                            {%- endif -%}
                                        </div>
                                        {%- if form.radius is defined -%}
                                            <div class="row justify-content-center">
                                                {{ form_row(form.radius) }}
                                            </div>
                                        {%- endif -%}
                                    </div>
                                </div>
                            {%- elseif form.transition is defined -%}
                                <div class="d-none">
                                    {{ form_row(form.transition) }}
                                    {{ form_row(form.delay) }}
                                    {{ form_row(form.duration) }}
                                </div>
                            {%- endif -%}
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="fingerprint" role="tabpanel" aria-labelledby="fingerprint-tab">
                                {%- include 'admin/core/layout/custom-identifiers.html.twig' -%}
                            </div>
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="screens" role="tabpanel" aria-labelledby="screens-tab">
                                <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Cacher"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.hideMobile is defined -%}
                                        {{ form_row(form.hideMobile) }}
                                    {%- endif -%}
                                    {%- if form.hideTablet is defined -%}
                                        {{ form_row(form.hideTablet) }}
                                    {%- endif -%}
                                    {%- if form.hideMiniPc is defined -%}
                                        {{ form_row(form.hideMiniPc) }}
                                    {%- endif -%}
                                    {%- if form.hideDesktop is defined -%}
                                        {{ form_row(form.hideDesktop) }}
                                    {%- endif -%}
                                </div>
                                <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Autres"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.reverse is defined -%}
                                        {{ form_row(form.reverse) }}
                                    {%- endif -%}
                                </div>
                                <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Ordres / Tailles de la colonne"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.mobilePosition is defined -%}
                                        {{ form_row(form.mobilePosition) }}
                                    {%- endif -%}
                                    {%- if form.tabletPosition is defined -%}
                                        {{ form_row(form.tabletPosition) }}
                                    {%- endif -%}
                                    {%- if form.miniPcPosition is defined -%}
                                        {{ form_row(form.miniPcPosition) }}
                                    {%- endif -%}
                                    {%- if form.mobileSize is defined -%}
                                        {{ form_row(form.mobileSize) }}
                                    {%- endif -%}
                                    {%- if form.tabletSize is defined -%}
                                        {{ form_row(form.tabletSize) }}
                                    {%- endif -%}
                                    {%- if form.miniPCSize is defined -%}
                                        {{ form_row(form.miniPCSize) }}
                                    {%- endif -%}
                                </div>
                            </div>
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="blocks" role="tabpanel" aria-labelledby="blocks-tab">
                                {%- include 'admin/core/layout/screens-entity.html.twig' with {cols: form.blocks} -%}
                            </div>
                            {%- if form.intls is defined -%}
                                <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="content" role="tabpanel" aria-labelledby="content-tab">
                                    <div class="row">
                                        {%- include 'admin/core/form/intls.html.twig' with {intls: form.intls, disableTitle: true} -%}
                                    </div>
                                </div>
                            {%- endif -%}
                        </div>

                    </div>
                    <div class="modal-footer px-4">
                        <div class="col-12 d-flex justify-content-end">
                            {{ form_widget(form.save, {attr: {class: 'btn-app'}}) }}
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>