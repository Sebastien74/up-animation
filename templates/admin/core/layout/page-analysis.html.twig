{%- trans_default_domain 'admin' -%}

{%- set score = report.score -%}
{%- set meta = report.meta -%}
{%- set summary = report.summary -%}
{%- set httpStatus = meta.httpStatus is defined ? meta.httpStatus : null -%}
{%- set isHttpError = httpStatus is not null and httpStatus >= 400 -%}
{%- set scoreState = score is null ? 'is-none' : (score >= 90 ? 'is-good' : (score >= 60 ? 'is-warn' : 'is-bad')) -%}
{%- set localeCode = url.locale|default('')|lower -%}

<div class="modal-wrapper">
    <div class="modal fade modal-page-analysis layout-modal"
         id="modal-page-analysis" tabindex="-1" role="dialog"
         aria-labelledby="modal-page-analysis-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
            <div class="modal-content border">
                <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                    <span class="modal-icon w-100">
                        <span class="icon-wrap">
                            <i class="icm-rocket"></i>
                        </span>
                    </span>
                    <h2 id="modal-page-analysis-label" class="modal-title fw-700 mt-3 mb-0">{{ "Analyse de la page"|trans|raw }}</h2>
                    <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                        <i class="icm-times"></i>
                    </button>
                </div>
                <div class="modal-body pt-4 px-3 px-md-4 pb-4">

                    <p class="perf-inspector-desc text-center mb-4">
                        {{ "Analyse statique du rendu front en preview (performance, rendu, SEO, accessibilité, bonnes pratiques). Indice indicatif, ce n'est pas une mesure Lighthouse."|trans|raw }}
                    </p>

                    <div class="perf-inspector-summary mb-4">
                        <div class="perf-summary-tile pa-score-tile">
                            <span class="tile-label">{{ "Indice"|trans|raw }}</span>
                            {%- if isHttpError -%}
                                <span class="score-pill score-pill-lg is-bad" title="{{ "Erreur HTTP"|trans|striptags }} {{ httpStatus }}">{{ "Err"|trans }} {{ httpStatus }}</span>
                            {%- else -%}
                                <span class="score-pill score-pill-lg {{ scoreState }}">{{ score is null ? '—' : score }}</span>
                            {%- endif -%}
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "Problèmes"|trans|raw }}</span>
                            <span class="tile-value">{{ summary.high + summary.medium + summary.low }}</span>
                            <span class="tile-sub">{{ summary.high }} {{ "critiques"|trans|raw }} · {{ summary.medium }} {{ "à surveiller"|trans|raw }}</span>
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "Poids HTML"|trans|raw }}</span>
                            <span class="tile-value">{{ meta.kb }} Ko</span>
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "Requêtes"|trans|raw }}</span>
                            <span class="tile-value">{{ meta.requests }}</span>
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "DOM"|trans|raw }}</span>
                            <span class="tile-value">{{ meta.dom }}</span>
                            <span class="tile-sub">{{ meta.images }} {{ "images"|trans|raw }}</span>
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "Rendu"|trans|raw }}</span>
                            <span class="tile-value">{{ meta.renderMs is defined and meta.renderMs is not null ? meta.renderMs ~ ' ms' : '—' }}</span>
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "Domaines tiers"|trans|raw }}</span>
                            <span class="tile-value">{{ meta.externalDomains|default(0) }}</span>
                        </div>
                        <div class="perf-summary-tile">
                            <span class="tile-label">{{ "Langue"|trans|raw }}</span>
                            <span class="tile-value tile-value-flag">
                                <img src="{{ asset('/medias/icons/flags/'~localeCode~'.svg') }}" class="pa-flag" width="19" height="14" alt="{{ localeCode|languageName }}">
                            </span>
                        </div>
                    </div>

                    {%- include 'admin/page/core/include/page-analysis-findings.html.twig' with {groups: report.groups, titleTag: 'h3'} only -%}

                    <div class="mt-4">
                        {%- include 'admin/page/core/include/page-analysis-history.html.twig' with {history: history, titleTag: 'h3'} only -%}
                    </div>

                </div>
                <div class="modal-footer border-0 d-flex flex-wrap justify-content-center gap-2 pt-0 pb-4">
                    {%- if previewUrl is defined and previewUrl -%}
                        <a href="{{ previewUrl }}" target="_blank" rel="noopener"
                           class="btn-app small d-inline-flex align-items-center gap-2">
                            <i class="icm-external-link-alt"></i><span>{{ "Ouvrir la preview"|trans|raw }}</span>
                        </a>
                    {%- endif -%}
                    <button type="button" class="analyze-rerun btn-app small d-inline-flex align-items-center gap-2"
                            data-href="{{ analyzeUrl|default('') }}">
                        <i class="icm-rocket"></i><span>{{ "Relancer l'analyse"|trans|raw }}</span>
                    </button>
                    <button type="button" class="analyze-copy btn-app small d-inline-flex align-items-center gap-2"
                            data-copied-label="{{ "Copié !"|trans|striptags }}">
                        <i class="icm-copy"></i><span>{{ "Copier le rapport"|trans|raw }}</span>
                    </button>
                </div>
                <script type="application/json" id="page-analysis-data">{{ {
                    score: report.score,
                    meta: report.meta,
                    url: {code: url.code, locale: url.locale},
                    groups: report.groups
                }|json_encode|raw }}</script>
            </div>
        </div>
    </div>
</div>
