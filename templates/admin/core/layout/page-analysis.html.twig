{%- trans_default_domain 'admin' -%}

{%- set severities = {
    high:   {label: "Critique"|trans, badge: 'bg-danger',    icon: 'icm-warning'},
    medium: {label: "Moyen"|trans,    badge: 'bg-warning',    icon: 'icm-exclamation-triangle'},
    low:    {label: "Mineur"|trans,   badge: 'bg-secondary',  icon: 'icm-info'},
    info:   {label: "Info"|trans,     badge: 'bg-info',       icon: 'icm-info'},
    ok:     {label: "OK"|trans,       badge: 'bg-success',    icon: 'icm-check'}
} -%}
{%- set score = report.score -%}
{%- set scoreBadge = score is null ? 'bg-secondary' : (score >= 90 ? 'bg-success' : (score >= 60 ? 'bg-warning' : 'bg-danger')) -%}
{%- set summary = report.summary -%}

<div class="modal-wrapper">
    <div class="modal fade modal-page-analysis layout-modal"
         id="modal-page-analysis" tabindex="-1" role="dialog"
         aria-labelledby="modal-page-analysis-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
            <div class="modal-content border">
                <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                    <span class="modal-icon w-100">
                        <span class="icon-wrap">
                            <i class="icm-tachometer"></i>
                        </span>
                    </span>
                    <h2 id="modal-page-analysis-label" class="modal-title fw-700 mt-3 mb-0">{{ "Analyse de la page"|trans|raw }}</h2>
                    <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                        <i class="icm-times"></i>
                    </button>
                </div>
                <div class="modal-body pt-4 px-3 px-md-4 pb-4">

                    <p class="text-center small text-muted mb-4">
                        {{ "Analyse statique du rendu front en preview (perf, rendu, SEO, accessibilité, bonnes pratiques). Indice indicatif, pas une mesure Lighthouse."|trans|raw }}
                    </p>

                    {# Key metrics #}
                    <div class="row g-2 text-center mb-3">
                        <div class="col-4 col-md-3">
                            <div class="badge {{ scoreBadge }} fs-6 w-100 py-2">{{ score is null ? 'N/A' : score ~ '/100' }}</div>
                            <small class="d-block mt-1">{{ "Indice"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ report.meta.kb }} Ko</div>
                            <small class="d-block mt-1">{{ "Poids HTML"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ report.meta.requests }}</div>
                            <small class="d-block mt-1">{{ "Requêtes"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ report.meta.renderMs|default(0) }} ms</div>
                            <small class="d-block mt-1">{{ "Temps de rendu"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ report.meta.dom }}</div>
                            <small class="d-block mt-1">{{ "Éléments DOM"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ report.meta.images }}</div>
                            <small class="d-block mt-1">{{ "Images"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ report.meta.externalDomains|default(0) }}</div>
                            <small class="d-block mt-1">{{ "Domaines tiers"|trans }}</small>
                        </div>
                        <div class="col-4 col-md-3">
                            <div class="badge bg-light text-dark fs-6 w-100 py-2">{{ url.locale|default('')|upper }}</div>
                            <small class="d-block mt-1">{{ "Langue"|trans }}</small>
                        </div>
                    </div>

                    {# Global summary #}
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span class="badge {{ severities.high.badge }}">{{ summary.high }} {{ "critiques"|trans }}</span>
                        <span class="badge {{ severities.medium.badge }}">{{ summary.medium }} {{ "moyens"|trans }}</span>
                        <span class="badge {{ severities.low.badge }}">{{ summary.low }} {{ "mineurs"|trans }}</span>
                    </div>

                    {# History of the indicative score #}
                    {%- if history is defined and history|length > 1 -%}
                        <div class="mb-4">
                            <h3 class="fs-6 fw-700 border-bottom pb-2 mb-2">{{ "Évolution de l'indice"|trans }}</h3>
                            <div class="d-flex align-items-end gap-1 mb-2" style="height: 48px;">
                                {%- for snap in history|reverse -%}
                                    {%- set s = snap.score is null ? 0 : snap.score -%}
                                    <div class="flex-fill rounded-top {{ s >= 90 ? 'bg-success' : (s >= 60 ? 'bg-warning' : 'bg-danger') }}"
                                         style="height: {{ (s * 0.46)|round }}px; min-height: 2px;"
                                         data-bs-toggle="tooltip"
                                         title="{{ snap.createdAt ? snap.createdAt|date('d/m/Y H:i') : '' }} — {{ snap.score is null ? 'N/A' : snap.score }}"></div>
                                {%- endfor -%}
                            </div>
                            <ul class="list-group list-group-flush small">
                                {%- for snap in history|slice(0, 5) -%}
                                    {%- set prev = history[loop.index] is defined ? history[loop.index] : null -%}
                                    {%- set delta = (snap.score is not null and prev and prev.score is not null) ? snap.score - prev.score : null -%}
                                    {%- set sc = snap.score is null ? 0 : snap.score -%}
                                    <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-1">
                                        <span class="text-muted">
                                            {{ snap.createdAt ? snap.createdAt|date('d/m/Y H:i') : '' }}
                                            {%- if loop.first %} · {{ "actuel"|trans }}{% endif -%}
                                        </span>
                                        <span class="d-inline-flex align-items-center gap-2">
                                            {%- if delta is not null and delta != 0 -%}
                                                <span class="{{ delta > 0 ? 'text-success' : 'text-danger' }}">{{ delta > 0 ? '+' : '' }}{{ delta }}</span>
                                            {%- endif -%}
                                            <span class="badge {{ sc >= 90 ? 'bg-success' : (sc >= 60 ? 'bg-warning' : 'bg-danger') }}">{{ snap.score is null ? 'N/A' : snap.score }}</span>
                                        </span>
                                    </li>
                                {%- endfor -%}
                            </ul>
                        </div>
                    {%- endif -%}

                    {# Grouped findings #}
                    {%- for group in report.groups -%}
                        {%- set issues = group.counts.high + group.counts.medium + group.counts.low -%}
                        <div class="mb-4">
                            <h3 class="fs-6 fw-700 d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                                <span>{{ group.label|trans }}</span>
                                {%- if issues > 0 -%}
                                    <span class="badge {{ group.counts.high > 0 ? severities.high.badge : (group.counts.medium > 0 ? severities.medium.badge : severities.low.badge) }}">{{ issues }}</span>
                                {%- else -%}
                                    <span class="badge {{ severities.ok.badge }}"><i class="icm-check"></i></span>
                                {%- endif -%}
                            </h3>
                            <ul class="list-group list-group-flush">
                                {%- for finding in group.findings -%}
                                    {%- set sev = severities[finding.severity] ?? severities.info -%}
                                    <li class="list-group-item d-flex flex-column gap-1 px-0 py-2">
                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <span class="fw-600">
                                                <i class="{{ sev.icon }} me-1"></i>{{ finding.label }}
                                            </span>
                                            <span class="d-inline-flex align-items-center gap-2 flex-shrink-0">
                                                <span class="text-muted small">{{ finding.value }}</span>
                                                <span class="badge {{ sev.badge }}">{{ sev.label }}</span>
                                            </span>
                                        </div>
                                        {%- if finding.reco -%}
                                            <small class="text-muted">{{ finding.reco }}</small>
                                        {%- endif -%}
                                    </li>
                                {%- endfor -%}
                            </ul>
                        </div>
                    {%- endfor -%}

                </div>
                <div class="modal-footer border-0 d-flex flex-wrap justify-content-center gap-2 pt-0 pb-4">
                    {%- if previewUrl is defined and previewUrl -%}
                        <a href="{{ previewUrl }}" target="_blank" rel="noopener"
                           class="btn-app small d-inline-flex align-items-center gap-2">
                            <i class="icm-eye"></i><span>{{ "Ouvrir la preview"|trans|raw }}</span>
                        </a>
                    {%- endif -%}
                    <button type="button" class="analyze-rerun btn-app small d-inline-flex align-items-center gap-2"
                            data-href="{{ analyzeUrl|default('') }}">
                        <i class="icm-loop"></i><span>{{ "Relancer l'analyse"|trans|raw }}</span>
                    </button>
                    <button type="button" class="analyze-copy btn-app small d-inline-flex align-items-center gap-2"
                            data-copied-label="{{ "Copié !"|trans|striptags }}">
                        <i class="icm-copy"></i><span>{{ "Copier le rapport"|trans|raw }}</span>
                    </button>
                </div>
                <script type="application/json" id="page-analysis-data">{{ {
                    score: report.score,
                    meta: report.meta,
                    url: {code: url.code, locale: url.locale},
                    groups: report.groups
                }|json_encode|raw }}</script>
            </div>
        </div>
    </div>
</div>
