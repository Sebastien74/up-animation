{%- trans_default_domain 'admin' -%}

<div class="modal-wrapper">
    <div class="modal fade modal-block-configuration layout-modal"
         id="modal-block-configuration" tabindex="-1" role="dialog"
         aria-labelledby="modal-block-configuration-{{ interface['name']~'-'~entity.id }}-label" aria-hidden="true">
        {{ form_start(form, {attr: {
            novalidate: "novalidate",
            action: path('admin_block_configuration', {website: websiteId(), block: block.id}),
            id: 'block-configuration-form',
            class: 'edit-element-form'
        }}) }}
            <div class="modal-dialog modal-dialog-centered modal-xxl" role="document">
                <div class="modal-content border">
                    <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                        <span class="modal-icon w-100">
                            <span class="icon-wrap">
                                <i class="icm-cog"></i>
                            </span>
                        </span>
                        <h2 id="modal-block-configuration-{{ interface['name']~'-'~entity.id }}-label" class="modal-title fw-700 mt-3 mb-0">{{ "Configuration du bloc"|trans|raw }}</h2>
                        <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                            <i class="icm-times"></i>
                        </button>
                    </div>
                    <div class="modal-body pt-4 px-3 px-md-4">
                        <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4 justify-content-center flex-wrap" id="block-configuration-tab" role="tablist">
                            <li class="nav-item text-center">
                                <a class="btn btn-app active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab" aria-controls="general" aria-selected="true">
                                    <i class="icm-star"></i>{{ "Général"|trans|raw }}
                                </a>
                            </li>
                            {%- if form.transition.vars.choices is defined and form.transition.vars.choices|length > 0 -%}
                                <li class="nav-item text-center">
                                    <a class="btn btn-app" id="animation-tab" data-bs-toggle="tab" href="#animation" role="tab" aria-controls="animation" aria-selected="false">
                                        <i class="icm-hurricane"></i>{{ "Animation / Styles"|trans|raw }}
                                    </a>
                                </li>
                            {%- endif -%}
                            <li class="nav-item text-center">
                                <a class="btn btn-app" id="fingerprint-tab" data-bs-toggle="tab" href="#fingerprint" role="tab" aria-controls="fingerprint" aria-selected="false">
                                    <i class="icm-fingerprint"></i>{{ "Identifiants"|trans|raw }}
                                </a>
                            </li>
                            <li class="nav-item text-center">
                                <a class="btn btn-app" id="screens-tab" data-bs-toggle="tab" href="#screens" role="tab" aria-controls="screens" aria-selected="false">
                                    <i class="icm-desktop"></i>{{ "Écrans"|trans|raw }}
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content config-tabs-content" id="col-configuration-tab-content">
                            <div class="tab-pane tab-pane-config fade px-3 px-md-4 pb-0 show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                                <div class="row g-3">
                                    <div class="col-12 col-lg-7">
                                        <div class="card h-100">
                                            <div class="card-body">
                                                {%- include 'admin/core/layout/margins.html.twig' -%}
                                                {%- if form.hideLocales is defined -%}
                                                    {{ form_row(form.hideLocales) }}
                                                {%- endif -%}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-5">
                                        <div class="card h-100">
                                            <div class="card-body">
                                                <h2 class="main-subtitle small text-center mb-3"><i class="icm-text-width"></i>{{ "Alignement des contenus"|trans|raw }}</h2>
                                                <div class="row">
                                                    {%- include 'admin/core/layout/alignments.html.twig' -%}
                                                    {%- if form.elementsAlignment is defined -%}
                                                        {{ form_row(form.elementsAlignment) }}
                                                    {%- endif -%}
                                                    {%- if form.zIndex is defined -%}
                                                        {{ form_row(form.zIndex) }}
                                                    {%- endif -%}
                                                    {%- if form.verticalAlign is defined -%}
                                                        {{ form_row(form.verticalAlign) }}
                                                    {%- endif -%}
                                                    {%- if form.endAlign is defined -%}
                                                        {{ form_row(form.endAlign) }}
                                                    {%- endif -%}
                                                </div>
                                                <h2 class="main-subtitle small text-center mb-3"><i class="icm-list-ul"></i>{{ "Autres"|trans|raw }}</h2>
                                                <div class="row">
                                                    {%- if form.hide is defined -%}
                                                        {{ form_row(form.hide) }}
                                                    {%- endif -%}
                                                    {%- if form.useForThumb is defined -%}
                                                        {{ form_row(form.useForThumb) }}
                                                    {%- endif -%}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {%- if form.transition.vars.choices is defined and form.transition.vars.choices|length > 0 -%}
                                <div class="tab-pane tab-pane-config fade px-3 px-md-4 pb-0" id="animation" role="tabpanel" aria-labelledby="animation-tab">
                                    <div class="row">
                                        <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-hurricane"></i>{{ "Animation"|trans|raw }}</h2>
                                        {{ form_row(form.transition) }}
                                        {{ form_row(form.delay) }}
                                        {{ form_row(form.duration) }}
                                        <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-palette"></i>{{ "Styles"|trans|raw }}</h2>
                                        <div class="d-flex justify-content-center">
                                            {%- if form.radius is defined -%}
                                                {{ form_row(form.radius) }}
                                            {%- endif -%}
                                        </div>
                                    </div>
                                </div>
                            {%- elseif form.transition is defined -%}
                                <div class="d-none">
                                    {{ form_row(form.transition) }}
                                    {{ form_row(form.delay) }}
                                    {{ form_row(form.duration) }}
                                </div>
                            {%- endif -%}
                            <div class="tab-pane tab-pane-config fade px-3 px-md-4 pb-0" id="fingerprint" role="tabpanel" aria-labelledby="fingerprint-tab">
                                {%- include 'admin/core/layout/custom-identifiers.html.twig' -%}
                            </div>
                            <div class="tab-pane tab-pane-config fade px-3 px-md-4 pb-0" id="screens" role="tabpanel" aria-labelledby="screens-tab">
                                <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-ban"></i>{{ "Cacher"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.hideMobile is defined -%}
                                        {{ form_row(form.hideMobile) }}
                                    {%- endif -%}
                                    {%- if form.hideTablet is defined -%}
                                        {{ form_row(form.hideTablet) }}
                                    {%- endif -%}
                                    {%- if form.hideLaptop is defined -%}
                                        {{ form_row(form.hideLaptop) }}
                                    {%- endif -%}
                                    {%- if form.hideDesktop is defined -%}
                                        {{ form_row(form.hideDesktop) }}
                                    {%- endif -%}
                                </div>
                                <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-list-ul"></i>{{ "Autres"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.reverse is defined -%}
                                        {{ form_row(form.reverse) }}
                                    {%- endif -%}
                                </div>
                                <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-sort-numeric-down-alt"></i>{{ "Ordres / Tailles du bloc"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.mobilePosition is defined -%}
                                        {{ form_row(form.mobilePosition) }}
                                    {%- endif -%}
                                    {%- if form.tabletPosition is defined -%}
                                        {{ form_row(form.tabletPosition) }}
                                    {%- endif -%}
                                    {%- if form.laptopPosition is defined -%}
                                        {{ form_row(form.laptopPosition) }}
                                    {%- endif -%}
                                    {%- if form.mobileSize is defined -%}
                                        {{ form_row(form.mobileSize) }}
                                    {%- endif -%}
                                    {%- if form.tabletSize is defined -%}
                                        {{ form_row(form.tabletSize) }}
                                    {%- endif -%}
                                    {%- if form.laptopSize is defined -%}
                                        {{ form_row(form.laptopSize) }}
                                    {%- endif -%}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer pt-0 px-3 px-md-4 border-0">
                        <div class="col-12 d-flex justify-content-end">
                            {{ form_widget(form.save) }}
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>