{%- trans_default_domain 'admin' -%}

{%- set tabs = {
    "alignements-desktop": {
        title: "Ordinateur"|trans,
        name: "alignment",
        icon: "icm-desktop"
    },
    "alignements-miniPc": {
        title: "Mini PC"|trans,
        field: "MiniPc",
        name: "alignmentMiniPc",
        icon: "icm-laptop"
    },
    "alignements-tablet": {
        title: "Tablette"|trans,
        name: "alignmentTablet",
        icon: "icm-tablet"
    },
    "alignements-mobile": {
        title: "Mobile"|trans,
        name: "alignmentMobile",
        icon: "icm-mobile"
    }} -%}

<ul class="nav nav-tabs gap-2 w-100 border-0 mb-3" role="tablist">
    {%- for tabId, config in tabs -%}
        <li class="nav-item flex-fill">
            <a id="nav-{{ tabId }}-tab" class="btn btn-app justify-content-center small w-100{% if loop.first %} active{% endif %}"
               data-bs-toggle="tab"
               href="#{{ tabId }}"
               aria-controls="{{ tabId }}"
               role="tab"
               aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
                <i class="{{ config.icon }}"></i>
                <span class="d-none d-sm-inline-block">{{ config.title }}</span>
            </a>
        </li>
    {%- endfor -%}
</ul>

<div id="alignements-management-block" class="tab-content pt-0">
    {%- for tabId, config in tabs -%}
        <div class="tab-pane fade text-center w-100 mb-4{% if loop.first %} active show{% endif %}" id="{{ tabId }}" role="tabpanel" aria-labelledby="nav-{{ tabId }}-tab">
            {%- if form[config.name] is defined -%}
                {{ form_row(form[config.name]) }}
            {%- endif -%}
        </div>
    {%- endfor -%}
</div>