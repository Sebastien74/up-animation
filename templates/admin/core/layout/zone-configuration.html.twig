{%- trans_default_domain 'admin' -%}

{%- set allLocales = website.configuration.allLocales -%}

<div class="modal-wrapper">
    <div class="modal fade modal-zone-configuration layout-modal"
         id="modal-zone-configuration" tabindex="-1" role="dialog"
         aria-labelledby="modal-zone-configuration-{{ interface['name']~'-'~entity.id }}-label" aria-hidden="true">
        {{ form_start(form, {attr: {
            novalidate: "novalidate",
            action: path('admin_zone_configuration', {website: websiteId(), zone: zone.id}),
            id: 'zone-configuration-form',
            class: 'edit-element-form'
        }}) }}
            <div class="modal-dialog modal-dialog-centered modal-xxl" role="document">
                <div class="modal-content border">
                    <div class="modal-header pb-0">
                        <span class="modal-icon text-center w-100"><span class="icon-wrap"><i class="icm-cog"></i></span></span>
                        <button class="btn-close btn-icon" data-bs-dismiss="modal" aria-label="{{"Fermer"|trans|raw }}">
                            <i class="icm-times"></i>
                        </button>
                    </div>
                    <div class="modal-body pt-4 px-4 pb-0">
                        <h2 class="main-title text-center fw-500 mb-5">{{ "Configuration de la ligne"|trans|raw }}</h2>
                        <ul class="nav nav-tabs gap-2 w-100 border-0 mb-4 justify-content-center" id="zone-configuration-tab" role="tablist">
                            <li class="nav-item text-center">
                                <a class="btn-app active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab" aria-controls="general" aria-selected="true">
                                    <i class="icm-star"></i>{{ "Général"|trans|raw }}
                                </a>
                            </li>
                            {%- if form.transition.vars.choices is defined and form.transition.vars.choices|length > 0 -%}
                                <li class="nav-item text-center">
                                    <a class="btn-app" id="animation-tab" data-bs-toggle="tab" href="#animation" role="tab" aria-controls="animation" aria-selected="false">
                                        <i class="icm-hurricane"></i>{{ "Animation / Styles"|trans|raw }}
                                    </a>
                                </li>
                            {%- endif -%}
                            <li class="nav-item text-center">
                                <a class="btn-app" id="medias-tab" data-bs-toggle="tab" href="#medias" role="tab" aria-controls="medias" aria-selected="false">
                                    <i class="icm-image"></i>{{ "Médias"|trans|raw }}
                                </a>
                            </li>
                            <li class="nav-item text-center">
                                <a class="btn-app" id="screens-tab" data-bs-toggle="tab" href="#screens" role="tab" aria-controls="screens" aria-selected="false">
                                    <i class="icm-desktop"></i>{{ "Écrans"|trans|raw }}
                                </a>
                            </li>
                            <li class="nav-item text-center">
                                <a class="btn-app" id="fingerprint-tab" data-bs-toggle="tab" href="#fingerprint" role="tab" aria-controls="fingerprint" aria-selected="false">
                                    <i class="icm-fingerprint"></i>{{ "Identifiants"|trans|raw }}
                                </a>
                            </li>
                            <li class="nav-item text-center">
                                <a class="btn-app" id="content-tab" data-bs-toggle="tab" href="#content" role="tab" aria-controls="content" aria-selected="false">
                                    <i class="icm-text"></i>{{ "Contenu"|trans|raw }}
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content config-tabs-content" id="zone-configuration-tab-content">
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0 show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                                <div class="row">
                                    <div class="row w-100 m-0">
                                        <div class="col-md-6">
                                            <div class="card h-100">
                                                <div class="card-body">
                                                    {%- include 'admin/core/layout/margins.html.twig' -%}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card h-100">
                                                <div class="card-body">
                                                    <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-cog"></i>{{ "Configuration"|trans|raw }}</h2>
                                                    <div class="row">
                                                        {%- if form.alignment is defined -%}
                                                            {{ form_row(form.alignment) }}
                                                        {%- endif -%}
                                                        {%- if form.containerSize is defined -%}
                                                            {{ form_row(form.containerSize) }}
                                                        {%- endif -%}
                                                        {%- if form.fullSize is defined -%}
                                                            {{ form_row(form.fullSize) }}
                                                        {%- endif -%}
                                                        {%- if form.centerCol is defined -%}
                                                            {{ form_row(form.centerCol) }}
                                                        {%- endif -%}
                                                        {%- if form.colToRight is defined -%}
                                                            {{ form_row(form.colToRight) }}
                                                        {%- endif -%}
                                                        {%- if form.colToEnd is defined -%}
                                                            {{ form_row(form.colToEnd) }}
                                                        {%- endif -%}
                                                        {%- if form.standardizeElements is defined -%}
                                                            {{ form_row(form.standardizeElements) }}
                                                        {%- endif -%}
                                                        {%- if form.hide is defined -%}
                                                            {{ form_row(form.hide) }}
                                                        {%- endif -%}
                                                    </div>
                                                    <div class="row">
                                                        {%- if form.hideLocales is defined -%}
                                                            {{ form_row(form.hideLocales) }}
                                                        {%- endif -%}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="screens" role="tabpanel" aria-labelledby="screens-tab">
                                <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Cacher"|trans|raw }}</h2>
                                <div class="row">
                                    {%- if form.hideMobile is defined -%}
                                        {{ form_row(form.hideMobile) }}
                                    {%- endif -%}
                                    {%- if form.hideTablet is defined -%}
                                        {{ form_row(form.hideTablet) }}
                                    {%- endif -%}
                                    {%- if form.hideMiniPc is defined -%}
                                        {{ form_row(form.hideMiniPc) }}
                                    {%- endif -%}
                                    {%- if form.hideDesktop is defined -%}
                                        {{ form_row(form.hideDesktop) }}
                                    {%- endif -%}
                                </div>
                                {%- include 'admin/core/layout/screens-entity.html.twig' with {cols: form.cols} -%}
                            </div>
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="medias" role="tabpanel" aria-labelledby="medias-tab">
                                <h2 class="main-subtitle small w-100 text-center mb-3">{{ "Image de fond"|trans|raw }}</h2>
                                {%- if allLocales|length == 1 -%}
                                    <div class="row">
                                {%- endif -%}
                                    {%- include 'admin/core/form/media-relations-uniq.html.twig' with {mediaRelations: form.mediaRelations, displayTitleCard: false} -%}
                                {%- if allLocales|length == 1 -%}
                                    </div>
                                {%- endif -%}
                                <div class="row">
                                    {%- if form.standardizeMedia is defined -%}
                                        {{ form_row(form.standardizeMedia) }}
                                    {%- endif -%}
                                    {%- if form.backgroundFixed is defined -%}
                                        {{ form_row(form.backgroundFixed) }}
                                    {%- endif -%}
                                    {%- if form.backgroundParallax is defined -%}
                                        {{ form_row(form.backgroundParallax) }}
                                    {%- endif -%}
                                </div>
                            </div>
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="fingerprint" role="tabpanel" aria-labelledby="fingerprint-tab">
                                {%- include 'admin/core/layout/custom-identifiers.html.twig' -%}
                            </div>
                            {%- if form.transition.vars.choices is defined and form.transition.vars.choices|length > 0 -%}
                                <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="animation" role="tabpanel" aria-labelledby="animation-tab">
                                    <div class="card mb-3">
                                        <div class="card-body pb-0">
                                            <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-hurricane"></i>{{ "Animation"|trans|raw }}</h2>
                                            <div class="row">
                                                {{ form_row(form.transition) }}
                                                {{ form_row(form.delay) }}
                                                {{ form_row(form.duration) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card">
                                        <div class="card-body pb-0">
                                            <h2 class="main-subtitle small w-100 text-center mb-3"><i class="icm-palette"></i>{{ "Styles"|trans|raw }}</h2>
                                            <div class="row justify-content-center">
                                                {%- if form.shadow is defined -%}
                                                    {{ form_row(form.shadow) }}
                                                {%- endif -%}
                                                {%- if form.shadowMobile is defined -%}
                                                    {{ form_row(form.shadowMobile) }}
                                                {%- endif -%}
                                                {%- if form.zIndex is defined -%}
                                                    {{ form_row(form.zIndex) }}
                                                {%- endif -%}
                                            </div>
                                            {%- if form.radius is defined -%}
                                                <div class="row justify-content-center">
                                                    {{ form_row(form.radius) }}
                                                </div>
                                            {%- endif -%}
                                        </div>
                                    </div>
                                </div>
                            {%- elseif form.transition is defined -%}
                                <div class="d-none">
                                    {{ form_row(form.transition) }}
                                    {{ form_row(form.delay) }}
                                    {{ form_row(form.duration) }}
                                </div>
                            {%- endif -%}
                            <div class="tab-pane tab-pane-config fade pe-4 ps-4 pb-0" id="content" role="tabpanel" aria-labelledby="content-tab">
                                <div class="row">
                                    {%- if form.titlePosition is defined -%}
                                        {{ form_row(form.titlePosition) }}
                                    {%- endif -%}
                                    {%- if form.intls is defined -%}
                                        {%- include 'admin/core/form/intls.html.twig' with {intls: form.intls, disableTitle: true} -%}
                                    {%- endif -%}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer pt-0 px-4">
                        <div class="col-12 d-flex justify-content-end">
                            {{ form_widget(form.save) }}
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>