{%- trans_default_domain 'admin' -%}

<div class="modal-wrapper">
    <div class="modal fade modal-background-layout layout-modal"
         id="modal-background" tabindex="-1" role="dialog"
         aria-labelledby="modal-background-{{ interface['name']~'-'~entity.id }}-label" aria-hidden="true">
        {{ form_start(form, {attr: {
            id: "background-form",
            action: path("admin_"~interface.name~"_background", {website: websiteId(), (interface['name']): entity.id}),
            class: 'edit-element-form h-100'
        }}) }}
            <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
                <div class="modal-content border">
                    <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                        <span class="modal-icon w-100">
                            <span class="icon-wrap">
                                <i class="icm-palette"></i>
                            </span>
                        </span>
                        <h5 class="modal-title mt-3 mb-0" id="modal-background-{{ interface['name']~'-'~entity.id }}-label">
                            {{ "Couleur de fond"|trans|raw }}
                        </h5>
                        <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                            <i class="icm-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        {{ form_widget(form.backgroundColor) }}
                        {%- if form.hexadecimalCode is defined -%}
                            {{ form_row(form.hexadecimalCode) }}
                        {%- endif -%}
                        {%- if form.backgroundFullSize is defined -%}
                            {{ form_row(form.backgroundFullSize) }}
                        {%- endif -%}
                        {%- if form.backgroundFullHeight is defined -%}
                            {{ form_row(form.backgroundFullHeight) }}
                        {%- endif -%}
                    </div>
                    <div class="modal-footer border-0 justify-content-center">
                        {{ form_widget(form.save) }}
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>