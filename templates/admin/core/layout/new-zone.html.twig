{%- trans_default_domain 'admin' -%}

<div class="modal-wrapper">
    <div id="new-zone-modal" class="modal fade add-zone-modal layout-modal" tabindex="-1" role="dialog" aria-labelledby="new-zone-modal-label">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content border">
                <div class="modal-header flex-column align-items-center text-center border-0 pb-0">
                    <span class="modal-icon w-100">
                        <span class="icon-wrap">
                            <i class="icm-line-height"></i>
                        </span>
                    </span>
                    <h3 id="new-zone-modal-label" class="modal-title fw-bold mt-3 mb-0">{{ 'Ajouter une ligne'|trans|raw }}</h3>
                    <button type="button" class="btn-close btn-icon position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}">
                        <i class="icm-times"></i>
                    </button>
                </div>
                <div class="modal-body px-3 px-md-5">
                    <div class="mx-auto">
                        {{ form_start(form, {attr: {
                            novalidate: "novalidate",
                            action: path('admin_zone_new', {website: websiteId(), layout: layout.id}),
                            id: 'add-zone-form',
                            class: 'edit-element-form',
                            'data-scroll-to': '#add-zone-btn',
                        }}) }}
                            {{ form_row(form.grid) }}
                            <div class="d-flex justify-content-center text-center modal-buttons mt-4">
                                {{ form_row(form.save) }}
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>