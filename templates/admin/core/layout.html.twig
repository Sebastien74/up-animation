{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set pageTitle = "Mise en page :"|trans~" "~entity.adminName -%}
{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle }}{%- endblock -%}
{%- block bodyClass -%}layout-body-edition{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}
    {%- set haveCustomLayout = entity.customLayout is defined and entity.customLayout -%}
    {%- set haveTooHeavyFiles = tooHeavyFiles is defined and tooHeavyFiles|length > 0 and disabledMedias is not defined -%}
    {%- set haveSeoAlert = (haveH1.error is defined and haveH1.error)
        or ((seoAlert.noTitle is defined or seoAlert.noDescription is defined) and (seoAlert.noTitle is not empty or seoAlert.noDescription is not empty))
        or (mediasAlert is defined and mediasAlert is not empty) -%}
    {%- include 'admin/core/form/edit-form-base.html.twig' -%}
    {%- include 'admin/include/alerts.html.twig' -%}
    {%- set layout = entity.layout is defined and entity.layout ? entity.layout : null -%}
    {%- set infill = entity.infill is defined and entity.infill -%}
    {%- if not infill and (layout and interface.name == 'page' or layout and granted('ROLE_LAYOUT_'~interface.name|upper)) -%}
        <div id="layout-grid" class="mb-4">
            {%- set analyzeUrl = null -%}
            {%- if entity.urls is defined and entity.urls|length -%}
                {%- for u in entity.urls -%}
                    {%- if analyzeUrl is null and u.locale == app.request.locale -%}{%- set analyzeUrl = u -%}{%- endif -%}
                {%- endfor -%}
                {%- if analyzeUrl is null -%}{%- set analyzeUrl = entity.urls|first -%}{%- endif -%}
            {%- endif -%}
            <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2">
                {%- include 'admin/core/layout/cache-invalidate-button.html.twig' -%}
                {%- if analyzeUrl -%}
                    <span class="analyze-page btn-app small d-inline-flex align-items-center gap-2 cursor"
                          data-bs-toggle="tooltip"
                          href="{{ path('admin_layout_analyze', {
                              website: website.id,
                              url: analyzeUrl.id,
                              interface: interface.name,
                          }) }}"
                          title="{{ "Analyse la performance et le rendu de la page front (preview)"|trans|striptags }}">
                        <i class="icm-tachometer"></i><span>{{ "Analyser la page"|trans|raw }}</span>
                    </span>
                {%- endif -%}
                <span class="standardize-margins-page btn-app small d-inline-flex align-items-center gap-2 cursor"
                      data-bs-toggle="tooltip"
                      href="{{ path('admin_layout_standardize_margins', {
                          website: website.id,
                          layout: layout.id,
                      }) }}"
                      title="{{ "Recopie les marges et paddings « ordinateur » de toute la page (zones, colonnes et blocs) sur les écrans portable, tablette et mobile"|trans|striptags }}">
                    <i class="icm-phone-laptop"></i><span>{{ "Standardiser les marges"|trans|raw }}</span>
                </span>
            </div>
            {%- include 'admin/core/layout/zones.html.twig' -%}
        </div>
    {%- endif -%}
{%- endblock -%}