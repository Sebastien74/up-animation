{%- extends "admin/base.html.twig" -%}

{%- trans_default_domain 'admin' -%}

{%- set haveCustomLayout = entity.customLayout is defined and entity.customLayout and entity.layout.id is defined and entity.layout.id -%}
{%- set transDomain = interface.name is defined and interface.name
    ? 'entity_'~interface.name : null -%}

{%- if pageTitle is not defined or pageTitle is defined and not pageTitle -%}
    {%- set title = 'singular'|trans([], transDomain) and 'singular'|trans([], transDomain) != 'singular'
        ? 'singular'|trans([], transDomain) : 'Édition'|trans~" "~interface.name -%}
    {%- set pageTitle = entity.adminName is defined and entity.adminName ? title~' : '~entity.adminName : title -%}
{%- endif -%}

{%- block title -%}{{ pageTitle|htmlEntities }}{%- endblock -%}
{%- block pageTitle -%}{{ pageTitle|truncate(50, false) }}{%- endblock -%}

{%- block stylesheets -%}
    {{ parent() }}
{%- endblock -%}

{%- block javascripts -%}
    {{ parent() }}
{%- endblock -%}

{%- block body -%}
    {%- include 'admin/include/alerts.html.twig' -%}
    {%- include 'admin/core/form/edit-form-base.html.twig' -%}
    {%- if granted('ROLE_LAYOUT_'~interface.name|upper) -%}
        <div id="layout-grid" class="mb-4">
            {%- set layout = entity.layout is defined and entity.layout ? entity.layout : null -%}
            {%- if layout and layout.zones is not empty and interface.classname is defined and entity.id is defined and entity.id -%}
                <div class="d-flex justify-content-end mb-3">
                    <form method="post" action="{{ path('admin_entity_cache_invalidate') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_entity_cache_invalidate') }}">
                        <input type="hidden" name="class" value="{{ interface.classname }}">
                        <input type="hidden" name="id" value="{{ entity.id }}">
                        <button type="submit" class="btn-app small d-inline-flex align-items-center gap-2"
                                data-bs-toggle="tooltip"
                                title="{{ "Régénère le cache public de cette fiche lors des prochaines visites"|trans|striptags }}">
                            <i class="icm-sync"></i><span>{{ "Invalider le cache de cette fiche"|trans|raw }}</span>
                        </button>
                    </form>
                </div>
            {%- endif -%}
            {%- include 'admin/core/layout/zones.html.twig' -%}
        </div>
    {%- endif -%}
{%- endblock -%}