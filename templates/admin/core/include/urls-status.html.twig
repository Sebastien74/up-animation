{%- trans_default_domain 'admin' -%}

{%- if entity.infill is not defined or not entity.infill -%}
    <span class="active-urls d-flex gap-2 me-3">
        {%- for configLocale in allLocales -%}
            {%- set exist = false -%}
            {%- set multiLocales = allLocales|length > 1 -%}
            {%- for url in entity.urls -%}
                {%- if url.locale == configLocale and url.code
                    or url.locale == configLocale and url.online
                    or url.locale == configLocale and entity.asIndex is defined and entity.asIndex -%}
                    {%- set languageName = languageName(configLocale, app.user.locale) -%}
                    {%- set status = url.online and url.code ? 'online' : 'offline' -%}
                    {%- set statusLabel = url.online and url.code ? 'En ligne' : 'Hors ligne' -%}
                    {%- set statusLabel = multiLocales ? statusLabel~': '~languageName : statusLabel -%}
                    {%- set status = url.online and entity.asIndex is defined and entity.asIndex ? 'online' : status -%}
                    {%- set classname = interface.classname is defined ? interface.classname : null -%}
                    <a href="{{ path("admin_url_status", {website: websiteId(), url: url.id, classname: classname|url_encode, entityId: entity.id}) }}"
                       class="{{ status }} btn-icon small {% if 'offline' == status %}muted{% else %}success{% endif %}"
                       data-icon-offline="snooze"
                       data-icon-online="wifi"
                       data-color-offline="muted"
                       data-color-online="success"
                       data-label-offline="{{ multiLocales ? 'Hors ligne : '~languageName : 'Hors ligne' }}"
                       data-label-online="{{ multiLocales ? 'En ligne : '~languageName : 'En ligne' }}"
                       data-bs-toggle="tooltip"
                       title="{{ statusLabel }}">
                        {%- if multiLocales -%}
                            <span class="language text-uppercase label">{{ url.locale }}</span>
                        {%- else -%}
                            <i class="label icm-{% if 'offline' == status %}snooze{% else %}wifi{% endif %}"></i>
                        {%- endif -%}
                        <i class="icm-sync-alt fa-spin refresh-icon d-none"></i>
                    </a>
                    {%- set exist = true -%}
                {%- endif -%}
            {%- endfor -%}
            {%- if not exist -%}
                <span class="btn-icon small muted cursor-not-allowed"
                      data-bs-toggle="tooltip" title="{{ languageName(configLocale, app.user.locale)|capitalize~" : "~"URL non générée"|trans|striptags }}">
                    <i class="label icm-ban"></i>
                </span>
            {%- endif -%}
        {%- endfor -%}
    </span>
{%- endif -%}