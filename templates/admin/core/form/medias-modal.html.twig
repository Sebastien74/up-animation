{%- trans_default_domain 'admin' -%}

{%- set uploadType = uploadType is defined ? uploadType : 'single' -%}
{%- set btnModalId = btnModalId is defined ? btnModalId : 'open-modal-'~modalId -%}
{%- set haveAddVideo = haveAddVideo is defined ? 'video-btn' : 'media-open-btn' -%}
{%- set btnClass = uploadType~' '~ haveAddVideo -%}

<div class="open-modal-medias-btn btn-app w-100 mb-3 p-0 {{ btnClass }}">
    <span id="{{ btnModalId }}"
          class="open-modal-medias w-100 d-inline-flex align-items-center justify-content-center gap-3 py-2 px-3 cursor"
          data-options="{{ parameters|json_encode }}">
        <i class="icm-photo-video"></i>{{ "Choisir dans la bibliothèque"|trans }}
    </span>
    <a href="https://tinypng.com/"
       target="_blank"
       class="optimize-media-btn me-3 py-2"
       data-bs-toggle="tooltip"
       title="{{"Optimisez vos médias avant de les télécharger"|trans|striptags }}">
        <i class="icm-file-archive"></i>
    </a>
</div>