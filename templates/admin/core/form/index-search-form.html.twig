{% trans_default_domain 'admin' %}

{{ form_start(form, {attr: {id: 'index-search-form', class: 'pages-search form-search d-inline-block mb-0', novalidate: 'novalidate', action: masterRequest().uri}}) }}
    <div class="input-group search-input-group">
        <div class="input-group-text left">
            <button type="submit" class="search-btn btn-icon" data-bs-toggle="tooltip" title="{{ "Rechercher"|trans|striptags }}">
                <i class="icm-search"></i>
            </button>
        </div>
        {{ form_widget(form.search) }}
        {% if searchText %}
            <div class="input-group-text right">
                <a href="{{ searchClearPath }}" class="search-reset btn-icon danger" aria-label="{{ "Éffacer"|trans|striptags }}">
                    <i class="icm-times"></i>
                </a>
            </div>
        {% endif %}
    </div>
{{ form_end(form) }}