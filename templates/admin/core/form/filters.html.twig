{%- trans_default_domain 'admin' -%}

{%- set isFiltered = app.request.query.has('filter') -%}
{%- set resetPath = path('admin_'~interface.name~'_index', args) -%}

<div class="filters-dropdown dropdown">
    <button type="button" class="btn-app d-inline-flex align-items-center gap-2 {{ isFiltered ? 'is-active' : '' }}"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        <i class="icm-filter"></i><span>{{ "Filtres"|trans|raw }}</span>
        {%- if isFiltered %}<span class="filters-active-dot" aria-hidden="true"></span>{% endif -%}
    </button>

    <div class="dropdown-menu filters-panel">
        {{ form_start(searchFiltersForm, { attr: {
            novalidate: "novalidate",
            id: "filters-form",
            class: "filters-form",
            action: resetPath
        }}) }}
            <div class="filters-panel-head">
                {%- if isFiltered -%}
                    <a href="{{ resetPath }}" class="filters-clear">
                        <i class="icm-times" aria-hidden="true"></i> {{ "Effacer"|trans|raw }}
                    </a>
                {%- else -%}
                    <span class="filters-clear is-disabled"><i class="icm-times" aria-hidden="true"></i> {{ "Effacer"|trans|raw }}</span>
                {%- endif -%}
                <span class="filters-panel-title"><i class="icm-filter" aria-hidden="true"></i> {{ "Filtres"|trans|raw }}</span>
                <button type="submit" class="filters-apply btn-app small d-inline-flex align-items-center gap-2">
                    <i class="icm-check" aria-hidden="true"></i> {{ "Appliquer"|trans|raw }}
                </button>
            </div>

            <div class="filters-panel-body">
                {%- if searchFiltersForm|length > 0 -%}
                    {%- for child in searchFiltersForm -%}
                        <div class="filters-row" data-filter-row>
                            <label class="filters-row-head">
                                <input type="checkbox" class="filters-row-toggle"{{ child.vars.value is not empty ? ' checked' : '' }}>
                                <span class="filters-row-label">{{ child.vars.label|default(child.vars.name) }}</span>
                            </label>
                            <div class="filters-row-control">
                                {{ form_widget(child) }}
                            </div>
                        </div>
                    {%- endfor -%}
                {%- else -%}
                    <p class="filters-empty">{{ "Aucun filtre disponible."|trans|raw }}</p>
                {%- endif -%}
            </div>
        {{ form_end(searchFiltersForm) }}
    </div>
</div>
