{%- trans_default_domain 'admin' -%}

{%- set args = {website: websiteId(), (interface['name']): entity.id} -%}
{%- if interface.masterField is defined and interface.masterField != 'configuration' and interface.masterField != 'website' -%}
    {%- set args = args|merge({(interface.masterField): interface.masterFieldId}) -%}
{%- endif -%}
{%- set args = ('admin_'~interface['name']~'_position')|routeArgs(interface.entity, args) -%}

{%- if not ajaxView -%}
    <span class="position" data-bs-toggle="tooltip" title="{{"Modifier la position"|trans|striptags }}">
        <a href="#" data-bs-toggle="modal" data-bs-target="#modal-position-{{ entity.id }}">
            {{ entity.position }}
        </a>
    </span>
{%- endif -%}

{{ form_start(form, {attr: {id: "modal-position-form-"~entity.id, class: 'mb-0',action: path("admin_"~interface.name~"_position", args)}}) }}
    <div class="modal fade modal-position{% if ajaxView %} d-block show{% endif %}" id="modal-position-{{ entity.id }}" tabindex="-1" role="dialog"
         aria-labelledby="modal-position-{{ entity.id }}-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-md" role="document">
            <div class="modal-content border">
                <div class="modal-header">
                    <span class="modal-icon text-center w-100"><span class="icon-wrap"><i class="icm-sort-numeric-down-alt"></i></span></span>
                    <button class="btn-close btn-icon btn-dismiss" data-bs-dismiss="modal" aria-label="{{"Fermer"|trans|raw }}"><i class="icm-times"></i></button>
                </div>
                <div class="modal-body">
                    <h2 class="main-title text-center fw-bold mb-4">{{ "Modifier la position"|trans|raw }}</h2>
                    <div class="row">
                        <div class="col-md-4 offset-md-4">
                            {{ form_widget(form.position) }}
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center pt-0">
                    <span class="btn-dismiss btn-app muted" data-bs-dismiss="modal"><i class="icm-ban"></i>{{ "Annuler"|trans|raw }}</span>
                    {{ form_widget(form.save) }}
                </div>
            </div>
        </div>
    </div>
{{ form_end(form) }}