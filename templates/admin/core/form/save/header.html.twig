{%- trans_default_domain 'admin' -%}

{%- if interface.configuration.saveArea is not defined
    or interface.configuration.saveArea != 'bottom'
    or configFields is defined and configFields -%}
    <div class="form-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        {%- if configFields is defined and configFields -%}
            <button class="btn-app collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    href="#collapseForm"
                    aria-expanded="false"
                    aria-controls="collapseForm">
                <i class="icm-cog-reg"></i>{{ "Configuration"|trans|raw }}
            </button>
        {%- endif -%}
        <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
            {%- if layoutHeaderActions is defined -%}{{ layoutHeaderActions }}{%- endif -%}
            <div class="save-base gap-2 d-flex align-self-center">
                {%- include 'admin/core/form/save/base.html.twig' with {saveAreaTpl: 'header'} -%}
            </div>
        </div>
    </div>
{%- endif -%}