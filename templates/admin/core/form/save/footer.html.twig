{%- trans_default_domain 'admin' -%}

{%- if interface.configuration.saveArea is not defined
    or interface.configuration.saveArea != 'top'
    or configsFieldsSet is defined and configsFieldsSet -%}
    <div class="save-bottom d-flex justify-content-end align-items-center gap-2 mb-3">
        {%- set submitFields = ['save', 'saveBack', 'saveEdit'] -%}
        {%- if interface.configuration.saveArea == 'bottom' -%}
            {%- include 'admin/core/form/save/base.html.twig' -%}
        {%- elseif interface.configuration.saveArea == 'both' -%}
            <a href="{{ lastRoute() }}" class="btn-icon"
               data-bs-toggle="tooltip"
               title="{{ "Retourner à la page précédente"|trans|striptags }}"
               aria-label="{{ "Retourner à la page précédente"|trans|striptags }}">
                <i class="icm-reply"></i>
            </a>
            {%- if form.save is defined or form.saveBack is defined or form.saveEdit is defined -%}
                {%- for field in form.children -%}
                    {%- if field.vars.name in submitFields -%}
                        <button type="submit"
                                name="{{ field.vars.full_name }}"
                                class="btn-icon d-inline-flex align-items-center gap-2{% if field.vars.attr.class is defined and field.vars.attr.class %} {{ field.vars.attr.class }}{% endif %}">
                            <i class="icm-save"></i><span>{{ field.vars.label }}</span>
                        </button>
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
        {%- endif -%}
    </div>
{%- endif -%}