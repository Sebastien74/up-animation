{%- trans_default_domain 'admin' -%}

{%- if breadcrumb is defined and breadcrumb is not empty -%}
    <nav class="breadcrumb-container d-inline-block w-100 mb-4" aria-label="{{ "Fil d'Ariane"|trans|striptags }}">
        <ol class="page-breadcrumb bg-transparent breadcrumb d-flex flex-wrap list-unstyled mb-0">
            {%- for item, path in breadcrumb -%}
                {%- if loop.last -%}
                    <li class="breadcrumb-item active ps-0" aria-current="page">{{ item }}</li>
                {%- else -%}
                    <li class="breadcrumb-item ps-0"><a href="{{ path }}">{{ item }}</a></li>
                {%- endif -%}
            {%- endfor -%}
        </ol>
    </nav>
{%- endif -%}