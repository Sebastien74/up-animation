{%- trans_default_domain 'admin' -%}

{%- set preloaderId = preloaderId is defined and preloaderId ? preloaderId : 'stripe-preloader' -%}
{%- set preloaderClass = preloaderClass is defined and preloaderClass ? preloaderClass : null -%}
{%- set visible = visible is defined and visible -%}
{%- set label = label is defined and label ? label : "Chargement en cours..."|trans -%}

<div id="{{ preloaderId }}"
     class="app-loader stripe-preloader{% if not visible %} d-none{% endif %}{% if preloaderClass %} {{ preloaderClass }}{% endif %}"
     role="status"
     aria-live="polite"
     aria-busy="true">
    <div class="app-loader-backdrop" aria-hidden="true"></div>
    <div class="app-loader-toast">
        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
        <span class="app-loader-label">{{ label|raw }}</span>
    </div>
</div>
