### APP CONFIG ###

APP_DEBUG=0

# Secret applicatif PROPRE à cet environnement (signature CSRF, remember-me, ETag…).
# Ne JAMAIS réutiliser la valeur d'un autre environnement (.env / .env.local / preprod).
# Générer : php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"
APP_SECRET=__GENERER_UN_SECRET_UNIQUE__

### SECURITY ###

# Segment secret de l'URL d'administration (/admin-<token>), propre à cet environnement.
# Générer : php -r "echo bin2hex(random_bytes(20)).PHP_EOL;"
SECURITY_TOKEN=__GENERER_UN_TOKEN_UNIQUE__

### DOCTRINE ###

DB_HOST=localhost
# Utilisateur MySQL DÉDIÉ à ce site — jamais « root ». Droits limités à DB_NAME.
# Voir docs/SECURITY-HARDENING.md (section 2).
DB_USER=__UTILISATEUR_DB_DEDIE__
DB_NAME=
# Mot de passe fort (>= 24 caractères). Générer : php -r "echo bin2hex(random_bytes(18)).PHP_EOL;"
DB_PASSWORD=__MOT_DE_PASSE_FORT__
DB_PORT=3306
DB_VERSION=5.7-MySQL

### MAILER ###

#MAILER_DSN=native://default
MAILER_DSN=sendmail://default

### TRUSTED PROXIES / HOSTS ###

# Required behind a reverse proxy (o2switch, Cloudflare, etc.).
# Without these, getClientIp() returns the proxy IP and Host header injection is possible.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HOSTS='^(www\.)?example\.com$'

### CRON ###

# Either set CRON_SECRET and call cron.php with ?secret=... / X-Cron-Secret header,
# or restrict access to known IPs (comma-separated).
CRON_SECRET=
CRON_ALLOWED_IPS=127.0.0.1,::1
